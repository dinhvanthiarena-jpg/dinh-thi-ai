<section class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-16">

  <div class="text-center">
    <span class="inline-block rounded-full bg-purple-100 text-purple-700 text-xs font-black tracking-widest uppercase px-3 py-1">Mon.L Pro</span>
    <h1 class="text-3xl sm:text-4xl font-extrabold text-ink mt-4">Nói chuyện với MON.L thoải mái</h1>
    <p class="text-muted mt-3 max-w-xl mx-auto">
      Mỗi lượt gọi là một lượt máy phải nghĩ và nói. Gói Pro mở khoá phần gọi không giới hạn,
      còn toàn bộ 60 bài học thì miễn phí mãi mãi.
    </p>
  </div>

  <% if (!dangThuPhi) { %>
    <div class="mt-8 rounded-xl border border-emerald-200 bg-emerald-50 px-5 py-4 text-emerald-900">
      <p class="font-bold">Đang mở miễn phí cho tất cả mọi người.</p>
      <p class="text-sm mt-1">
        Phần gọi Mon.L hiện chưa giới hạn gì cả — cứ dùng thoải mái. Trang này đang chờ sẵn,
        khi nào bắt đầu thu phí sẽ báo trước.
      </p>
    </div>
  <% } %>

  <% if (conHan) { %>
    <div class="mt-8 rounded-xl border border-purple-200 bg-purple-50 px-5 py-4 text-purple-900">
      <p class="font-bold">Bạn đang dùng gói Pro.</p>
      <p class="text-sm mt-1">
        Hạn tới <%= new Date(currentUser.proUntil).toLocaleDateString('vi-VN') %>.
        Mua thêm thì ngày mới nối vào cuối, không mất ngày nào.
      </p>
    </div>
  <% } %>

  <div class="grid sm:grid-cols-2 gap-5 mt-10">
    <% const goi = [
         { ma: 'month', ten: 'Theo tháng', gia: plans.month.amount, phu: 'Trả từng tháng, dừng lúc nào cũng được.', noiBat: false },
         { ma: 'year',  ten: 'Theo năm',   gia: plans.year.amount,  phu: 'Rẻ hơn 28% so với trả tháng.', noiBat: true }
       ]; %>
    <% goi.forEach(function (g) { %>
      <div class="card p-6 <%= g.noiBat ? 'ring-2 ring-purple-500' : '' %>">
        <% if (g.noiBat) { %>
          <span class="inline-block rounded-full bg-purple-600 text-white text-[11px] font-black uppercase tracking-wider px-2.5 py-1 mb-3">Đáng tiền nhất</span>
        <% } %>
        <h2 class="font-bold text-ink text-lg"><%= g.ten %></h2>
        <p class="mt-2">
          <span class="text-3xl font-extrabold text-ink"><%= g.gia.toLocaleString('vi-VN') %>đ</span>
          <span class="text-muted text-sm">/ <%= g.ma === 'year' ? 'năm' : 'tháng' %></span>
        </p>
        <p class="text-sm text-muted mt-2"><%= g.phu %></p>

        <% if (!sanSang) { %>
          <p class="mt-5 text-sm text-amber-700 bg-amber-50 rounded-lg px-3 py-2">
            Chưa cấu hình tài khoản nhận tiền.
          </p>
        <% } else if (!currentUser) { %>
          <a href="/auth/login?next=/pro" class="btn btn-primary w-full mt-5">Đăng nhập để mua</a>
        <% } else { %>
          <form method="POST" action="/pro/mua" class="mt-5">
            <input type="hidden" name="plan" value="<%= g.ma %>" />
            <button type="submit" class="btn <%= g.noiBat ? 'btn-primary' : 'btn-outline' %> w-full">
              Mua <%= g.ten.toLowerCase() %>
            </button>
          </form>
        <% } %>
      </div>
    <% }); %>
  </div>

  <div class="card p-6 mt-8">
    <h3 class="font-bold text-ink">Trả tiền thế nào?</h3>
    <ol class="mt-3 space-y-2 text-sm text-muted list-decimal list-inside">
      <li>Chọn gói, màn hình hiện một mã QR.</li>
      <li>Mở app ngân hàng bất kỳ, quét mã. Số tiền và nội dung đã điền sẵn, không phải gõ gì.</li>
      <li>Bấm chuyển. Vài giây sau trang tự báo xong và mở gói ngay.</li>
    </ol>
    <p class="text-sm text-muted mt-4">
      Không cần nhập số thẻ ở bất cứ đâu. Tiền chuyển thẳng vào tài khoản ngân hàng của
      thầy Đinh Thi, hệ thống chỉ đọc thông báo tiền vào để mở gói.
    </p>
  </div>

</section>
