<style>
  @keyframes ktaFloat {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }
  @keyframes ktaGlow {
    0%, 100% { box-shadow: 0 0 0 0 rgba(249, 115, 22, 0.55); }
    50% { box-shadow: 0 0 0 14px rgba(249, 115, 22, 0); }
  }
  .kta-float { animation: ktaFloat 3.2s ease-in-out infinite; }
  .kta-glow { animation: ktaGlow 2s ease-out infinite; }
  @keyframes ktaShine {
    0% { background-position: 160% 0; }
    100% { background-position: -60% 0; }
  }
  .kta-shine-text {
    background-image: linear-gradient(100deg, rgba(255,255,255,0) 40%, rgba(255,255,255,0.95) 50%, rgba(255,255,255,0) 60%);
    background-size: 250% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    animation: ktaShine 2.2s ease-in-out infinite;
  }
</style>

