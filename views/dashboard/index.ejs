<section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12">
  <h1 class="text-3xl font-extrabold text-ink">Khu vực học tập</h1>
  <p class="text-muted mt-1">Xin chào, <%= currentUser.name %>! Tiếp tục hành trình học AI của bạn.</p>

  <div class="mt-10">
    <h2 class="text-xl font-bold text-ink mb-5">Khóa học của tôi</h2>

    <% if (enrollments.length) { %>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <% enrollments.forEach(function(en) { %>
          <div class="card overflow-hidden flex flex-col">
            <div class="aspect-video bg-primary-50 overflow-hidden">
              <img src="<%= en.course.thumbnailUrl %>" alt="<%= en.course.title %>" class="w-full h-full object-cover" />
            </div>
            <div class="p-5 flex flex-col flex-1">
              <h3 class="font-semibold text-ink line-clamp-2"><%= en.course.title %></h3>
              <div class="mt-3">
                <div class="flex justify-between text-xs text-muted mb-1">
                  <span>Tiến độ</span>
                  <span><%= en.progressPercent %>%</span>
                </div>
                <div class="h-2 rounded-full bg-primary-50 overflow-hidden">
                  <div class="h-full bg-primary-600" style="width: <%= en.progressPercent %>%"></div>
                </div>
              </div>
              <a href="/dashboard/learn/<%= en.course.slug %>" class="btn-primary w-full mt-4">
                <%= en.progressPercent >= 100 ? 'Xem lại khóa học' : 'Tiếp tục học' %>
              </a>
            </div>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="card p-10 text-center">
        <p class="text-muted">Bạn chưa đăng ký khóa học nào.</p>
        <a href="/courses" class="btn-primary mt-4 inline-flex">Khám phá khóa học</a>
      </div>
    <% } %>
  </div>

  <% if (orders.length) { %>
    <div class="mt-12">
      <h2 class="text-xl font-bold text-ink mb-5">Lịch sử thanh toán</h2>
      <div class="card overflow-hidden">
        <table class="w-full text-sm">
          <thead class="bg-primary-50 text-ink">
            <tr>
              <th class="text-left px-5 py-3 font-semibold">Khóa học</th>
              <th class="text-left px-5 py-3 font-semibold">Ngày</th>
              <th class="text-right px-5 py-3 font-semibold">Số tiền</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-primary-50">
            <% orders.forEach(function(o) { %>
              <tr>
                <td class="px-5 py-3 text-ink"><%= o.course.title %></td>
                <td class="px-5 py-3 text-muted"><%= new Date(o.createdAt).toLocaleDateString('vi-VN') %></td>
                <td class="px-5 py-3 text-right font-medium text-ink"><%= o.amount.toLocaleString('vi-VN') %>đ</td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  <% } %>
</section>
