<section class="bg-ink text-white">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12 grid lg:grid-cols-3 gap-10">
    <div class="lg:col-span-2">
      <span class="badge bg-white/10 text-primary-200 mb-3"><%= course.category %> &middot; <%= course.level %></span>
      <h1 class="text-3xl sm:text-4xl font-extrabold"><%= course.title %></h1>
      <p class="mt-3 text-indigo-200 text-lg"><%= course.subtitle %></p>
      <div class="mt-4 flex items-center gap-4 text-sm text-indigo-200">
        <div class="flex items-center gap-1 text-amber-400">
          <svg class="h-4 w-4 fill-current" viewBox="0 0 20 20"><path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z"/></svg>
          <span class="font-semibold text-white"><%= course.ratingAverage.toFixed(1) %></span>
          <span>(<%= course.ratingCount %> đánh giá)</span>
        </div>
        <span>&middot;</span>
        <span><%= course.enrollmentCount %> học viên</span>
        <span>&middot;</span>
        <span>Giảng viên: <%= course.instructorName %></span>
      </div>
    </div>
  </div>
</section>

<section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12 grid lg:grid-cols-3 gap-10">
  <div class="lg:col-span-2 space-y-10">
    <div class="card p-6">
      <h2 class="text-xl font-bold text-ink mb-4">Mô tả khóa học</h2>
      <p class="text-muted leading-relaxed whitespace-pre-line"><%= course.description %></p>
    </div>

    <% if (course.outcomes && course.outcomes.length) { %>
      <div class="card p-6">
        <h2 class="text-xl font-bold text-ink mb-4">Bạn sẽ học được gì</h2>
        <ul class="grid sm:grid-cols-2 gap-3">
          <% course.outcomes.forEach(function(item) { %>
            <li class="flex items-start gap-2 text-sm text-ink">
              <svg class="h-5 w-5 flex-shrink-0 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              <span><%= item %></span>
            </li>
          <% }); %>
        </ul>
      </div>
    <% } %>

    <% if (lessons.length) { %>
      <div class="card p-6">
        <h2 class="text-xl font-bold text-ink mb-4">Nội dung khóa học (<%= lessons.length %> bài học)</h2>
        <ul class="divide-y divide-primary-100">
          <% lessons.forEach(function(lesson, i) { %>
            <li class="flex items-center justify-between py-3 text-sm">
              <div class="flex items-center gap-3">
                <span class="flex h-7 w-7 items-center justify-center rounded-full bg-primary-50 text-primary-700 text-xs font-semibold"><%= i + 1 %></span>
                <span class="text-ink"><%= lesson.title %></span>
                <% if (lesson.isPreview) { %><span class="badge bg-accent-50 text-accent-700 text-[11px]">Xem trước</span><% } %>
              </div>
              <span class="text-muted"><%= lesson.durationMinutes %> phút</span>
            </li>
          <% }); %>
        </ul>
      </div>
    <% } %>

    <% if (course.requirements && course.requirements.length) { %>
      <div class="card p-6">
        <h2 class="text-xl font-bold text-ink mb-4">Yêu cầu</h2>
        <ul class="list-disc list-inside space-y-1 text-sm text-muted">
          <% course.requirements.forEach(function(item) { %><li><%= item %></li><% }); %>
        </ul>
      </div>
    <% } %>

    <% if (reviews.length) { %>
      <div class="card p-6">
        <h2 class="text-xl font-bold text-ink mb-4">Đánh giá học viên</h2>
        <div class="space-y-5">
          <% reviews.forEach(function(review) { %>
            <div class="border-b border-primary-50 pb-4 last:border-0">
              <div class="flex items-center gap-1 text-amber-500 mb-1">
                <% for (let i = 0; i < 5; i++) { %>
                  <svg class="h-3.5 w-3.5 <%= i < review.rating ? 'fill-current' : 'fill-slate-200' %>" viewBox="0 0 20 20"><path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z"/></svg>
                <% } %>
              </div>
              <p class="text-sm text-ink"><%= review.comment %></p>
              <p class="text-xs text-muted mt-1"><%= review.user ? review.user.name : 'Học viên' %></p>
            </div>
          <% }); %>
        </div>
      </div>
    <% } %>
  </div>

  <aside class="lg:col-span-1">
    <div class="card p-6 sticky top-24">
      <img src="<%= course.thumbnailUrl %>" alt="<%= course.title %>" class="w-full rounded-xl aspect-video object-cover mb-5" />
      <div class="flex items-center gap-2 mb-5">
        <% if (course.salePrice != null) { %>
          <span class="text-3xl font-extrabold text-primary-700"><%= course.salePrice.toLocaleString('vi-VN') %>đ</span>
          <span class="text-lg text-slate-400 line-through"><%= course.price.toLocaleString('vi-VN') %>đ</span>
        <% } else if (course.price === 0) { %>
          <span class="text-3xl font-extrabold text-success">Miễn phí</span>
        <% } else { %>
          <span class="text-3xl font-extrabold text-primary-700"><%= course.price.toLocaleString('vi-VN') %>đ</span>
        <% } %>
      </div>

      <% if (isEnrolled) { %>
        <a href="/dashboard/learn/<%= course.slug %>" class="btn-primary w-full">Vào học ngay</a>
      <% } else if (typeof currentUser !== 'undefined' && currentUser) { %>
        <form action="/courses/<%= course.slug %>/checkout" method="GET">
          <button type="submit" class="btn-primary w-full">Đăng ký khóa học</button>
        </form>
      <% } else { %>
        <a href="/auth/login?next=<%= encodeURIComponent('/courses/' + course.slug + '/checkout') %>" class="btn-primary w-full">Đăng nhập để đăng ký</a>
      <% } %>

      <ul class="mt-5 space-y-2 text-sm text-muted">
        <li class="flex justify-between"><span>Thời lượng</span><span class="text-ink font-medium"><%= course.durationHours %> giờ</span></li>
        <li class="flex justify-between"><span>Cấp độ</span><span class="text-ink font-medium"><%= course.level %></span></li>
        <li class="flex justify-between"><span>Bài học</span><span class="text-ink font-medium"><%= lessons.length %></span></li>
        <li class="flex justify-between"><span>Chứng chỉ</span><span class="text-ink font-medium">Có</span></li>
      </ul>
    </div>
  </aside>
</section>

<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
  <%- include('../partials/shopee-picks') %>
</div>

<% if (relatedCourses.length) { %>
<section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pb-16">
  <h2 class="text-xl font-bold text-ink mb-6">Khóa học liên quan</h2>
  <div class="grid sm:grid-cols-3 gap-6">
    <% relatedCourses.forEach(function(c) { %>
      <%- include('../partials/course-card', { course: c }) %>
    <% }); %>
  </div>
</section>
<% } %>
