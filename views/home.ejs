<!-- Cột tin theo chuyên mục (kiểu trang chủ báo điện tử) — 3 chuyên mục đầu
     xếp dạng cột hẹp trên cùng 1 hàng; từ chuyên mục thứ 4 trở đi mỗi chuyên
     mục chiếm trọn 1 hàng riêng (dạng lưới ảnh ngang) thay vì bị bó hẹp
     trong ô 1/3 còn trống bên cạnh. -->
<% if (categoryColumns.length) { %>
<% const topColumns = categoryColumns.slice(0, 3); %>
<% const restColumns = categoryColumns.slice(3); %>
<section class="bg-white border-b border-primary-100">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10 space-y-12">
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-10">
      <% topColumns.forEach(function(col) { %>
        <div>
          <div class="flex items-center justify-between border-b-2 border-primary-600 pb-2 mb-4">
            <h2 class="text-sm font-bold uppercase tracking-wide text-primary-700"><%= col.category.emoji %> <%= col.category.label %></h2>
            <a href="/blog?category=<%= col.category.slug %>" class="text-xs font-semibold text-muted hover:text-primary-700 whitespace-nowrap">Xem thêm &rarr;</a>
          </div>
          <div class="space-y-4">
            <% col.posts.forEach(function(post, idx) { %>
              <a href="/blog/<%= post.slug %>" class="flex gap-3 group">
                <div class="w-16 h-16 flex-shrink-0 rounded-lg overflow-hidden bg-primary-50">
                  <img src="<%= post.coverImageUrl %>" alt="<%= post.title %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" onerror="this.onerror=null;this.src='/images/blog/cat-<%= post.category %>.svg'" />
                </div>
                <div class="min-w-0">
                  <h3 class="text-sm font-semibold text-ink leading-snug line-clamp-2 group-hover:text-primary-700"><%= post.title %></h3>
                  <p class="text-xs text-muted mt-1"><%= new Date(post.publishedAt).toLocaleDateString('vi-VN') %></p>
                </div>
              </a>
            <% }); %>
          </div>
        </div>
      <% }); %>
    </div>

    <% restColumns.forEach(function(col) { %>
      <div>
        <div class="flex items-center justify-between border-b-2 border-primary-600 pb-2 mb-4">
          <h2 class="text-sm font-bold uppercase tracking-wide text-primary-700"><%= col.category.emoji %> <%= col.category.label %></h2>
          <a href="/blog?category=<%= col.category.slug %>" class="text-xs font-semibold text-muted hover:text-primary-700 whitespace-nowrap">Xem thêm &rarr;</a>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
          <% col.posts.forEach(function(post) { %>
            <a href="/blog/<%= post.slug %>" class="group">
              <div class="aspect-video rounded-lg overflow-hidden bg-primary-50">
                <img src="<%= post.coverImageUrl %>" alt="<%= post.title %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" onerror="this.onerror=null;this.src='/images/blog/cat-<%= post.category %>.svg'" />
              </div>
              <h3 class="mt-2 text-sm font-semibold text-ink leading-snug line-clamp-2 group-hover:text-primary-700"><%= post.title %></h3>
              <p class="text-xs text-muted mt-1"><%= new Date(post.publishedAt).toLocaleDateString('vi-VN') %></p>
            </a>
          <% }); %>
        </div>
      </div>
    <% }); %>
  </div>
</section>
<% } %>

<!-- Featured tools & games -->
<% if (featuredTools.length) { %>
<section class="bg-gradient-to-br from-primary-50 to-accent-50 border-y border-primary-100">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10">
    <div class="mb-5">
      <span class="badge bg-primary-600 text-white text-[11px] mb-2">Miễn phí 100%</span>
      <h2 class="text-lg sm:text-xl font-bold text-ink">Tool &amp; Game do Vietpro xây dựng</h2>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
      <% featuredTools.forEach(function(t) { %>
        <a href="/kho-tai-nguyen/<%= t.slug %>" class="group block">
          <div class="relative aspect-square rounded-xl bg-gradient-to-br from-primary-100 to-accent-100 overflow-hidden shadow-sm">
            <img src="<%= t.coverImageUrl %>" alt="<%= t.title %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
            <span class="absolute top-2 left-2 badge shadow-sm text-[10px] px-2 py-0.5 <%= t.category === 'Game' ? 'bg-accent-500 text-white' : t.category === 'Công cụ' ? 'bg-amber-500 text-white' : 'bg-primary-600 text-white' %>"><%= t.category %></span>
          </div>
          <h3 class="mt-2 text-sm font-semibold text-ink leading-snug line-clamp-1 group-hover:text-primary-700"><%= t.title %></h3>
          <p class="text-xs text-muted"><%= t.downloadCount %> lượt tải</p>
        </a>
      <% }); %>
    </div>
  </div>
</section>
<% } %>

<!-- Featured courses -->
<% if (featuredCourses.length) { %>
<section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16">
  <div class="flex items-end justify-between mb-8">
    <div>
      <h2 class="text-2xl sm:text-3xl font-bold text-ink">Khóa học nổi bật</h2>
      <p class="text-muted mt-1">Được lựa chọn nhiều nhất bởi học viên</p>
    </div>
    <a href="/courses" class="text-primary-700 font-semibold hover:underline hidden sm:block">Xem tất cả &rarr;</a>
  </div>
  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
    <% featuredCourses.forEach(function(course) { %>
      <%- include('partials/course-card', { course }) %>
    <% }); %>
  </div>
</section>
<% } %>

<!-- Testimonials -->
<% if (topReviews.length) { %>
<section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16">
  <h2 class="text-2xl sm:text-3xl font-bold text-ink text-center mb-10">Học viên nói gì</h2>
  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
    <% topReviews.forEach(function(review) { %>
      <div class="card p-6">
        <div class="flex items-center gap-1 text-amber-500 mb-3">
          <% for (let i = 0; i < 5; i++) { %>
            <svg class="h-4 w-4 <%= i < review.rating ? 'fill-current' : 'fill-slate-200' %>" viewBox="0 0 20 20"><path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z"/></svg>
          <% } %>
        </div>
        <p class="text-sm text-ink italic">"<%= review.comment %>"</p>
        <p class="text-xs text-muted mt-4 font-medium"><%= review.user ? review.user.name : 'Học viên' %> &middot; <%= review.course ? review.course.title : '' %></p>
      </div>
    <% }); %>
  </div>
</section>
<% } %>

<!-- Blog preview -->
<% if (latestPosts.length) { %>
<section class="bg-white border-t border-primary-100">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16">
    <div class="flex items-end justify-between mb-8">
      <div>
        <p class="text-xs font-bold uppercase tracking-wide text-primary-600 mb-2">Kiến thức &amp; Tin tức</p>
        <h2 class="text-2xl sm:text-3xl font-bold text-ink">Bài viết &amp; tin tức mới nhất</h2>
      </div>
      <a href="/blog" class="text-primary-700 font-semibold hover:underline whitespace-nowrap">Xem tất cả &rarr;</a>
    </div>
    <div class="grid sm:grid-cols-3 gap-6">
      <% latestPosts.forEach(function(post) { %>
        <% const postCat = (typeof blogCategories !== 'undefined' ? blogCategories : []).find(function(c) { return c.slug === post.category; }); %>
        <a href="/blog/<%= post.slug %>" class="card overflow-hidden group flex flex-col">
          <div class="aspect-video bg-primary-50 overflow-hidden relative">
            <img src="<%= post.coverImageUrl %>" alt="<%= post.title %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" onerror="this.onerror=null;this.src='/images/blog/cat-<%= post.category %>.svg'" />
            <% if (postCat) { %>
              <span class="absolute top-2 left-2 px-2 py-1 rounded-full text-[10px] font-bold uppercase tracking-wide bg-white/90 text-ink shadow"><%= postCat.emoji %> <%= postCat.label %></span>
            <% } %>
          </div>
          <div class="p-5 flex flex-col flex-1">
            <h3 class="font-semibold text-ink line-clamp-2 group-hover:text-primary-700"><%= post.title %></h3>
            <p class="text-sm text-muted mt-2 line-clamp-2 flex-1"><%= post.excerpt %></p>
          </div>
        </a>
      <% }); %>
    </div>
  </div>
</section>
<% } %>

<!-- FAQ (ẩn theo yêu cầu — đổi showFaq thành true để hiện lại) -->
<% const showFaq = false; %>
<% if (showFaq && typeof faqs !== 'undefined' && faqs.length) { %>
<section class="bg-white border-t border-primary-100">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-16">
    <h2 class="text-2xl sm:text-3xl font-bold text-ink text-center mb-10">Câu hỏi thường gặp</h2>
    <div class="space-y-4">
      <% faqs.forEach(function(faq) { %>
        <details class="card p-6 group">
          <summary class="font-semibold text-ink cursor-pointer list-none flex items-center justify-between gap-4">
            <%= faq.q %>
            <svg class="h-5 w-5 flex-shrink-0 text-primary-600 transition-transform group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
          </summary>
          <p class="text-sm text-muted mt-3 leading-relaxed"><%= faq.a %></p>
        </details>
      <% }); %>
    </div>
  </div>
</section>
<% } %>

<section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pb-4">
  <%- include('partials/shopee-picks') %>
</section>

<!-- Why us (ẩn theo yêu cầu — đổi showWhyUs thành true để hiện lại) -->
<% const showWhyUs = false; %>
<% if (showWhyUs) { %>
<section class="bg-white border-y border-primary-100">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16">
    <h2 class="text-2xl sm:text-3xl font-bold text-ink text-center">Vì sao chọn Đinh Thi Ai</h2>
    <p class="text-muted text-center max-w-2xl mx-auto mt-3 mb-12">
      Đơn vị đào tạo AI, đào tạo ứng dụng AI uy tín tại Việt Nam — từ đào tạo AI cho doanh nghiệp, giảng viên, giáo viên, công chức, lãnh đạo, đến đào tạo kỹ năng ứng dụng AI cho cá nhân đi làm.
    </p>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8">
      <div class="text-center">
        <div class="mx-auto h-12 w-12 rounded-xl bg-primary-100 flex items-center justify-center text-primary-700 mb-4">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" /></svg>
        </div>
        <h3 class="font-semibold text-ink mb-2">Chương trình thực chiến</h3>
        <p class="text-sm text-muted">Học qua case study thực tế, ứng dụng ngay vào công việc.</p>
      </div>
      <div class="text-center">
        <div class="mx-auto h-12 w-12 rounded-xl bg-primary-100 flex items-center justify-center text-primary-700 mb-4">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17.982 18.725A7.488 7.488 0 0012 15.75a7.488 7.488 0 00-5.982 2.975m11.963 0a9 9 0 10-11.963 0m11.963 0A8.966 8.966 0 0112 21a8.966 8.966 0 01-5.982-2.275M15 9.75a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
        </div>
        <h3 class="font-semibold text-ink mb-2">Chuyên gia đồng hành</h3>
        <p class="text-sm text-muted">Trực tiếp giảng dạy bởi chuyên gia đào tạo AI, đào tạo ứng dụng AI doanh nghiệp nhiều năm kinh nghiệm.</p>
      </div>
      <div class="text-center">
        <div class="mx-auto h-12 w-12 rounded-xl bg-primary-100 flex items-center justify-center text-primary-700 mb-4">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.75c0 5.592 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.75h-.152c-3.196 0-6.1-1.248-8.25-3.286z" /></svg>
        </div>
        <h3 class="font-semibold text-ink mb-2">Chứng chỉ hoàn thành</h3>
        <p class="text-sm text-muted">Nhận chứng chỉ sau khi hoàn thành khóa học, minh chứng năng lực.</p>
      </div>
      <div class="text-center">
        <div class="mx-auto h-12 w-12 rounded-xl bg-primary-100 flex items-center justify-center text-primary-700 mb-4">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 21v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21m0 0h4.5V3.545M12.75 21h7.5V10.75M2.25 21h1.5m18 0h-18M2.25 9l4.5-1.636M18.75 3l-1.5.545m0 6.205l3 1m1.5.5l-1.5-.5M6.75 7.364V3h-3v18m3-13.636l10.5-3.819" /></svg>
        </div>
        <h3 class="font-semibold text-ink mb-2">Lộ trình rõ ràng</h3>
        <p class="text-sm text-muted">Từ cơ bản đến nâng cao, phù hợp với mọi mục tiêu nghề nghiệp.</p>
      </div>
    </div>
  </div>
</section>
<% } %>

<!-- CTA -->
<section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16">
  <div class="rounded-3xl bg-gradient-to-r from-primary-600 to-accent-600 px-8 py-14 text-center text-white">
    <h2 class="text-2xl sm:text-3xl font-bold">Sẵn sàng bắt đầu hành trình AI của bạn?</h2>
    <p class="mt-3 text-primary-100 max-w-xl mx-auto">Đăng ký ngay hôm nay để nhận ưu đãi học phí cho khóa học đầu tiên.</p>
    <a href="/auth/register" class="btn bg-white text-primary-700 hover:bg-primary-50 mt-6 px-8 py-3 text-base">Đăng ký miễn phí</a>
  </div>
</section>

<!-- Recent activity photos (đưa xuống cuối trang theo yêu cầu) -->
<% if (latestPhotos.length) { %>
<section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16">
  <div class="flex items-end justify-between mb-8">
    <div>
      <h2 class="text-2xl sm:text-3xl font-bold text-ink">Hoạt động gần đây</h2>
      <p class="text-muted mt-1">Hình ảnh các buổi giảng dạy và sự kiện thực tế</p>
    </div>
    <a href="/hoat-dong" class="text-primary-700 font-semibold hover:underline hidden sm:block">Xem tất cả &rarr;</a>
  </div>
  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
    <% latestPhotos.slice(0, 6).forEach(function(photo) { %>
      <a href="/hoat-dong" class="card overflow-hidden group">
        <div class="aspect-video bg-primary-50 overflow-hidden">
          <img src="<%= photo.imageUrl %>" alt="<%= photo.title %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
        </div>
        <div class="p-4">
          <h3 class="font-semibold text-sm text-ink line-clamp-1"><%= photo.title %></h3>
        </div>
      </a>
    <% }); %>
  </div>
</section>
<% } %>
