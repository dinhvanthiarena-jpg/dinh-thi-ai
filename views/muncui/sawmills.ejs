<% const isManager = currentUser && (currentUser.role === 'admin' || currentUser.sawdustRole === 'owner' || currentUser.sawdustRole === 'manager'); %>
<% const e = editing || {}; %>

<% if (isManager) { %>
<div class="card p-6 mb-6">
  <h2 class="font-semibold text-ink mb-4"><%= editing ? 'Sửa xưởng xẻ' : 'Thêm xưởng xẻ mới' %></h2>
  <form method="POST" action="<%= editing ? '/mun-cui/xuong-xe/' + editing._id : '/mun-cui/xuong-xe' %>" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <label class="label">Tên xưởng xẻ *</label>
      <input class="input" type="text" name="name" value="<%= e.name || '' %>" required />
    </div>
    <div>
      <label class="label">Số điện thoại</label>
      <input class="input" type="text" name="phone" value="<%= e.phone || '' %>" />
    </div>
    <div>
      <label class="label">Người liên hệ</label>
      <input class="input" type="text" name="contactPerson" value="<%= e.contactPerson || '' %>" />
    </div>
    <div>
      <label class="label">Địa chỉ</label>
      <input class="input" type="text" name="address" value="<%= e.address || '' %>" />
    </div>
    <div class="sm:col-span-2">
      <label class="label">Ghi chú</label>
      <textarea class="input" name="note" rows="2"><%= e.note || '' %></textarea>
    </div>
    <% if (editing) { %>
      <label class="flex items-center gap-2 text-sm text-ink">
        <input type="checkbox" name="isActive" <%= e.isActive ? 'checked' : '' %> /> Đang hoạt động
      </label>
    <% } %>
    <div class="sm:col-span-2 flex gap-3">
      <button type="submit" class="btn-primary"><%= editing ? 'Lưu thay đổi' : 'Thêm xưởng xẻ' %></button>
      <% if (editing) { %><a href="/mun-cui/xuong-xe" class="btn-ghost">Hủy</a><% } %>
    </div>
  </form>
</div>
<% } %>

<div class="card overflow-hidden">
  <table class="w-full text-sm">
    <thead class="bg-primary-50 text-ink">
      <tr>
        <th class="text-left px-5 py-3 font-semibold">Tên</th>
        <th class="text-left px-5 py-3 font-semibold">Liên hệ</th>
        <th class="text-left px-5 py-3 font-semibold">Địa chỉ</th>
        <th class="text-center px-5 py-3 font-semibold">Trạng thái</th>
        <% if (isManager) { %><th class="text-right px-5 py-3 font-semibold">Hành động</th><% } %>
      </tr>
    </thead>
    <tbody class="divide-y divide-primary-50">
      <% sawmills.forEach(function(s) { %>
        <tr>
          <td class="px-5 py-3 text-ink font-medium"><%= s.name %></td>
          <td class="px-5 py-3 text-muted"><%= s.contactPerson %> <%= s.phone ? '· ' + s.phone : '' %></td>
          <td class="px-5 py-3 text-muted"><%= s.address %></td>
          <td class="px-5 py-3 text-center">
            <span class="badge <%= s.isActive ? 'bg-green-50 text-green-700' : 'bg-slate-100 text-slate-600' %>"><%= s.isActive ? 'Hoạt động' : 'Ngừng' %></span>
          </td>
          <% if (isManager) { %>
          <td class="px-5 py-3 text-right space-x-2 whitespace-nowrap">
            <a href="/mun-cui/xuong-xe?edit=<%= s._id %>" class="text-primary-700 hover:underline">Sửa</a>
            <form action="/mun-cui/xuong-xe/<%= s._id %>/delete" method="POST" class="inline" onsubmit="return confirm('Xóa xưởng xẻ này?');">
              <button type="submit" class="text-danger hover:underline cursor-pointer">Xóa</button>
            </form>
          </td>
          <% } %>
        </tr>
      <% }); %>
      <% if (!sawmills.length) { %>
        <tr><td colspan="5" class="px-5 py-8 text-center text-muted">Chưa có xưởng xẻ nào.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>
