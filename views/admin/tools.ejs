<div class="flex justify-between items-center mb-6">
  <p class="text-muted text-sm">Tổng số: <%= tools.length %> tool / game</p>
  <a href="/admin/tools/new" class="btn-primary">+ Thêm tool / game</a>
</div>

<% if (tools.length) { %>
  <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
    <% tools.forEach(function(t) { %>
      <div class="card overflow-hidden">
        <div class="aspect-square bg-primary-50 overflow-hidden">
          <img src="<%= t.coverImageUrl %>" alt="<%= t.title %>" class="w-full h-full object-cover" />
        </div>
        <div class="p-4">
          <span class="badge bg-primary-50 text-primary-700"><%= t.category %></span>
          <p class="font-medium text-ink text-sm line-clamp-1 mt-2"><%= t.title %></p>
          <p class="text-xs text-muted mt-1"><%= t.downloadCount %> lượt tải</p>
          <span class="badge mt-2 <%= t.isPublished ? 'bg-green-50 text-green-700' : 'bg-slate-100 text-slate-600' %>"><%= t.isPublished ? 'Hiển thị' : 'Ẩn' %></span>
          <div class="mt-3 flex justify-between text-sm">
            <a href="/admin/tools/<%= t._id %>/edit" class="text-primary-700 hover:underline">Sửa</a>
            <form action="/admin/tools/<%= t._id %>/delete" method="POST" onsubmit="return confirm('Xóa tool/game này?');">
              <button type="submit" class="text-danger hover:underline cursor-pointer">Xóa</button>
            </form>
          </div>
        </div>
      </div>
    <% }); %>
  </div>
<% } else { %>
  <div class="card p-12 text-center text-muted">Chưa có tool / game nào. Bấm "+ Thêm tool / game" để bắt đầu.</div>
<% } %>
