  function loadQueue() {
    // Tải lại nguyên trang là cách đơn giản/chắc chắn nhất để hiện đúng danh
    // sách hàng chờ mới nhất (kèm cả select Fanpage/Website đã render sẵn từ server).
    location.reload();
  }
  document.querySelectorAll('[data-queue-delete]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      await fetch(`/admin/aai-ads/queue/${btn.dataset.queueDelete}/delete`, { method: 'POST' });
      const row = document.querySelector(`[data-queue-row="${btn.dataset.queueDelete}"]`);
      if (row) row.remove();
    });
  });
  document.querySelectorAll('[data-queue-publish]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      btn.disabled = true;
      btn.textContent = 'Đang đăng...';
      await fetch(`/admin/aai-ads/queue/${btn.dataset.queuePublish}/publish-now`, { method: 'POST' });
      loadPostingLog();
      location.reload();
    });
  });

  async function loadPostingLog() {
    const res = await fetch('/admin/aai-ads/posting-log');
    const log = await res.json();
    const el = document.getElementById('postingLogList');
    if (!el) return;
    el.innerHTML = log.length
      ? log
          .slice(0, 30)
          .map((e) => `<div>${new Date(e.time).toLocaleString('vi-VN')} — ${e.targetName || e.targetId} → ${e.status === 'posted' ? 'Đã đăng' : ('Lỗi: ' + (e.error || ''))}</div>`)
          .join('')
      : '<p class="text-muted">Chưa có nhật ký nào.</p>';
  }
  const loadPostingLogBtn = document.getElementById('loadPostingLogBtn');
  if (loadPostingLogBtn) loadPostingLogBtn.addEventListener('click', loadPostingLog);

  // ---------------- AI Decision Center + Learning Loop ----------------

  const actionLabel = { scale_up: 'Tăng ngân sách', hold: 'Giữ nguyên', reduce: 'Giảm ngân sách', pause: 'Tạm dừng' };
  let pendingRecommendations = [];

  const runDecisionCenterBtn = document.getElementById('runDecisionCenterBtn');
  if (runDecisionCenterBtn) {
    runDecisionCenterBtn.addEventListener('click', async () => {
      const msg = document.getElementById('dcMsg');
      const adAccountId = document.getElementById('dcAdAccount').value;
      const windowDays = document.getElementById('dcWindow').value;
      msg.textContent = 'AI đang phân tích toàn bộ chiến dịch...';
      document.getElementById('dcFindings').style.display = 'none';
      document.getElementById('dcRecommendations').innerHTML = '';
      document.getElementById('approveAllBtn').style.display = 'none';
      try {
        const res = await fetch(`/admin/aai-ads/decision-center?adAccountId=${encodeURIComponent(adAccountId)}&windowDays=${windowDays}`);
        const data = await res.json();
        if (data.error) throw new Error(data.error);
        pendingRecommendations = data.recommendations || [];
        const findingsEl = document.getElementById('dcFindings');
        if (data.findings && data.findings.length) {
          findingsEl.style.display = '';
          findingsEl.innerHTML = '<p class="font-semibold text-ink mb-2">Nhận định</p>' + data.findings.map((f) => `<p class="text-sm mb-1">• ${f}</p>`).join('');
        }
        const recEl = document.getElementById('dcRecommendations');
        recEl.innerHTML = pendingRecommendations.length
          ? pendingRecommendations
              .map(
                (r, idx) => `
          <div class="card mb-2 flex items-center justify-between" data-rec-row="${idx}">
            <div><strong>${r.campaignName}</strong> — <span class="badge">${actionLabel[r.action] || r.action}</span><p class="text-sm text-muted">${r.reason || ''}</p></div>
            <button type="button" class="btn-outline" data-rec-approve="${idx}">Duyệt riêng</button>
          </div>`
              )
              .join('')
          : '<p class="text-muted text-sm">Không có đề xuất nào — mọi chiến dịch đang ổn.</p>';
        recEl.querySelectorAll('[data-rec-approve]').forEach((btn) => {
          btn.addEventListener('click', () => applyRecommendation(parseInt(btn.dataset.recApprove, 10), adAccountId));
        });
        document.getElementById('approveAllBtn').style.display = pendingRecommendations.length ? '' : 'none';
        msg.textContent = `Đã phân tích ${data.campaigns ? data.campaigns.length : 0} chiến dịch.`;
      } catch (e) {
        msg.textContent = `Lỗi: ${e.message}`;
      }
    });
  }

  async function applyRecommendation(idx, adAccountId) {
    const rec = pendingRecommendations[idx];
    if (!rec) return;
    const row = document.querySelector(`[data-rec-row="${idx}"]`);
    try {
      const res = await fetch('/admin/aai-ads/decision-center/apply', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ adAccountId, campaignName: rec.campaignName, action: rec.action }),
      });
      const result = await res.json();
      if (result.error) throw new Error(result.error);
      if (row) row.innerHTML = `<span class="text-emerald-600 text-sm">✓ Đã áp dụng "${actionLabel[rec.action] || rec.action}" cho ${rec.campaignName}</span>`;
    } catch (e) {
      if (row) row.querySelector('p').innerHTML += `<br><span class="text-rose-600">Lỗi: ${e.message}</span>`;
    }
  }

  const approveAllBtn = document.getElementById('approveAllBtn');
  if (approveAllBtn) {
    approveAllBtn.addEventListener('click', async () => {
      const adAccountId = document.getElementById('dcAdAccount').value;
      for (let i = 0; i < pendingRecommendations.length; i++) {
        await applyRecommendation(i, adAccountId);
      }
    });
  }

  const runLearningBtn = document.getElementById('runLearningBtn');
  if (runLearningBtn) {
    runLearningBtn.addEventListener('click', async () => {
      const el = document.getElementById('learningResult');
      const adAccountId = document.getElementById('dcAdAccount').value;
      const windowDays = document.getElementById('dcWindow').value;
      el.innerHTML = '<p class="text-sm text-muted">AI đang phân tích...</p>';
      try {
        const res = await fetch(`/admin/aai-ads/learning-insights?adAccountId=${encodeURIComponent(adAccountId)}&windowDays=${windowDays}`);
        const data = await res.json();
        if (data.error) throw new Error(data.error);
        function block(title, items) {
          if (!items || !items.length) return '';
          return `<p class="font-semibold text-ink mt-3 mb-1">${title}</p>` + items.map((i) => `<p class="text-sm mb-1">• ${i}</p>`).join('');
        }
        el.innerHTML =
          block('Pattern/Xu hướng', data.patterns) +
          block('⚠️ Cảnh báo mỏi quảng cáo', data.fatigueWarnings) +
          block('Nguồn tốt nhất', data.bestSources) +
          block('Lời khuyên cho chiến dịch tiếp theo', data.nextCampaignAdvice) || '<p class="text-sm text-muted">Chưa đủ dữ liệu để đưa ra nhận định.</p>';
      } catch (e) {
        el.innerHTML = `<p class="text-sm text-rose-600">Lỗi: ${e.message}</p>`;
      }
    });
  }

  // ---------------- Lợi nhuận & CRM ----------------

  const loadProfitBtn = document.getElementById('loadProfitBtn');
  if (loadProfitBtn) {
    loadProfitBtn.addEventListener('click', async () => {
      const adAccountId = document.getElementById('profitAdAccount').value;
      const windowDays = document.getElementById('profitWindow').value;
      const kpisEl = document.getElementById('profitKpis');
      const byCampEl = document.getElementById('profitByCampaign');
      kpisEl.innerHTML = '<p class="text-sm text-muted">Đang tính...</p>';
      byCampEl.innerHTML = '';
      try {
        const res = await fetch(`/admin/aai-ads/crm/profit-summary?adAccountId=${encodeURIComponent(adAccountId)}&windowDays=${windowDays}`);
        const s = await res.json();
        if (s.error) throw new Error(s.error);
        function fmt(n) { return Math.round(n || 0).toLocaleString('vi-VN') + 'đ'; }
        kpisEl.innerHTML = `
          <div class="card"><p class="text-xs text-muted">Doanh thu</p><p class="font-semibold text-ink">${fmt(s.revenue)}</p></div>
          <div class="card"><p class="text-xs text-muted">Chi phí quảng cáo</p><p class="font-semibold text-ink">${fmt(s.adSpend)}</p></div>
          <div class="card"><p class="text-xs text-muted">Lợi nhuận</p><p class="font-semibold ${s.profit >= 0 ? 'text-emerald-600' : 'text-rose-600'}">${fmt(s.profit)}</p></div>
          <div class="card"><p class="text-xs text-muted">Số đơn</p><p class="font-semibold text-ink">${s.orderCount}</p></div>
          <div class="card"><p class="text-xs text-muted">AOV / ROAS</p><p class="font-semibold text-ink">${fmt(s.aov)} / ${(s.roas || 0).toFixed(2)}x</p></div>`;
        byCampEl.innerHTML = (s.byCampaign || [])
          .map((c) => `<div class="flex justify-between border-b border-primary-100 py-1"><span>${c.campaignName}</span><span>Chi ${fmt(c.spend)} → DT ${fmt(c.revenue)} → LN <strong class="${c.profit >= 0 ? 'text-emerald-600' : 'text-rose-600'}">${fmt(c.profit)}</strong></span></div>`)
          .join('') || '<p class="text-muted">Chưa có đơn hàng khớp chiến dịch nào trong khoảng thời gian này.</p>';
      } catch (e) {
        kpisEl.innerHTML = `<p class="text-sm text-rose-600">Lỗi: ${e.message}</p>`;
      }
    });
  }

  const addProductBtn = document.getElementById('addProductBtn');
  if (addProductBtn) {
    addProductBtn.addEventListener('click', async () => {
      const name = document.getElementById('pName').value.trim();
      if (!name) return;
      const res = await fetch('/admin/aai-ads/crm/products', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name,
          cost: document.getElementById('pCost').value,
          shippingCost: document.getElementById('pShip').value,
          commissionPercent: document.getElementById('pCommission').value,
        }),
      });
      const p = await res.json();
      if (p.error) return;
      const list = document.getElementById('productsList');
      const row = document.createElement('div');
      row.className = 'flex items-center justify-between bg-primary-50/40 rounded px-3 py-2';
      row.dataset.productRow = p.id;
      row.innerHTML = `<span><strong>${p.name}</strong> — vốn ${p.cost}đ + ship ${p.shippingCost}đ + ${p.commissionPercent}% hoa hồng</span><button type="button" class="text-rose-600 text-xs" data-product-delete="${p.id}">Xóa</button>`;
      list.appendChild(row);
      row.querySelector('[data-product-delete]').addEventListener('click', () => deleteRow('product', p.id));
      const opt = document.createElement('option');
      opt.value = p.id;
      opt.textContent = p.name;
      document.getElementById('oProduct').appendChild(opt);
      ['pName', 'pCost', 'pShip', 'pCommission'].forEach((id) => (document.getElementById(id).value = ''));
    });
