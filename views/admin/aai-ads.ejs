  async function deleteRow(kind, id) {
    const pathByKind = { product: 'crm/products', os: 'crm/order-sources', order: 'crm/orders', lead: 'crm/leads', rule: 'automation/rules' };
    await fetch(`/admin/aai-ads/${pathByKind[kind]}/${id}/delete`, { method: 'POST' });
    const row = document.querySelector(`[data-${kind}-row="${id}"]`);
    if (row) row.remove();
  }
  document.querySelectorAll('[data-product-delete]').forEach((btn) => btn.addEventListener('click', () => deleteRow('product', btn.dataset.productDelete)));
  document.querySelectorAll('[data-order-delete]').forEach((btn) => btn.addEventListener('click', () => deleteRow('order', btn.dataset.orderDelete)));
  document.querySelectorAll('[data-lead-delete]').forEach((btn) => btn.addEventListener('click', () => deleteRow('lead', btn.dataset.leadDelete)));
  document.querySelectorAll('[data-rule-delete]').forEach((btn) => btn.addEventListener('click', () => deleteRow('rule', btn.dataset.ruleDelete)));

  const addOrderSourceBtn = document.getElementById('addOrderSourceBtn');
  if (addOrderSourceBtn) {
    addOrderSourceBtn.addEventListener('click', async () => {
      const msg = document.getElementById('osMsg');
      const name = document.getElementById('osName').value.trim();
      const apiUrl = document.getElementById('osApiUrl').value.trim();
      const authToken = document.getElementById('osAuthToken').value.trim();
      if (!name || !apiUrl) { msg.textContent = 'Vui lòng nhập tên và địa chỉ API.'; return; }
      const res = await fetch('/admin/aai-ads/crm/order-sources', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, apiUrl, authToken }),
      });
      const s = await res.json();
      if (s.error) { msg.textContent = `Lỗi: ${s.error}`; return; }
      const list = document.getElementById('orderSourcesList');
      const row = document.createElement('div');
      row.className = 'flex items-center justify-between bg-primary-50/40 rounded px-3 py-2';
      row.dataset.osRow = s.id;
      row.innerHTML = `<span><strong>${s.name}</strong> — ${s.apiUrl}</span><span class="flex gap-2"><button type="button" class="text-primary-700 text-xs" data-os-sync="${s.id}">Đồng bộ ngay</button><button type="button" class="text-rose-600 text-xs" data-os-delete="${s.id}">Xóa</button></span>`;
      list.appendChild(row);
      wireOrderSourceRow(row);
      document.getElementById('osName').value = '';
      document.getElementById('osApiUrl').value = '';
      document.getElementById('osAuthToken').value = '';
      msg.textContent = `Đã thêm "${name}".`;
    });
  }
  function wireOrderSourceRow(row) {
    const syncBtn = row.querySelector('[data-os-sync]');
    const delBtn = row.querySelector('[data-os-delete]');
    if (syncBtn) syncBtn.addEventListener('click', async () => {
      const msg = document.getElementById('osMsg');
      syncBtn.textContent = 'Đang đồng bộ...';
      try {
        const res = await fetch(`/admin/aai-ads/crm/order-sources/${syncBtn.dataset.osSync}/sync`, { method: 'POST' });
        const result = await res.json();
        if (result.error) throw new Error(result.error);
        msg.textContent = `Đã đồng bộ: thêm mới ${result.added}/${result.total} đơn.`;
      } catch (e) {
        msg.textContent = `Lỗi đồng bộ: ${e.message}`;
      }
      syncBtn.textContent = 'Đồng bộ ngay';
    });
    if (delBtn) delBtn.addEventListener('click', () => deleteRow('os', delBtn.dataset.osDelete));
  }
  document.querySelectorAll('#orderSourcesList [data-os-row]').forEach(wireOrderSourceRow);

  const addOrderBtn = document.getElementById('addOrderBtn');
  if (addOrderBtn) {
    addOrderBtn.addEventListener('click', async () => {
      const amount = document.getElementById('oAmount').value;
      if (!amount) return;
      const res = await fetch('/admin/aai-ads/crm/orders', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          amount,
          productId: document.getElementById('oProduct').value,
          campaignName: document.getElementById('oCampaign').value.trim(),
          customerPhone: document.getElementById('oPhone').value.trim(),
          orderChannel: document.getElementById('oChannel').value,
        }),
      });
      const o = await res.json();
      if (o.error) return;
      const list = document.getElementById('ordersList');
      const row = document.createElement('div');
      row.className = 'flex items-center justify-between bg-primary-50/40 rounded px-3 py-2';
      row.dataset.orderRow = o.id;
      row.innerHTML = `<span>${new Date(o.orderDate).toLocaleDateString('vi-VN')} — ${Number(o.amount).toLocaleString('vi-VN')}đ${o.campaignName ? ' — ' + o.campaignName : ''}</span><button type="button" class="text-rose-600 text-xs" data-order-delete="${o.id}">Xóa</button>`;
      list.prepend(row);
      row.querySelector('[data-order-delete]').addEventListener('click', () => deleteRow('order', o.id));
      ['oAmount', 'oCampaign', 'oPhone'].forEach((id) => (document.getElementById(id).value = ''));
    });
  }

  const addLeadBtn = document.getElementById('addLeadBtn');
  if (addLeadBtn) {
    addLeadBtn.addEventListener('click', async () => {
      const name = document.getElementById('lName').value.trim();
      if (!name) return;
      const res = await fetch('/admin/aai-ads/crm/leads', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name,
          email: document.getElementById('lEmail').value.trim(),
          phone: document.getElementById('lPhone').value.trim(),
          orderValue: document.getElementById('lOrderValue').value,
          source: 'manual',
        }),
      });
      const l = await res.json();
      if (l.error) return;
      prependLeadRow(l);
      ['lName', 'lEmail', 'lPhone', 'lOrderValue'].forEach((id) => (document.getElementById(id).value = ''));
    });
  }
  function prependLeadRow(l) {
    const list = document.getElementById('leadsList');
    const row = document.createElement('div');
    row.className = 'flex items-center justify-between bg-primary-50/40 rounded px-3 py-2';
    row.dataset.leadRow = l.id;
    row.innerHTML = `<span><strong>${l.name}</strong> <span class="badge">${l.tier}</span> ${l.email || ''} ${l.phone || ''}</span><span class="flex gap-2 items-center"><select class="input text-xs" data-lead-status="${l.id}"><option value="LEAD" selected>LEAD</option><option value="QUALIFIED">QUALIFIED</option><option value="CUSTOMER">CUSTOMER</option></select><button type="button" class="text-rose-600 text-xs" data-lead-delete="${l.id}">Xóa</button></span>`;
    list.prepend(row);
    row.querySelector('[data-lead-delete]').addEventListener('click', () => deleteRow('lead', l.id));
    wireLeadStatus(row.querySelector('[data-lead-status]'));
  }
  function wireLeadStatus(sel) {
    if (!sel) return;
    sel.addEventListener('change', () => {
      fetch(`/admin/aai-ads/crm/leads/${sel.dataset.leadStatus}/status`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status: sel.value }),
      });
    });
  }
  document.querySelectorAll('[data-lead-status]').forEach(wireLeadStatus);

  const addLeadBulkBtn = document.getElementById('addLeadBulkBtn');
  if (addLeadBulkBtn) {
    addLeadBulkBtn.addEventListener('click', async () => {
      const text = document.getElementById('lBulk').value.trim();
      if (!text) return;
      const res = await fetch('/admin/aai-ads/crm/leads/bulk', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ text }),
      });
      const result = await res.json();
      if (!result.error) {
        document.getElementById('lBulk').value = '';
        location.reload();
      }
    });
  }

  // ---------------- Tự động hóa ----------------

  const saveRuleBtn = document.getElementById('saveRuleBtn');
  if (saveRuleBtn) {
    saveRuleBtn.addEventListener('click', async () => {
      const msg = document.getElementById('autoMsg');
      const name = document.getElementById('autoName').value.trim();
      const threshold = document.getElementById('autoThreshold').value;
      if (!name || !threshold) { msg.textContent = 'Vui lòng nhập tên luật và ngưỡng.'; return; }
      try {
        const res = await fetch('/admin/aai-ads/automation/rules', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name,
            adAccountId: document.getElementById('autoAdAccount').value,
            scope: document.getElementById('autoScope').value,
            metric: document.getElementById('autoMetric').value,
            operator: document.getElementById('autoOperator').value,
            threshold,
            windowDays: document.getElementById('autoWindow').value,
            action: document.getElementById('autoAction').value,
            scalePercent: document.getElementById('autoScalePercent').value || 20,
            enabled: true,
          }),
        });
        const rule = await res.json();
        if (rule.error) throw new Error(rule.error);
        msg.textContent = 'Đã lưu luật — hệ thống sẽ tự kiểm tra mỗi 15 phút.';
        location.reload();
      } catch (e) {
        msg.textContent = `Lỗi: ${e.message}`;
      }
    });
  }

  document.querySelectorAll('[data-rule-toggle]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const res = await fetch(`/admin/aai-ads/automation/rules/${btn.dataset.ruleToggle}/toggle`, { method: 'POST' });
      if (res.ok) location.reload();
    });
  });

  const runAutomationNowBtn = document.getElementById('runAutomationNowBtn');
  if (runAutomationNowBtn) {
    runAutomationNowBtn.addEventListener('click', async () => {
      const msg = document.getElementById('autoMsg');
      msg.textContent = 'Đang kiểm tra...';
      try {
        const res = await fetch('/admin/aai-ads/automation/run-now', { method: 'POST' });
        const result = await res.json();
        if (result.error) throw new Error(result.error);
        msg.textContent = `Đã kiểm tra xong — ${result.triggered.length} luật được kích hoạt.`;
        location.reload();
      } catch (e) {
        msg.textContent = `Lỗi: ${e.message}`;
      }
    });
  }
})();
</script>
