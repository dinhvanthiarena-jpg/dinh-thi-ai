    <!-- ============ CÁC TAB CHƯA PORT — PLACEHOLDER ============ -->
    <% [
      ['dashboard', 'Tổng quan', 'Xem nhanh tổng chi tiêu và số chiến dịch đang chạy/tổng số.'],
      ['accounts', 'BM / Ad Account', 'Quản lý Business Manager và Ad Account liên kết.'],
      ['pixels', 'Pixel & CAPI', 'Xem Pixel, gửi sự kiện Conversions API, tạo Custom Conversion.'],
      ['insights', 'Hiệu suất', 'Bảng hiệu suất từng Ad: chi tiêu/CTR/CPC/CPA/ROAS, xuất CSV.'],
      ['research', 'Nghiên cứu đối thủ', 'Tra cứu Meta Ad Library, phân tích thị trường bằng AI.'],
      ['audiences', 'Đối tượng', 'Tạo Custom/Lookalike/Website/Engagement Audience.'],
      ['catalog', '🛍️ Catalog', 'Tạo Catalog sản phẩm, đồng bộ hàng loạt từ API website.'],
      ['googleads', 'Google Ads', 'Kết nối và tạo chiến dịch Search trên Google Ads.'],
      ['chatbot', 'Chatbot AI', 'Chatbot trả lời khách tự động qua Telegram, đúng tính cách thương hiệu.'],
      ['seo', 'SEO tự động', 'Quét lỗi SEO cơ bản và lấy điểm PageSpeed thật từ Google.'],
      ['marketing', 'Marketing', 'Tạo link UTM, sổ tay ghi chú kết quả các đợt chạy.'],
    ].forEach(([id, title, desc]) => { %>
      <div class="aai-tab" id="aai-tab-<%= id %>">
        <div class="aai-soon">
          <p class="font-semibold text-ink mb-1"><%= title %></p>
          <p class="text-sm mb-2"><%= desc %></p>
          <p class="text-xs">Sắp ra mắt trên bản web — hiện có sẵn trong tool desktop AAi-3dvietpro.</p>
        </div>
      </div>
    <% }) %>

  </div>
</div>

<% } %>

<script>
(function () {
  // ---------------- Điều hướng tab nội bộ (giống hệt tool desktop) ----------------
  const navBtns = document.querySelectorAll('.aai-nav-btn');
  const tabs = document.querySelectorAll('.aai-tab');
  function activateTab(tabId) {
    navBtns.forEach((b) => b.classList.toggle('active', b.dataset.tab === tabId));
    tabs.forEach((t) => t.classList.toggle('active', t.id === `aai-tab-${tabId}`));
    const group = document.querySelector(`.aai-nav-btn[data-tab="${tabId}"]`)?.closest('.aai-nav-group');
    if (group) group.classList.remove('collapsed');
  }
  navBtns.forEach((btn) => btn.addEventListener('click', () => activateTab(btn.dataset.tab)));
  document.querySelectorAll('.aai-nav-group-toggle').forEach((toggle) => {
    toggle.addEventListener('click', () => {
      document.getElementById(`aai-group-${toggle.dataset.group}`).classList.toggle('collapsed');
    });
  });
  const coldStartJumpBtn = document.getElementById('coldStartJumpBtn');
  if (coldStartJumpBtn) {
    coldStartJumpBtn.addEventListener('click', () => {
      activateTab('campaigns');
      const toggle = document.getElementById('coldStartToggle');
      if (toggle && !toggle.checked) {
        toggle.checked = true;
        toggle.dispatchEvent(new Event('change'));
      }
    });
  }

  const coldStartToggle = document.getElementById('coldStartToggle');
  const pixelBlock = document.getElementById('pixelBlock');
  const objLeads = document.getElementById('objLeads');
  const objSales = document.getElementById('objSales');
  const objective = document.getElementById('campObjective');
  if (coldStartToggle) {
    coldStartToggle.addEventListener('change', () => {
      const on = coldStartToggle.checked;
      pixelBlock.style.display = on ? 'none' : '';
      objLeads.disabled = on;
      objSales.disabled = on;
      if (on && (objective.value === 'OUTCOME_LEADS' || objective.value === 'OUTCOME_SALES')) {
        objective.value = 'OUTCOME_TRAFFIC';
      }
    });
  }

  const suggestBtn = document.getElementById('suggestPlanBtn');
  if (suggestBtn) {
    suggestBtn.addEventListener('click', async () => {
      const msg = document.getElementById('planMsg');
      const product = document.getElementById('planProduct').value.trim();
      const monthlyBudget = document.getElementById('planBudget').value.trim();
      if (!product || !monthlyBudget) {
        msg.textContent = 'Nhập sản phẩm và ngân sách trước.';
        return;
      }
      msg.textContent = 'AI đang phân tích...';
      try {
        const res = await fetch('/admin/aai-ads/suggest-plan', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ product, monthlyBudget, goal: document.getElementById('planGoal').value.trim() }),
        });
        const plan = await res.json();
        if (plan.error) throw new Error(plan.error);
        document.getElementById('campName').value = product;
        document.getElementById('campObjective').value = plan.objective || 'OUTCOME_TRAFFIC';
        document.getElementById('campBudget').value = plan.dailyBudget || Math.round(monthlyBudget / 30);
        document.getElementById('campAgeMin').value = plan.ageMin || 18;
        document.getElementById('campAgeMax').value = plan.ageMax || 65;
        document.getElementById('campGender').value = plan.gender || 'all';
        document.getElementById('campMessage').value = plan.primaryText || '';
        document.getElementById('campHeadline').value = (plan.headlines && plan.headlines[0]) || '';
        document.getElementById('campDescription').value = plan.description || '';
        if (coldStartToggle && coldStartToggle.checked) coldStartToggle.dispatchEvent(new Event('change'));
        msg.textContent = `Đã điền sẵn form bên dưới. Lý do AI: ${plan.reasoning || ''}`;
      } catch (e) {
        msg.textContent = `Lỗi: ${e.message}`;
      }
    });
  }

  let selectedInterests = [];
  function renderSelectedInterests() {
    const el = document.getElementById('selectedInterests');
    if (!el) return;
    el.innerHTML = selectedInterests
      .map((i, idx) => `<span class="badge bg-primary-100 text-primary-700">${i.name} <button type="button" data-remove="${idx}" class="ml-1 font-bold">×</button></span>`)
      .join('');
    el.querySelectorAll('[data-remove]').forEach((btn) => {
      btn.addEventListener('click', () => {
        selectedInterests.splice(parseInt(btn.dataset.remove, 10), 1);
        renderSelectedInterests();
        document.getElementById('interestsHidden').value = JSON.stringify(selectedInterests);
      });
    });
  }

  const searchInterestBtn = document.getElementById('searchInterestBtn');
  if (searchInterestBtn) {
    searchInterestBtn.addEventListener('click', async () => {
      const q = document.getElementById('interestQuery').value.trim();
      if (!q) return;
      const el = document.getElementById('interestResults');
      el.innerHTML = '<span class="text-sm text-muted">Đang tìm...</span>';
      try {
        const res = await fetch('/admin/aai-ads/interests?q=' + encodeURIComponent(q));
        const results = await res.json();
        if (results.error) throw new Error(results.error);
        el.innerHTML = results
          .map((r, idx) => `<button type="button" data-add="${idx}" class="badge bg-white border border-primary-200 text-primary-700">+ ${r.name}</button>`)
          .join('') || '<span class="text-sm text-muted">Không tìm thấy.</span>';
        el.querySelectorAll('[data-add]').forEach((btn) => {
          btn.addEventListener('click', () => {
            const item = results[parseInt(btn.dataset.add, 10)];
            if (!selectedInterests.some((i) => i.id === item.id)) selectedInterests.push(item);
            renderSelectedInterests();
            document.getElementById('interestsHidden').value = JSON.stringify(selectedInterests);
          });
        });
      } catch (e) {
        el.innerHTML = `<span class="text-sm text-rose-600">${e.message}</span>`;
      }
    });
  }

  const form = document.getElementById('campaignForm');
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const msg = document.getElementById('createMsg');
      msg.textContent = 'Đang tạo chiến dịch...';
      try {
        const formData = new FormData(form);
        const res = await fetch('/admin/aai-ads/create-campaign', { method: 'POST', body: formData });
        const result = await res.json();
        if (result.error) throw new Error(result.error);
        msg.innerHTML = `<span class="text-emerald-600 font-medium">✓ Đã tạo Campaign ${result.campaignId} / Ad Set ${result.adSetId}${result.adId ? ' / Ad ' + result.adId : ''} — trạng thái TẠM DỪNG.</span>` + (result.adError ? `<br><span class="text-amber-600">${result.adError}</span>` : '');
      } catch (e) {
        msg.innerHTML = `<span class="text-rose-600">Lỗi: ${e.message}</span>`;
      }
