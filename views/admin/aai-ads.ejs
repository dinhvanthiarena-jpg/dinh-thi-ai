          <% automationLog.slice(0, 30).forEach(e => { %>
            <div><%= new Date(e.time).toLocaleString('vi-VN') %> — <%= e.ruleName %> — <%= e.campaignName %> (<%= e.metric %>=<%= e.value %>) → <%= e.result %></div>
