<style>
  .aai-shell { display: flex; gap: 24px; align-items: flex-start; }
  .aai-nav { width: 224px; flex-shrink: 0; font-size: 14px; }
  .aai-nav-btn { display: block; width: 100%; text-align: left; padding: 8px 12px; border-radius: 8px; color: #57534e; background: transparent; border: none; cursor: pointer; margin-bottom: 2px; }
  .aai-nav-btn:hover { background: rgba(124,58,237,0.06); }
  .aai-nav-btn.active { background: #7c3aed; color: #fff; font-weight: 600; }
  .aai-nav-group-toggle { display: flex; justify-content: space-between; width: 100%; text-align: left; padding: 8px 12px; border-radius: 8px; color: #57534e; background: transparent; border: none; cursor: pointer; font-weight: 600; font-size: 13px; margin-top: 10px; }
  .aai-nav-group { padding-left: 10px; border-left: 2px solid #ede9fe; margin-left: 10px; }
  .aai-nav-group.collapsed { display: none; }
  .aai-content { flex: 1; min-width: 0; }
  .aai-tab { display: none; }
  .aai-tab.active { display: block; }
  .aai-soon { border: 1px dashed #d6d3d1; border-radius: 10px; padding: 24px; text-align: center; color: #78716c; }
</style>

<% if (!connected) { %>
  <div class="card p-6 max-w-2xl">
    <h2 class="font-semibold text-ink mb-2">Kết nối Facebook</h2>
    <p class="text-sm text-muted mb-4">Dùng chung Facebook Developer App "Ads Manager - DT" với tool desktop A-AI-3dvietpro. Đăng nhập 1 lần, token lưu trên server (chỉ /admin đã đăng nhập mới dùng được).</p>
    <a href="/admin/aai-ads/connect" class="btn-primary">Kết nối Facebook</a>
  </div>
<% } else if (loadError) { %>
  <div class="card p-5 bg-amber-50 border border-amber-200 max-w-2xl">
    <p class="text-sm text-amber-800">Lỗi tải dữ liệu Facebook: <%= loadError %>. Token có thể đã hết hạn — <a href="/admin/aai-ads/connect" class="underline">kết nối lại</a>.</p>
  </div>
<% } else { %>

<div class="aai-shell">
  <nav class="aai-nav">
    <button class="aai-nav-btn active" data-tab="settings">Cài đặt</button>
    <button class="aai-nav-btn" data-tab="intro">ℹ️ Giới thiệu</button>
    <button class="aai-nav-btn" data-tab="coldstart">🌱 Bắt đầu chạy Ads</button>
    <button class="aai-nav-btn" data-tab="fanpage">📄 Fanpage</button>

    <button class="aai-nav-group-toggle" data-group="ads"><span>📢 Chạy quảng cáo</span><span>▾</span></button>
    <div class="aai-nav-group" id="aai-group-ads">
      <button class="aai-nav-btn" data-tab="dashboard">Tổng quan</button>
      <button class="aai-nav-btn" data-tab="decisioncenter">🧠 AI Decision Center</button>
      <button class="aai-nav-btn" data-tab="profitcrm">💰 Lợi nhuận &amp; CRM</button>
      <button class="aai-nav-btn" data-tab="accounts">BM / Ad Account</button>
      <button class="aai-nav-btn" data-tab="pixels">Pixel &amp; CAPI</button>
      <button class="aai-nav-btn" data-tab="insights">Hiệu suất</button>
      <button class="aai-nav-btn" data-tab="research">Nghiên cứu đối thủ</button>
      <button class="aai-nav-btn" data-tab="audiences">Đối tượng</button>
      <button class="aai-nav-btn" data-tab="catalog">🛍️ Catalog</button>
      <button class="aai-nav-btn" data-tab="campaigns">Chiến dịch</button>
      <button class="aai-nav-btn" data-tab="googleads">Google Ads</button>
      <button class="aai-nav-btn" data-tab="automation">Tự động hóa</button>
    </div>

    <button class="aai-nav-group-toggle" data-group="content"><span>📝 Đăng bài &amp; Nội dung</span><span>▾</span></button>
    <div class="aai-nav-group" id="aai-group-content">
      <button class="aai-nav-btn" data-tab="autopost">Đăng bài tự động</button>
      <button class="aai-nav-btn" data-tab="chatbot">Chatbot AI</button>
      <button class="aai-nav-btn" data-tab="seo">SEO tự động</button>
      <button class="aai-nav-btn" data-tab="marketing">Marketing</button>
    </div>
  </nav>

  <div class="aai-content">

    <!-- ============ CÀI ĐẶT ============ -->
    <div class="aai-tab active" id="aai-tab-settings">
      <div class="card p-6 mb-6">
        <h2 class="font-semibold text-ink mb-1">Trạng thái kết nối</h2>
        <p class="text-sm text-emerald-600 mb-2">✓ Đã kết nối tài khoản Facebook (dùng chung App "Ads Manager - DT" với tool desktop).</p>
        <a href="/admin/aai-ads/connect" class="text-sm text-primary-700 underline">Kết nối lại</a>
      </div>
      <div class="card p-6">
        <h2 class="font-semibold text-ink mb-1">Website nhận bài (tùy chọn)</h2>
        <p class="text-sm text-muted mb-4">Website cần tự có sẵn 1 địa chỉ API nhận bài — tool gửi tới đó JSON dạng <code>{title, content, link, imageBase64}</code>. Thêm bao nhiêu website cũng được, rồi sang tab <strong>Đăng bài tự động</strong> để chọn nơi muốn đăng.</p>
        <div class="grid grid-cols-3 gap-2 mb-2">
          <input id="wtName" type="text" class="input" placeholder="Tên (VD: 3dvietpro)" />
          <input id="wtApiUrl" type="text" class="input" placeholder="https://.../api/auto-post" />
          <input id="wtAuthToken" type="text" class="input" placeholder="Mã xác thực (Bearer Token, nếu có)" />
        </div>
        <button id="addWebsiteTargetBtn" type="button" class="btn-outline">Thêm Website</button>
        <p id="wtMsg" class="text-sm text-muted mt-2"></p>
        <div id="websiteTargetsList" class="mt-3 space-y-1 text-sm">
          <% websiteTargets.forEach(t => { %>
            <div class="flex items-center justify-between bg-primary-50/40 rounded px-3 py-2" data-wt-row="<%= t.id %>">
              <span><strong><%= t.name %></strong> — <%= t.apiUrl %></span>
              <button type="button" class="text-rose-600 text-xs" data-wt-delete="<%= t.id %>">Xóa</button>
            </div>
          <% }) %>
        </div>
      </div>
    </div>

    <!-- ============ GIỚI THIỆU ============ -->
    <div class="aai-tab" id="aai-tab-intro">
      <div class="card p-6 max-w-2xl">
        <h2 class="font-semibold text-ink mb-1">A-AI Ads — bản Web</h2>
        <p class="text-sm text-muted mb-3">Đây là bản chạy trên web của tool desktop AAi-3dvietpro — cùng 1 bộ chức năng, nhưng chạy trên server luôn bật 24/7, không cần mở máy tính. Đăng nhập <code>/admin</code> ở bất kỳ đâu là dùng được.</p>
        <ul class="text-sm text-muted list-disc pl-5 space-y-1">
          <li>🎯 Chạy quảng cáo Facebook &amp; Google — AI đề xuất kế hoạch, tạo chiến dịch, theo dõi hiệu suất.</li>
          <li>📢 Đăng bài tự động — lên Fanpage, Group, Website, mỗi nơi 1 chủ đề riêng.</li>
          <li>💰 Theo dõi lợi nhuận thật, không chỉ ROAS.</li>
        </ul>
        <p class="text-sm text-muted mt-3">Một số mục vẫn đang được chuyển dần từ bản desktop sang — mục nào chưa xong sẽ ghi rõ "Sắp ra mắt".</p>
      </div>
    </div>

    <!-- ============ BẮT ĐẦU CHẠY ADS ============ -->
    <div class="aai-tab" id="aai-tab-coldstart">
      <div class="card p-6 max-w-2xl">
        <h2 class="font-semibold text-ink mb-1">🌱 Bắt đầu chạy Ads khi chưa có gì cả</h2>
        <p class="text-sm text-muted mb-3">Dành cho Fanpage/sản phẩm mới toanh: chưa cài Pixel, chưa có traffic, chưa biết khách hàng cũ là ai. Đây là cách chạy quảng cáo tiếp cận NGƯỜI MỚI hoàn toàn (gọi là <strong>Prospecting</strong>) — khác với nhắm lại khách quen (Retargeting, cần Pixel/danh sách khách).</p>
        <ul class="text-sm text-muted list-disc pl-5 space-y-1 mb-4">
          <li>Chỉ cần chọn Sở thích, Quốc gia, Độ tuổi, Giới tính phù hợp — Facebook tự tìm đúng nhóm người.</li>
          <li>Mục tiêu quảng cáo dùng loại Lưu lượng truy cập/Tương tác/Nhận diện thương hiệu — không dùng "Chuyển đổi" (cần Pixel).</li>
        </ul>
        <button type="button" class="btn-primary" id="coldStartJumpBtn">🚀 Bắt đầu tạo chiến dịch ngay</button>
      </div>
    </div>

    <!-- ============ FANPAGE ============ -->
    <div class="aai-tab" id="aai-tab-fanpage">
      <div class="card p-6">
        <h2 class="font-semibold text-ink mb-3">Fanpage đang quản trị</h2>
        <% if (pages.length) { %>
          <table class="w-full text-sm">
            <thead><tr class="text-left text-muted"><th class="pb-2">Tên Page</th><th class="pb-2">ID</th><th class="pb-2">Người theo dõi</th></tr></thead>
            <tbody>
              <% pages.forEach(p => { %>
                <tr class="border-t border-primary-100"><td class="py-2"><%= p.name %></td><td class="py-2 text-muted"><%= p.id %></td><td class="py-2 text-muted"><%= (p.fan_count || 0).toLocaleString() %></td></tr>
              <% }) %>
            </tbody>
          </table>
        <% } else { %>
          <p class="text-sm text-muted">Không tìm thấy Fanpage nào — kiểm tra tài khoản Facebook đã kết nối có quyền Admin/Editor trên Page không.</p>
        <% } %>
      </div>
    </div>

    <!-- ============ CHIẾN DỊCH (AI plan + form) ============ -->
    <div class="aai-tab" id="aai-tab-campaigns">
      <div class="card p-6 mb-6">
        <h2 class="font-semibold text-ink mb-1">AI đề xuất kế hoạch</h2>
        <p class="text-sm text-muted mb-4">Chỉ cần mô tả sản phẩm + ngân sách, AI tự điền phần còn lại bên dưới.</p>
        <label class="label">Sản phẩm/dịch vụ</label>
        <input id="planProduct" type="text" class="input mb-3" placeholder="VD: Sét áo nhung nơ thêu thỏ + quần lụa - giảm còn 699.000đ" />
        <label class="label">Mục tiêu kinh doanh</label>
        <input id="planGoal" type="text" class="input mb-3" placeholder="VD: Tăng khách bấm vào trang đặt hàng" />
        <label class="label">Tổng ngân sách trong tháng (VND)</label>
        <input id="planBudget" type="text" class="input mb-3" placeholder="3000000" />
        <button id="suggestPlanBtn" type="button" class="btn-outline">AI đề xuất kế hoạch</button>
        <p id="planMsg" class="text-sm text-muted mt-2"></p>
      </div>

      <form id="campaignForm" class="card p-6 space-y-4">
        <h2 class="font-semibold text-ink">Chi tiết chiến dịch</h2>

        <div>
          <label class="label">Ad Account</label>
          <select name="adAccountId" class="input">
            <% adAccounts.forEach(a => { %>
              <option value="<%= a.id %>"><%= a.name %> (<%= a.id %>)</option>
            <% }) %>
          </select>
        </div>

        <label class="flex items-start gap-2 bg-primary-50/40 border border-primary-100 rounded-lg p-3 cursor-pointer">
          <input id="coldStartToggle" type="checkbox" class="mt-1" />
          <span class="text-sm text-ink">🌱 <strong>Trang/sản phẩm mới, chưa có Pixel hay khách hàng cũ</strong> — tự chuyển Mục tiêu sang loại không cần Pixel, ẩn ô Pixel ID.</span>
        </label>

        <div>
          <label class="label">Tên chiến dịch</label>
          <input name="name" id="campName" type="text" class="input" required />
        </div>

        <div>
          <label class="label">Mục tiêu</label>
          <select name="objective" id="campObjective" class="input">
            <option value="OUTCOME_AWARENESS">Nhận diện thương hiệu</option>
            <option value="OUTCOME_TRAFFIC" selected>Lưu lượng truy cập (traffic)</option>
            <option value="OUTCOME_ENGAGEMENT">Tương tác</option>
            <option value="OUTCOME_LEADS" id="objLeads">Thu thập khách hàng tiềm năng (cần Pixel)</option>
            <option value="OUTCOME_SALES" id="objSales">Chuyển đổi/bán hàng (cần Pixel)</option>
          </select>
        </div>

        <div>
          <label class="label">Ngân sách mỗi ngày (VND)</label>
          <input name="dailyBudget" id="campBudget" type="text" class="input" placeholder="100000" required />
        </div>

        <div>
          <label class="label">Chạy trong (ngày) — để trống nếu muốn chạy liên tục tới khi tự tay dừng</label>
          <input name="lifetimeDays" id="campLifetimeDays" type="text" class="input" placeholder="VD: 10 (chạy thử 10 ngày rồi tự dừng)" />
        </div>

        <div id="pixelBlock">
          <label class="label">Pixel ID (chỉ cần nếu chọn mục tiêu cần Pixel)</label>
          <input name="pixelId" type="text" class="input" placeholder="Dán Pixel ID" />
        </div>

        <div class="grid grid-cols-3 gap-3">
          <div>
            <label class="label">Quốc gia</label>
            <input name="countries" value="VN" type="text" class="input" />
          </div>
          <div>
            <label class="label">Tuổi từ</label>
            <input name="ageMin" id="campAgeMin" value="18" type="text" class="input" />
          </div>
          <div>
            <label class="label">Tuổi đến</label>
            <input name="ageMax" id="campAgeMax" value="65" type="text" class="input" />
          </div>
        </div>

        <div>
          <label class="label">Giới tính</label>
          <select name="gender" id="campGender" class="input">
            <option value="all">Tất cả</option>
            <option value="male">Nam</option>
            <option value="female">Nữ</option>
          </select>
        </div>

        <div>
          <label class="label">Sở thích mục tiêu (Detailed Targeting)</label>
          <div class="flex gap-2">
            <input id="interestQuery" type="text" class="input" placeholder="VD: thời trang nữ, mua sắm online" />
            <button id="searchInterestBtn" type="button" class="btn-outline flex-shrink-0">Tìm</button>
          </div>
          <div id="interestResults" class="flex flex-wrap gap-2 mt-2"></div>
          <div id="selectedInterests" class="flex flex-wrap gap-2 mt-2"></div>
        </div>

        <hr class="border-primary-100" />
        <h3 class="font-semibold text-ink">Nội dung Ad (bỏ trống nếu chỉ muốn tạo khung Campaign/Ad Set trước)</h3>

        <div>
          <label class="label">Fanpage đứng tên quảng cáo</label>
          <select name="pageId" class="input">
            <option value="">(không tạo Ad, chỉ tạo khung)</option>
            <% pages.forEach(p => { %>
              <option value="<%= p.id %>"><%= p.name %></option>
            <% }) %>
          </select>
        </div>

        <div>
          <label class="label">Ảnh quảng cáo — tải lên</label>
          <input name="image" type="file" accept="image/*" class="input" />
        </div>
        <div>
          <label class="label">...hoặc dán link ảnh có sẵn (VD: ảnh thật trên trang sản phẩm)</label>
          <input name="imageUrl" id="campImageUrl" type="text" class="input" placeholder="https://3dvietpro.com/shop/uploads/..." />
        </div>

        <div>
          <label class="label">Link đích</label>
          <input name="linkUrl" id="campLinkUrl" type="text" class="input" placeholder="https://3dvietpro.com/shop/lp/set-ao-nhung" />
        </div>
        <div>
          <label class="label">Nội dung chính (primary text)</label>
          <textarea name="message" id="campMessage" rows="3" class="input"></textarea>
        </div>
        <div>
          <label class="label">Tiêu đề (headline)</label>
          <input name="headline" id="campHeadline" type="text" class="input" />
        </div>
        <div>
          <label class="label">Mô tả</label>
          <input name="description" id="campDescription" type="text" class="input" />
        </div>
        <div>
          <label class="label">Call to action</label>
          <select name="cta" id="campCta" class="input">
            <option value="LEARN_MORE">Tìm hiểu thêm</option>
            <option value="SIGN_UP">Đăng ký</option>
            <option value="SHOP_NOW">Mua ngay</option>
            <option value="ORDER_NOW">Đặt hàng</option>
            <option value="CONTACT_US">Liên hệ</option>
          </select>
        </div>

        <input type="hidden" name="interests" id="interestsHidden" value="[]" />

        <button type="submit" class="btn-primary">🚀 Tạo chiến dịch (tạm dừng)</button>
        <div id="createMsg" class="text-sm mt-2"></div>
      </form>
    </div>

    <!-- ============ ĐĂNG BÀI TỰ ĐỘNG ============ -->
    <div class="aai-tab" id="aai-tab-autopost">
      <div class="card p-6">
        <h2 class="font-semibold text-ink mb-1">Đăng bài tự động</h2>
        <p class="text-sm text-muted mb-4">Đăng lên Fanpage, Group, và cả Website chỉ trong 1 lần chạy — không cần đăng riêng từng nơi. Chạy trên server LUÔN BẬT, không cần mở trang admin này.</p>

        <button id="runAllNowBtn" type="button" class="btn-primary mb-2">▶ Chạy đăng bài ngay</button>
        <p id="runAllNowMsg" class="text-sm text-muted mb-4"></p>

        <h3 class="font-semibold text-ink mb-2">Tần suất đăng (áp dụng chung mọi Page/Group/Website)</h3>
        <div class="grid grid-cols-2 gap-3 mb-2 max-w-sm">
          <div>
            <label class="label">Số bài / ngày</label>
            <input id="postFreqPerDay" type="text" class="input" value="<%= postingFreq.postsPerDay %>" />
          </div>
          <div>
            <label class="label">Cách nhau tối thiểu (phút)</label>
            <input id="postFreqGap" type="text" class="input" value="<%= postingFreq.minGapMinutes %>" />
          </div>
        </div>

        <hr class="border-primary-100 my-4" />
        <h3 class="font-semibold text-ink mb-2">🤖 AI tự động đăng bài hàng ngày</h3>
        <p class="text-sm text-muted mb-2">AI tự tìm kiếm tin tức/xu hướng mới nhất về chủ đề, tự viết bài (bài dài cho Website, caption ngắn cho Facebook, không sao chép nguồn), tự tìm ảnh phù hợp, và tự đăng — không cần soạn tay.</p>
        <label class="flex items-center gap-2 mb-3">
          <input id="aiApEnabled" type="checkbox" <%= aiAutoPostConfig.enabled ? 'checked' : '' %> />
          <span class="text-sm text-ink">Bật AI tự động đăng bài</span>
        </label>
        <label class="label">Chủ đề/sản phẩm/dịch vụ cần quảng bá</label>
        <textarea id="aiApTopic" rows="2" class="input mb-3" placeholder="VD: Khóa học ứng dụng AI cho giáo viên"><%= aiAutoPostConfig.topic %></textarea>
        <label class="label">Fanpage muốn đăng (giữ Ctrl để chọn nhiều)</label>
        <select id="aiApPageIds" multiple class="input mb-3" style="height:110px;">
          <% pages.forEach(p => { %>
            <option value="<%= p.id %>" <%= aiAutoPostConfig.pageIds.includes(p.id) ? 'selected' : '' %>><%= p.name %></option>
          <% }) %>
        </select>
        <label class="label">Website muốn đăng đồng thời (giữ Ctrl để chọn nhiều, tùy chọn)</label>
        <select id="aiApWebsiteTargetIds" multiple class="input mb-3" style="height:80px;">
          <% websiteTargets.forEach(t => { %>
            <option value="<%= t.id %>" <%= aiAutoPostConfig.websiteTargetIds.includes(t.id) ? 'selected' : '' %>><%= t.name %></option>
          <% }) %>
        </select>
        <label class="label">Link đính kèm (tùy chọn)</label>
        <input id="aiApLink" type="text" class="input mb-3" value="<%= aiAutoPostConfig.link %>" placeholder="https://..." />
        <label class="label">ID các Group muốn đăng chéo (mỗi dòng 1 ID, tùy chọn)</label>
        <textarea id="aiApGroupIds" rows="2" class="input mb-3"><%= (aiAutoPostConfig.groupIds || []).join('\n') %></textarea>
        <button id="saveAiApBtn" type="button" class="btn-outline">Lưu cấu hình</button>
        <button id="runAiApNowBtn" type="button" class="btn-outline">Chạy thử ngay</button>
        <p id="aiApMsg" class="text-sm text-muted mt-2"></p>

        <hr class="border-primary-100 my-4" />
        <h3 class="font-semibold text-ink mb-2">Hàng chờ đăng bài thủ công</h3>
        <label class="label">Fanpage</label>
        <select id="apPageId" class="input mb-2">
          <% pages.forEach(p => { %>
            <option value="<%= p.id %>"><%= p.name %></option>
          <% }) %>
        </select>
        <label class="label">Nội dung</label>
        <textarea id="apMessage" rows="3" class="input mb-2" placeholder="Nội dung bài đăng..."></textarea>
        <label class="label">Link đính kèm (tùy chọn)</label>
        <input id="apLink" type="text" class="input mb-2" placeholder="https://..." />
        <button id="addToQueueBtn" type="button" class="btn-outline">Thêm vào hàng chờ</button>
        <p id="apMsg" class="text-sm text-muted mt-2 mb-3"></p>
