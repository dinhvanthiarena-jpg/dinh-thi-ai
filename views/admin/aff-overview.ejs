<h1 class="text-2xl font-extrabold text-ink mb-4">AFF</h1>
<%- include('../partials/aff-tabs') %>

<div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
  <div class="card p-5">
    <p class="text-xs uppercase tracking-wide text-muted font-semibold">Tổng thu nhập toàn web</p>
    <p class="text-2xl font-extrabold text-primary-700 mt-1 tabular-nums"><%= Number(baoCao.tongThuNhap).toLocaleString('vi-VN') %>đ</p>
    <p class="text-xs text-muted mt-1">Khóa học + Tool + Gói Pro (đã thanh toán)</p>
  </div>
  <div class="card p-5">
    <p class="text-xs uppercase tracking-wide text-muted font-semibold">Hoa hồng chờ duyệt</p>
    <p class="text-2xl font-extrabold text-amber-600 mt-1 tabular-nums"><%= Number(baoCao.hoaHongChoDuyet).toLocaleString('vi-VN') %>đ</p>
    <p class="text-xs text-muted mt-1">Trong 7 ngày chờ, chưa khả dụng</p>
  </div>
  <div class="card p-5">
    <p class="text-xs uppercase tracking-wide text-muted font-semibold">Hoa hồng đã duyệt</p>
    <p class="text-2xl font-extrabold text-ink mt-1 tabular-nums"><%= Number(baoCao.hoaHongDaDuyet).toLocaleString('vi-VN') %>đ</p>
    <p class="text-xs text-muted mt-1">Khả dụng, đang nằm trong ví</p>
  </div>
  <div class="card p-5">
    <p class="text-xs uppercase tracking-wide text-muted font-semibold">Hoa hồng đã chi trả</p>
    <p class="text-2xl font-extrabold text-emerald-600 mt-1 tabular-nums"><%= Number(baoCao.hoaHongDaChiTra).toLocaleString('vi-VN') %>đ</p>
    <p class="text-xs text-muted mt-1">Đã duyệt rút về ngân hàng</p>
  </div>
</div>

<div class="card mt-6 overflow-x-auto">
  <div class="px-4 py-3 border-b border-slate-100 font-semibold text-ink">Top 10 hoa hồng cao nhất</div>
  <table class="w-full text-sm">
    <thead class="text-left text-muted border-b border-slate-100">
      <tr>
        <th class="px-4 py-3 font-semibold">#</th>
        <th class="px-4 py-3 font-semibold">Thành viên</th>
        <th class="px-4 py-3 font-semibold text-right">Tổng hoa hồng</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      <% if (!topHang.length) { %>
        <tr><td colspan="3" class="px-4 py-10 text-center text-muted">Chưa có hoa hồng nào phát sinh.</td></tr>
      <% } %>
      <% topHang.forEach(function (h, i) { %>
        <tr>
          <td class="px-4 py-3 text-muted"><%= i + 1 %></td>
          <td class="px-4 py-3">
            <div class="font-semibold text-ink"><%= h.user ? h.user.name : '—' %></div>
            <div class="text-muted text-xs"><%= h.user ? h.user.email : '' %></div>
          </td>
          <td class="px-4 py-3 text-right font-semibold text-primary-700 tabular-nums"><%= Number(h.tongHoaHong).toLocaleString('vi-VN') %>đ</td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>
