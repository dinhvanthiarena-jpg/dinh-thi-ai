<div class="flex justify-between items-center mb-6">
  <p class="text-muted text-sm">Tổng số: <%= posts.length %> bài viết</p>
  <a href="/admin/blog/new" class="btn-primary">+ Thêm bài viết</a>
</div>

<div class="card overflow-hidden">
  <table class="w-full text-sm">
    <thead class="bg-primary-50 text-ink">
      <tr>
        <th class="text-left px-5 py-3 font-semibold">Tiêu đề</th>
        <th class="text-right px-5 py-3 font-semibold">Lượt xem</th>
        <th class="text-center px-5 py-3 font-semibold">Trạng thái</th>
        <th class="text-right px-5 py-3 font-semibold">Hành động</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-primary-50">
      <% posts.forEach(function(p) { %>
        <tr>
          <td class="px-5 py-3 text-ink font-medium"><%= p.title %></td>
          <td class="px-5 py-3 text-right text-muted"><%= p.viewCount %></td>
          <td class="px-5 py-3 text-center">
            <span class="badge <%= p.isPublished ? 'bg-green-50 text-green-700' : 'bg-slate-100 text-slate-600' %>"><%= p.isPublished ? 'Đã đăng' : 'Bản nháp' %></span>
          </td>
          <td class="px-5 py-3 text-right space-x-2 whitespace-nowrap">
            <a href="/admin/blog/<%= p._id %>/edit" class="text-primary-700 hover:underline">Sửa</a>
            <form action="/admin/blog/<%= p._id %>/delete" method="POST" class="inline" onsubmit="return confirm('Xoa bai viet nay?');">
              <button type="submit" class="text-danger hover:underline cursor-pointer">Xóa</button>
            </form>
          </td>
        </tr>
      <% }); %>
      <% if (!posts.length) { %>
        <tr><td colspan="4" class="px-5 py-8 text-center text-muted">Chưa có bài viết nào.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>
