<div class="grid grid-cols-3 gap-3 mb-4">
  <div class="card px-5 py-4">
    <div class="text-2xl font-bold text-ink"><%= students.length %></div>
    <div class="text-sm text-muted">Tổng học viên</div>
  </div>
  <div class="card px-5 py-4">
    <div class="text-2xl font-bold text-ink"><%= tuApp %></div>
    <div class="text-sm text-muted">Đăng ký từ app ON-Language</div>
  </div>
  <div class="card px-5 py-4">
    <div class="text-2xl font-bold text-ink"><%= moiHomNay %></div>
    <div class="text-sm text-muted">Mới hôm nay</div>
  </div>
</div>

<div class="card overflow-hidden">
  <table class="w-full text-sm">
    <thead class="bg-primary-50 text-ink">
      <tr>
        <th class="text-left px-5 py-3 font-semibold">Họ tên</th>
        <th class="text-left px-5 py-3 font-semibold">Email</th>
        <th class="text-left px-5 py-3 font-semibold">Điện thoại</th>
        <th class="text-left px-5 py-3 font-semibold">Đăng ký từ</th>
        <th class="text-left px-5 py-3 font-semibold">Trạng thái</th>
        <th class="text-right px-5 py-3 font-semibold">Ngày tham gia</th>
        <th class="px-5 py-3"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-primary-50">
      <% students.forEach(function(s) { %>
        <tr>
          <td class="px-5 py-3 text-ink font-medium"><%= s.name %></td>
          <td class="px-5 py-3 text-muted"><%= s.email || '—' %></td>
          <td class="px-5 py-3 text-muted"><%= s.phone || '—' %></td>
          <td class="px-5 py-3">
            <% if (s.phone && !s.email) { %>
              <span class="inline-block rounded-full bg-primary-50 text-primary-700 px-2.5 py-1 text-xs font-semibold">App ON-Language</span>
            <% } else { %>
              <span class="inline-block rounded-full bg-slate-100 text-slate-600 px-2.5 py-1 text-xs font-semibold">Web</span>
            <% } %>
          </td>
          <td class="px-5 py-3">
            <% if (s.isActive) { %>
              <span class="inline-block rounded-full bg-emerald-100 text-emerald-700 px-2.5 py-1 text-xs font-semibold">Hoạt động</span>
            <% } else { %>
              <span class="inline-block rounded-full bg-red-100 text-red-700 px-2.5 py-1 text-xs font-semibold">Đã khoá</span>
            <% } %>
          </td>
          <td class="px-5 py-3 text-right text-muted"><%= new Date(s.createdAt).toLocaleDateString('vi-VN') %></td>
          <td class="px-5 py-3">
            <div class="flex gap-1.5 justify-end whitespace-nowrap">
              <a href="/admin/students/<%= s.id %>/sua" class="btn-outline text-xs px-2.5 py-1">Sửa</a>
              <form method="POST" action="/admin/students/<%= s.id %>/khoa">
                <button class="btn-outline text-xs px-2.5 py-1"><%= s.isActive ? 'Khoá' : 'Mở khoá' %></button>
              </form>
              <form method="POST" action="/admin/students/<%= s.id %>/xoa" onsubmit="return confirm('Xoá vĩnh viễn tài khoản này? Toàn bộ đơn hàng, ví, hoa hồng liên quan sẽ bị xoá theo, không thể khôi phục.')">
                <button class="text-xs px-2.5 py-1 rounded-lg border border-red-200 text-red-700 hover:bg-red-50">Xoá</button>
              </form>
            </div>
          </td>
        </tr>
      <% }); %>
      <% if (!students.length) { %>
        <tr><td colspan="7" class="px-5 py-8 text-center text-muted">Chưa có học viên nào.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>
