<div class="space-y-6">
  <div class="card p-5">
    <h2 class="text-lg font-bold text-ink mb-1">Lượt xem theo ngày — theo nguồn truy cập</h2>
    <p class="text-xs text-muted mb-3">30 ngày gần nhất</p>

    <% if (!dailyChart.series.length) { %>
      <p class="py-10 text-center text-sm text-muted">Chưa có dữ liệu.</p>
    <% } else { %>
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2 mb-4 text-sm">
        <% dailyChart.series.forEach(function(s) { %>
          <span class="flex items-center gap-1.5">
            <span class="h-2.5 w-2.5 rounded-full" style="background: <%= s.color %>"></span>
            <span class="text-ink"><%= s.name %></span>
            <span class="text-muted font-semibold tabular-nums"><%= s.total.toLocaleString('vi-VN') %></span>
          </span>
        <% }); %>
        <% if (dailyChart.othersCount > 0) { %>
          <span class="text-muted">+<%= dailyChart.othersCount %> nguồn khác</span>
        <% } %>
      </div>

      <div class="overflow-x-auto">
        <svg viewBox="0 0 <%= dailyChart.width %> <%= dailyChart.height %>" class="w-full" style="min-width: 480px;">
          <% dailyChart.yTicks.forEach(function(t) { %>
            <line x1="<%= dailyChart.plotLeft %>" y1="<%= t.y %>" x2="<%= dailyChart.width - 12 %>" y2="<%= t.y %>" stroke="#eef2ff" stroke-width="1" />
            <text x="0" y="<%= t.y %>" dy="4" font-size="11" fill="#94a3b8"><%= t.label %></text>
          <% }); %>
          <% dailyChart.xTicks.forEach(function(t) { %>
            <text x="<%= t.x %>" y="<%= dailyChart.height - 4 %>" font-size="11" fill="#94a3b8" text-anchor="middle"><%= t.label %></text>
          <% }); %>
          <% dailyChart.series.forEach(function(s) { %>
            <polyline points="<%= s.points %>" fill="none" stroke="<%= s.color %>" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round" />
          <% }); %>
        </svg>
      </div>
    <% } %>
  </div>

  <div class="grid sm:grid-cols-2 gap-5 items-start">
    <div class="card p-5">
      <h2 class="text-lg font-bold text-ink mb-1">Top nguồn truy cập</h2>
      <p class="text-xs text-muted mb-3">30 ngày gần nhất — Google, Facebook, quảng cáo, hay trực tiếp</p>
      <% if (!viewsBySource.length) { %>
        <p class="py-6 text-center text-sm text-muted">Chưa có dữ liệu.</p>
      <% } else { %>
        <div class="space-y-2.5">
          <% viewsBySource.forEach(function(row) { %>
            <% const pct = viewsBySourceTotal ? Math.round((row.total / viewsBySourceTotal) * 100) : 0; %>
            <a href="#" class="block">
              <div class="flex items-center justify-between text-sm mb-1">
                <span class="text-ink font-medium flex items-center gap-1.5">
                  <span class="h-2.5 w-2.5 rounded-full shrink-0" style="background: <%= row.color %>"></span>
                  <%= row.source %>
                </span>
                <span class="text-muted tabular-nums"><%= row.total %> lượt (<%= pct %>%)</span>
              </div>
              <div class="h-1.5 rounded-full bg-primary-50 overflow-hidden">
                <div class="h-full rounded-full" style="width: <%= pct %>%; background: <%= row.color %>"></div>
              </div>
            </a>
          <% }); %>
        </div>
      <% } %>
    </div>

    <div class="card p-5">
      <h2 class="text-lg font-bold text-ink mb-1">Top bài viết được xem nhiều nhất</h2>
      <p class="text-xs text-muted mb-3">30 ngày gần nhất</p>
      <% if (!topViewedPages.length) { %>
        <p class="py-6 text-center text-sm text-muted">Chưa có dữ liệu.</p>
      <% } else { %>
        <div class="space-y-2.5">
          <% topViewedPages.forEach(function(row) { %>
            <% const pct = topViewedPagesTotal ? Math.round((row.total / topViewedPagesTotal) * 100) : 0; %>
            <a href="/blog/<%= row.slug %>" target="_blank" class="block group">
              <div class="flex items-center justify-between text-sm mb-1 gap-4">
                <span class="text-ink font-medium truncate group-hover:text-primary-700"><%= row.title %></span>
                <span class="text-muted shrink-0 tabular-nums"><%= row.total %> lượt</span>
              </div>
              <div class="h-1.5 rounded-full bg-primary-50 overflow-hidden">
                <div class="h-full rounded-full bg-accent-600" style="width: <%= pct %>%"></div>
              </div>
            </a>
          <% }); %>
        </div>
      <% } %>
    </div>
  </div>

  <div class="card p-5">
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
      <div>
        <h2 class="text-sm font-bold text-ink mb-0.5">Lượt xem bài viết</h2>
        <p class="text-xs text-muted mb-2">Theo ngày — 30 ngày gần nhất</p>
        <div class="max-h-72 overflow-y-auto rounded-lg border border-primary-50">
          <table class="w-full text-sm">
            <thead class="sticky top-0 bg-white">
              <tr class="text-left text-muted border-b border-primary-100">
                <th class="py-1.5 px-3">Ngày</th>
                <th class="py-1.5 px-3 text-right">Lượt xem</th>
              </tr>
            </thead>
            <tbody>
              <% if (!viewsByDay.length) { %>
                <tr><td colspan="2" class="py-6 text-center text-muted">Chưa có dữ liệu.</td></tr>
              <% } %>
              <% viewsByDay.forEach(function(row) { %>
                <tr class="border-b border-primary-50 last:border-0">
                  <td class="py-1.5 px-3 text-ink"><%= new Date(row.day).toLocaleDateString('vi-VN') %></td>
                  <td class="py-1.5 px-3 text-right font-semibold text-primary-700 tabular-nums"><%= row.total %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>

      <div>
        <h2 class="text-sm font-bold text-ink mb-0.5">&nbsp;</h2>
        <p class="text-xs text-muted mb-2">Theo tháng — 12 tháng gần nhất</p>
        <div class="rounded-lg border border-primary-50 divide-y divide-primary-50">
          <% if (!viewsByMonth.length) { %>
            <p class="py-6 text-center text-sm text-muted">Chưa có dữ liệu.</p>
          <% } %>
          <% viewsByMonth.forEach(function(row) { %>
            <div class="flex items-center justify-between px-3 py-2 text-sm">
              <span class="text-ink"><%= row.month %></span>
              <span class="font-semibold text-primary-700 tabular-nums"><%= Number(row.total).toLocaleString('vi-VN') %></span>
            </div>
          <% }); %>
        </div>
      </div>

      <div>
        <h2 class="text-sm font-bold text-ink mb-0.5">Lượt bấm link Shopee</h2>
        <p class="text-xs text-muted mb-2">Theo ngày — 30 ngày gần nhất</p>
        <div class="max-h-72 overflow-y-auto rounded-lg border border-primary-50">
          <table class="w-full text-sm">
            <thead class="sticky top-0 bg-white">
              <tr class="text-left text-muted border-b border-primary-100">
                <th class="py-1.5 px-3">Ngày</th>
                <th class="py-1.5 px-3 text-right">Lượt bấm</th>
              </tr>
            </thead>
            <tbody>
              <% if (!clicksByDay.length) { %>
                <tr><td colspan="2" class="py-6 text-center text-muted">Chưa có dữ liệu.</td></tr>
              <% } %>
              <% clicksByDay.forEach(function(row) { %>
                <tr class="border-b border-primary-50 last:border-0">
                  <td class="py-1.5 px-3 text-ink"><%= new Date(row.day).toLocaleDateString('vi-VN') %></td>
                  <td class="py-1.5 px-3 text-right font-semibold text-orange-600 tabular-nums"><%= row.total %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>

      <div>
        <h2 class="text-sm font-bold text-ink mb-0.5">&nbsp;</h2>
        <p class="text-xs text-muted mb-2">Theo tháng — 12 tháng gần nhất</p>
        <div class="rounded-lg border border-primary-50 divide-y divide-primary-50">
          <% if (!clicksByMonth.length) { %>
            <p class="py-6 text-center text-sm text-muted">Chưa có dữ liệu.</p>
          <% } %>
          <% clicksByMonth.forEach(function(row) { %>
            <div class="flex items-center justify-between px-3 py-2 text-sm">
              <span class="text-ink"><%= row.month %></span>
              <span class="font-semibold text-orange-600 tabular-nums"><%= Number(row.total).toLocaleString('vi-VN') %></span>
            </div>
          <% }); %>
        </div>
      </div>
    </div>
  </div>
</div>
