<div class="flex justify-between items-center mb-6">
  <p class="text-muted text-sm">Tổng số: <%= photos.length %> ảnh</p>
  <a href="/admin/gallery/new" class="btn-primary">+ Thêm ảnh</a>
</div>

<% if (photos.length) { %>
  <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
    <% photos.forEach(function(p) { %>
      <div class="card overflow-hidden">
        <div class="aspect-video bg-primary-50 overflow-hidden">
          <img src="<%= p.imageUrl %>" alt="<%= p.title %>" class="w-full h-full object-cover" />
        </div>
        <div class="p-4">
          <p class="font-medium text-ink text-sm line-clamp-1"><%= p.title %></p>
          <p class="text-xs text-muted mt-1"><%= new Date(p.eventDate).toLocaleDateString('vi-VN') %></p>
          <span class="badge mt-2 <%= p.isPublished ? 'bg-green-50 text-green-700' : 'bg-slate-100 text-slate-600' %>"><%= p.isPublished ? 'Đã đăng' : 'Ẩn' %></span>
          <div class="mt-3 flex justify-between text-sm">
            <a href="/admin/gallery/<%= p._id %>/edit" class="text-primary-700 hover:underline">Sửa</a>
            <form action="/admin/gallery/<%= p._id %>/delete" method="POST" onsubmit="return confirm('Xóa ảnh này?');">
              <button type="submit" class="text-danger hover:underline cursor-pointer">Xóa</button>
            </form>
          </div>
        </div>
      </div>
    <% }); %>
  </div>
<% } else { %>
  <div class="card p-12 text-center text-muted">Chưa có ảnh hoạt động nào.</div>
<% } %>
