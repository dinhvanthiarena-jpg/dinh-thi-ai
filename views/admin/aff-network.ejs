<h1 class="text-2xl font-extrabold text-ink mb-4">AFF</h1>
<%- include('../partials/aff-tabs') %>

<style>
  /* Sơ đồ cây kiểu tổ chức (org-chart) thuần CSS — không cần thư viện vẽ
     đồ hoạ nào. Mỗi <li> là 1 thành viên, đường kẻ nối bằng border. */
  .aff-tree, .aff-tree ul { list-style: none; margin: 0; padding: 0; }
  .aff-tree { text-align: center; padding-top: 8px; overflow-x: auto; }
  .aff-tree ul { display: flex; padding-top: 28px; position: relative; justify-content: center; }
  .aff-tree li { position: relative; padding: 28px 10px 0 10px; display: flex; flex-direction: column; align-items: center; }
  .aff-tree li::before, .aff-tree li::after {
    content: ''; position: absolute; top: 0; right: 50%; border-top: 1.5px solid #ddd6fe; width: 50%; height: 28px;
  }
  .aff-tree li::after { right: auto; left: 50%; border-left: 1.5px solid #ddd6fe; }
  .aff-tree li:only-child::after, .aff-tree li:only-child::before { display: none; }
  .aff-tree li:only-child { padding-top: 0; }
  .aff-tree li:first-child::before, .aff-tree li:last-child::after { border: 0 none; }
  .aff-tree li:last-child::before { border-right: 1.5px solid #ddd6fe; border-radius: 0 6px 0 0; }
  .aff-tree li:first-child::after { border-radius: 6px 0 0 0; }
  .aff-tree ul ul::before {
    content: ''; position: absolute; top: 0; left: 50%; border-left: 1.5px solid #ddd6fe; width: 0; height: 28px;
  }
  .aff-node {
    display: inline-block; min-width: 120px; background: #fff; border: 1.5px solid #e9d5ff;
    border-radius: 10px; padding: 8px 12px; box-shadow: 0 1px 2px rgba(0,0,0,.04); text-decoration: none;
  }
  .aff-node:hover { border-color: #a855f7; box-shadow: 0 2px 8px rgba(168,85,247,.15); }
  .aff-node-root { background: #4c1d95; border-color: #4c1d95; }
  .aff-node-root span { color: #fff !important; }
  .aff-node-muted { border-color: #e2e8f0; background: #f8fafc; }
  .aff-node-muted:hover { border-color: #94a3b8; box-shadow: none; }
</style>

<p class="text-sm text-muted mb-4">Sơ đồ mạng lưới giới thiệu — bấm vào 1 thành viên để xem doanh thu, hoa hồng, khách hàng chi tiết của người đó. Hoa hồng chỉ tính tới Cấp 1-3 (viền tím); Cấp 4 trở đi (viền xám) không ăn hoa hồng nhưng vẫn hiển thị để thống kê ai đã tham gia mạng lưới.</p>

<div class="card p-6">
  <% if (!cay.length) { %>
    <p class="py-10 text-center text-muted">Chưa có ai tham gia mạng lưới giới thiệu.</p>
  <% } else { %>
    <ul class="aff-tree">
      <li>
        <div class="aff-node aff-node-root"><span class="block font-bold text-sm">WEB CHỦ</span></div>
        <ul>
          <% cay.forEach(function (node) { %>
            <%- include('../partials/aff-tree-node', { node: node }) %>
          <% }); %>
        </ul>
      </li>
    </ul>
  <% } %>
</div>
