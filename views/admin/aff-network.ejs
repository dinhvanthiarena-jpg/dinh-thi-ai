<h1 class="text-2xl font-extrabold text-ink mb-4">AFF</h1>
<%- include('../partials/aff-tabs') %>

<p class="text-sm text-muted mb-4">Danh sách phẳng mọi thành viên có tham gia mạng lưới giới thiệu (đã giới thiệu ai đó, hoặc được ai giới thiệu). Hệ thống hiện là mô hình 2 cấp (F1/F2) — chưa có sơ đồ Mindmap trực quan.</p>

<div class="card overflow-x-auto">
  <table class="w-full text-sm">
    <thead class="text-left text-muted border-b border-slate-100">
      <tr>
        <th class="px-4 py-3 font-semibold">Thành viên</th>
        <th class="px-4 py-3 font-semibold">Mã giới thiệu</th>
        <th class="px-4 py-3 font-semibold">Người giới thiệu (cấp trên)</th>
        <th class="px-4 py-3 font-semibold">Ngày tham gia</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      <% if (!users.length) { %>
        <tr><td colspan="4" class="px-4 py-10 text-center text-muted">Chưa có ai tham gia mạng lưới giới thiệu.</td></tr>
      <% } %>
      <% users.forEach(function (u) { %>
        <tr>
          <td class="px-4 py-3">
            <div class="font-semibold text-ink"><%= u.parentId ? '↳ ' : '' %><%= u.name %></div>
            <div class="text-muted text-xs"><%= u.email %></div>
          </td>
          <td class="px-4 py-3 font-mono text-xs"><%= u.refCode %></td>
          <td class="px-4 py-3 text-muted"><%= u.parentId ? (tenTheoId.get(u.parentId) || '—') : '—' %></td>
          <td class="px-4 py-3 text-muted text-xs"><%= new Date(u.createdAt).toLocaleDateString('vi-VN') %></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>
