<div class="space-y-4">
  <% messages.forEach(function(m) { %>
    <div class="card p-5 <%= m.isRead ? '' : 'border-l-4 border-l-primary-600' %>">
      <div class="flex justify-between items-start gap-4">
        <div>
          <p class="font-semibold text-ink"><%= m.name %> <span class="text-muted font-normal">&lt;<%= m.email %>&gt;</span></p>
          <p class="text-xs text-muted mt-0.5"><%= m.phone || 'Không có SĐT' %> &middot; <%= new Date(m.createdAt).toLocaleString('vi-VN') %></p>
        </div>
        <% if (!m.isRead) { %>
          <form action="/admin/messages/<%= m._id %>/read" method="POST">
            <button type="submit" class="btn-outline text-xs">Đánh dấu đã đọc</button>
          </form>
        <% } %>
      </div>
      <p class="mt-3 text-sm font-medium text-ink"><%= m.subject %></p>
      <p class="mt-1 text-sm text-muted whitespace-pre-line"><%= m.message %></p>
    </div>
  <% }); %>
  <% if (!messages.length) { %>
    <div class="card p-10 text-center text-muted">Chưa có tin nhắn liên hệ nào.</div>
  <% } %>
</div>
