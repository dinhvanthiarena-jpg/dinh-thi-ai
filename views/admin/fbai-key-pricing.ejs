<% const f = (n) => Number(n).toLocaleString('vi-VN'); %>
<div class="space-y-6 max-w-4xl">

  <div class="card p-6">
    <h2 class="font-semibold text-ink mb-1">🔑 Cấp key theo SỐ THÁNG (không cần key riêng cho từng gói)</h2>
    <p class="text-sm text-muted mb-4">
      Mọi key đều cùng dạng <code>FBAI-XXXX-XXXX-XXXX</code>; <strong>hạn dùng nằm trên máy chủ</strong> (thầy chọn số tháng lúc cấp/gia hạn),
      tool chỉ hỏi lại máy chủ và hiện "còn N ngày" — nên không phải lập trình key riêng theo tháng. 1 tháng = 30 ngày.
      Khách mua gói khởi đầu 3 tháng thì thầy cấp <strong>3 tháng</strong>.
    </p>
    <% if (capKey) { %><p class="text-sm mb-3" style="color:#16a34a;">✓ Đã cấp key <strong class="font-mono"><%= capKey %></strong> — dùng <strong><%= soThang %> tháng</strong> (<%= soThang * 30 %> ngày). Gửi key này cho khách.</p><% } %>
    <% if (giaHanKey) { %><p class="text-sm mb-3" style="color:#16a34a;">✓ Đã gia hạn <strong class="font-mono"><%= giaHanKey %></strong> thêm <strong><%= soThang %> tháng</strong>.</p><% } %>
    <% if (loi) { %><p class="text-sm mb-3" style="color:#dc2626;"><%= loi %></p><% } %>
    <form action="/admin/gia-key-sa-botai/cap-key" method="POST" class="flex flex-wrap gap-3 items-center mb-4">
      <input name="note" type="text" class="input flex-1 min-w-[220px]" placeholder="Ghi chú (tên khách, SĐT...)" />
      <select name="months" class="input" style="max-width:150px;">
        <% [1,2,3,4,5,6,9,12,24].forEach(m => { %><option value="<%= m %>" <%= m === 3 ? 'selected' : '' %>><%= m %> tháng</option><% }) %>
      </select>
      <button type="submit" class="btn-primary">Cấp key mới</button>
    </form>
    <form action="/admin/gia-key-sa-botai/gia-han" method="POST" class="flex flex-wrap gap-3 items-center">
      <input name="key" type="text" class="input flex-1 min-w-[220px]" placeholder="Key cần gia hạn: FBAI-XXXX-XXXX-XXXX" />
      <select name="months" class="input" style="max-width:150px;">
        <% [1,2,3,4,5,6,9,12,24].forEach(m => { %><option value="<%= m %>" <%= m === 1 ? 'selected' : '' %>>+<%= m %> tháng</option><% }) %>
      </select>
      <button type="submit" class="btn-outline">Gia hạn</button>
    </form>
    <p class="text-xs text-muted mt-3">Danh sách key, thu hồi, đổi thiết bị: <a href="/admin/fbai-license-keys" class="underline">Key SA-BOTAI (Desktop)</a>. Key cấp lần đầu ở trang đó mặc định <%= firstKeyDays %> ngày.</p>
  </div>

  <form action="/admin/gia-key-sa-botai" method="POST" class="space-y-6">
    <div class="card p-6">
      <h2 class="font-semibold text-ink mb-1">Bảng giá (gốc USD → tool hiển thị VNĐ)</h2>
      <p class="text-sm text-muted mb-4">
        Trong tool CHỈ hiện tiền Việt. Khách gia hạn trong tool bằng QR, tiền về là <strong>tự cấp/gia hạn key và mở lại tool</strong>.
        Web đầu tiên kèm key miễn phí (đếm theo tên miền); từ tên miền thứ 2 thu phí tạo web.
      </p>
      <% if (saved) { %><p class="text-sm mb-3" style="color:#16a34a;">✓ Đã lưu.</p><% } %>

      <div class="grid gap-4 sm:grid-cols-2 mb-4">
        <div>
          <label class="text-sm font-semibold">Tỷ giá quy đổi (đồng / 1$)</label>
          <input name="usdRate" type="text" class="input mt-1" style="max-width:160px;" value="<%= usdRate %>" />
        </div>
        <div>
          <label class="text-sm font-semibold">Web tạo mới (từ tên miền thứ 2)</label>
          <div class="flex items-center gap-2 mt-1">
            <input name="webFeeUsd" type="text" class="input" style="max-width:110px;" value="<%= cfg.webFeeUsd %>" /> <span class="text-sm text-muted">USD = <strong><%= f(toVnd(cfg.webFeeUsd)) %>đ</strong></span>
          </div>
        </div>
      </div>

      <table class="w-full text-sm">
        <thead><tr class="text-left text-muted"><th class="py-1">Tự bán trong tool</th><th>Gói</th><th>Giá (USD)</th><th>= VNĐ</th></tr></thead>
        <tbody>
          <% cfg.plans.forEach(p => { %>
            <tr>
              <td class="py-1"><input type="checkbox" name="enabled" value="<%= p.id %>" <%= p.enabled ? 'checked' : '' %> /></td>
              <td><input type="hidden" name="planId" value="<%= p.id %>" /><input type="hidden" name="months" value="<%= p.months %>" /><%= p.kind === 'first' ? 'Gói KHỞI ĐẦU (key lần đầu)' : 'Gia hạn' %> — <%= p.months %> tháng (<%= p.months * 30 %> ngày)</td>
              <td><input name="usd" type="text" class="input" style="max-width:100px;" value="<%= p.usd %>" /></td>
              <td><strong><%= f(toVnd(p.usd)) %>đ</strong></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <p class="text-xs text-muted mt-2">
        • Gói khởi đầu 199$/3 tháng: mặc định KHÔNG tự bán — khách liên hệ Zalo, thầy cấp key 3 tháng ở khung phía trên. Muốn khách tự mua bằng QR thì tích bật.<br>
        • Gói 2 tháng (49$), 3 tháng (149$), 5 tháng (129$) không có trong bảng giá chính thức nên đang TẮT.
      </p>
    </div>

    <div class="card p-6">
      <h2 class="font-semibold text-ink mb-1">Thông tin Bên A hiển thị trên Điều khoản dịch vụ</h2>
      <div class="grid gap-3 mt-3">
        <input name="ten" class="input" placeholder="Tên đơn vị / cá nhân" value="<%= cfg.legal.ten %>" />
        <input name="mst" class="input" placeholder="Mã số thuế / ĐKKD" value="<%= cfg.legal.mst %>" />
        <input name="diaChi" class="input" placeholder="Địa chỉ" value="<%= cfg.legal.diaChi %>" />
        <input name="email" class="input" placeholder="Email hỗ trợ (tuỳ chọn)" value="<%= cfg.legal.email %>" />
      </div>
      <p class="text-xs text-muted mt-2">Xem trang công khai: <a class="underline" href="/phap-ly-sa-botai/dieu-khoan" target="_blank">Điều khoản dịch vụ</a> · <a class="underline" href="/phap-ly-sa-botai/bao-mat" target="_blank">Chính sách bảo mật</a> · phiên bản hiện hành <strong><%= termsVersion %></strong>.</p>
    </div>
    <button type="submit" class="btn-primary">💾 Lưu bảng giá & thông tin</button>
  </form>

  <div class="card p-6">
    <h2 class="font-semibold text-ink mb-3">Khách thanh toán gần đây (<%= giaoDich.length %>)</h2>
    <% if (!giaoDich.length) { %><p class="text-sm text-muted">Chưa có.</p><% } else { %>
      <div class="space-y-2">
        <% giaoDich.forEach(t => { %>
          <div class="flex items-center justify-between gap-3 rounded-lg border border-primary-100 px-4 py-2 text-sm">
            <div><strong><%= t.user ? t.user.name : '(đã xoá)' %></strong> <span class="text-muted"><%= t.user ? t.user.email : '' %></span><br><span class="text-muted"><%= t.description %></span></div>
            <div class="text-right"><%= f(Math.abs(t.amount)) %>đ<br><span class="text-muted"><%= new Date(t.createdAt).toLocaleString('vi-VN') %></span></div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>

  <div class="card p-6">
    <h2 class="font-semibold text-ink mb-3">Tên miền đã dùng để tạo web (<%= webs.length %> gần nhất)</h2>
    <% if (!webs.length) { %><p class="text-sm text-muted">Chưa có.</p><% } else { %>
      <div class="space-y-1 text-sm">
        <% webs.forEach(w => { const u = userMap[w.UserId]; %>
          <div class="flex justify-between gap-3 border-b border-primary-100 py-1">
            <span><strong><%= w.domain %></strong> — <%= u ? u.name + ' (' + u.email + ')' : '#' + w.UserId %></span>
            <span class="text-muted"><%= w.feeVnd ? f(w.feeVnd) + 'đ' : (w.freeReason === 'web_dau_tien' ? 'web đầu tiên (miễn phí)' : (w.freeReason || 'miễn phí')) %> · đưa lên <%= w.deployCount %> lần</span>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>

  <div class="card p-4 text-sm">📄 Hợp đồng điện tử của khách được quản lý riêng tại <a class="underline font-semibold" href="/admin/hop-dong-sa-botai">Quản trị → Hợp đồng SA-BOTAI</a>.</div>

  <div class="card p-6">
    <h2 class="font-semibold text-ink mb-3">Nhật ký đồng ý điều khoản (<%= dongY.length %> gần nhất)</h2>
    <% if (!dongY.length) { %><p class="text-sm text-muted">Chưa có.</p><% } else { %>
      <div class="space-y-1 text-sm">
        <% dongY.forEach(d => { const u = dongYUsers[d.UserId]; %>
          <div class="flex justify-between gap-3 border-b border-primary-100 py-1">
            <span><%= u ? u.name + ' (' + u.email + ')' : '#' + d.UserId %></span>
            <span class="text-muted">v<%= d.version %> · IP <%= d.ip %> · <%= d.source %> · <%= new Date(d.acceptedAt).toLocaleString('vi-VN') %></span>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</div>
