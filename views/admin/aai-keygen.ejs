<div class="space-y-6 max-w-2xl">
  <div class="card p-6">
    <h2 class="font-semibold text-ink mb-1">Tạo mã mới</h2>
    <p class="text-sm text-muted mb-4">Mỗi lần bấm ra 1 mã <code class="font-mono">FBAI-XXXX-XXXX-XXXX</code> hợp lệ với tool A-AI-3dvietpro — chạy đúng thuật toán trong <code class="font-mono">license-core.js</code>, tạo ngay trên trình duyệt, không gửi đi đâu.</p>

    <div id="keyBox" class="rounded-lg border-2 border-dashed border-primary-200 bg-primary-50/40 px-5 py-6 text-center font-mono text-2xl font-bold tracking-wider text-ink mb-4 break-all">
      <span class="text-sm font-sans font-normal text-muted tracking-normal">Bấm "Tạo mã mới" bên dưới</span>
    </div>

    <div class="flex flex-wrap gap-3">
      <button id="genBtn" type="button" class="btn-primary">🔑 Tạo mã mới</button>
      <button id="copyBtn" type="button" class="btn-outline" disabled>Sao chép</button>
    </div>
  </div>

  <div class="card p-6">
    <h2 class="font-semibold text-ink mb-1">Kiểm tra 1 mã</h2>
    <p class="text-sm text-muted mb-4">Dán mã bất kỳ để kiểm tra còn hợp lệ không — dùng khi khách báo lỗi kích hoạt.</p>
    <input id="checkInput" type="text" class="input font-mono mb-3" placeholder="FBAI-XXXX-XXXX-XXXX" autocomplete="off" spellcheck="false" />
    <button id="checkBtn" type="button" class="btn-outline w-full mb-3">Kiểm tra</button>
    <div id="verdictOk" class="hidden badge bg-emerald-100 text-emerald-700 px-4 py-2 text-sm">✓ Mã hợp lệ.</div>
    <div id="verdictBad" class="hidden badge bg-rose-100 text-rose-700 px-4 py-2 text-sm">✕ Không hợp lệ — sai định dạng hoặc không phải mã do tool này tạo ra.</div>
  </div>

  <div class="card p-6">
    <div class="flex items-center justify-between mb-4">
      <h2 class="font-semibold text-ink">Đã tạo trên máy này</h2>
      <button id="clearHistBtn" type="button" class="btn-ghost text-xs">Xoá lịch sử</button>
    </div>
    <div id="histList"><p class="text-sm text-muted">Chưa tạo mã nào ở trình duyệt này.</p></div>
    <p class="text-xs text-muted mt-3">Lịch sử chỉ lưu trên trình duyệt này (không lưu lên server) — để tiện copy lại mã đã đưa cho khách nào đó.</p>
  </div>
</div>

<div id="toast" class="fixed left-1/2 bottom-8 -translate-x-1/2 translate-y-3 opacity-0 pointer-events-none transition-all duration-200 bg-ink text-white text-sm font-medium px-4 py-2 rounded-full"></div>

<script>
(function () {
  const SECRET = 'FBAdsManager-DinhThiAi-K3y-S3cr3t-2026';
  const ALPHABET = '23456789ABCDEFGHJKLMNPQRSTVWXYZ';
  const HIST_KEY = 'aai_keygen_history';

  async function hmacBytes(secret, msg) {
    const enc = new TextEncoder();
    const key = await crypto.subtle.importKey('raw', enc.encode(secret), { name: 'HMAC', hash: 'SHA-256' }, false, ['sign']);
    const sig = await crypto.subtle.sign('HMAC', key, enc.encode(msg));
    return new Uint8Array(sig);
  }
  function randomBodyChars(n) {
    const bytes = new Uint8Array(n);
    crypto.getRandomValues(bytes);
    let s = '';
    for (let i = 0; i < n; i++) s += ALPHABET[bytes[i] % ALPHABET.length];
    return s;
  }
  async function checksumFor(body) {
    const hash = await hmacBytes(SECRET, body);
    let s = '';
    for (let i = 0; i < 4; i++) s += ALPHABET[hash[i] % ALPHABET.length];
    return s;
  }
  async function generateKey() {
    const body = randomBodyChars(8);
    const check = await checksumFor(body);
    const full = body + check;
    return 'FBAI-' + full.slice(0, 4) + '-' + full.slice(4, 8) + '-' + full.slice(8, 12);
  }
  function normalizeKey(input) {
    return String(input || '').toUpperCase().replace(/[^A-Z0-9]/g, '');
  }
  async function validateKey(input) {
    let payload = normalizeKey(input);
    if (payload.startsWith('FBAI')) payload = payload.slice(4);
    if (payload.length !== 12) return false;
    const body = payload.slice(0, 8);
    const check = payload.slice(8, 12);
    return (await checksumFor(body)) === check;
  }

  function showToast(text) {
    const t = document.getElementById('toast');
    t.textContent = text;
    t.classList.remove('opacity-0', 'translate-y-3');
    t.classList.add('opacity-100', 'translate-y-0');
    setTimeout(() => {
      t.classList.add('opacity-0', 'translate-y-3');
      t.classList.remove('opacity-100', 'translate-y-0');
    }, 1600);
  }

  function loadHistory() {
    try { return JSON.parse(localStorage.getItem(HIST_KEY) || '[]'); } catch (e) { return []; }
  }
  function saveHistory(list) {
    try { localStorage.setItem(HIST_KEY, JSON.stringify(list.slice(0, 30))); } catch (e) {}
  }
  function renderHistory() {
    const list = loadHistory();
    const el = document.getElementById('histList');
    if (!list.length) { el.innerHTML = '<p class="text-sm text-muted">Chưa tạo mã nào ở trình duyệt này.</p>'; return; }
    el.innerHTML = '<div class="space-y-2">' + list.map((h, i) =>
      '<div class="flex items-center gap-3 bg-surface border border-primary-100 rounded-lg px-3 py-2">' +
        '<span class="font-mono text-sm font-semibold flex-1">' + h.key + '</span>' +
        '<span class="text-xs text-muted flex-shrink-0">' + new Date(h.ts).toLocaleString('vi-VN') + '</span>' +
        '<button type="button" class="btn-ghost text-xs flex-shrink-0" data-copy="' + i + '">Copy</button>' +
      '</div>'
    ).join('') + '</div>';
    el.querySelectorAll('[data-copy]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const item = list[parseInt(btn.dataset.copy, 10)];
        navigator.clipboard.writeText(item.key).then(() => showToast('Đã copy: ' + item.key));
      });
    });
  }
  renderHistory();

  let currentKey = null;
  document.getElementById('genBtn').addEventListener('click', async () => {
    const key = await generateKey();
    currentKey = key;
    document.getElementById('keyBox').textContent = key;
    document.getElementById('copyBtn').disabled = false;

    const list = loadHistory();
    list.unshift({ key, ts: Date.now() });
    saveHistory(list);
    renderHistory();
  });

  document.getElementById('copyBtn').addEventListener('click', () => {
    if (!currentKey) return;
    navigator.clipboard.writeText(currentKey).then(() => showToast('Đã copy: ' + currentKey));
  });

  document.getElementById('clearHistBtn').addEventListener('click', () => {
    saveHistory([]);
    renderHistory();
  });

  document.getElementById('checkBtn').addEventListener('click', async () => {
    const ok = await validateKey(document.getElementById('checkInput').value);
    document.getElementById('verdictOk').classList.toggle('hidden', !ok);
    document.getElementById('verdictBad').classList.toggle('hidden', ok);
  });
  document.getElementById('checkInput').addEventListener('keydown', (e) => {
    if (e.key === 'Enter') document.getElementById('checkBtn').click();
  });
})();
</script>
