<%
  const fmt = (d) => d ? new Date(d).toLocaleString('vi-VN') : '';
  const vnd = (n) => Number(n).toLocaleString('vi-VN') + 'đ';
  const choCount = regs.filter(r => r.status !== 'da-thanh-toan').length;
%>
<div class="space-y-6 max-w-6xl">
  <div class="card p-6">
    <h2 class="font-semibold text-ink mb-1">🛒 Đăng ký mua tool Sa Muse Ai</h2>
    <p class="text-sm text-muted">
      Trang khách: <a class="underline" href="/dang-ky-tool-muse" target="_blank">/dang-ky-tool-muse</a>.
      Thấy tiền về thì bấm <strong>Đã nhận tiền</strong>: hệ thống tự cấp key <%= han %> và gửi mail key + link tải cho khách (giá <%= vnd(gia) %>/năm; đơn cũ 500.000đ/30 ngày giữ nguyên).
      Đang chờ chuyển khoản: <strong><%= choCount %></strong>.
    </p>
    <% if (msg) { %>
      <div class="mt-3 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-2 text-sm text-emerald-800 break-all"><%= msg %></div>
    <% } %>
    <div class="mt-4 flex flex-wrap gap-3 text-sm">
      <span class="badge <%= telegramOk ? 'bg-emerald-100 text-emerald-800' : 'bg-rose-50 text-rose-700' %>">Telegram: <%= telegramOk ? 'đã liên kết' : 'CHƯA liên kết' %></span>
      <span class="badge <%= mailOk ? 'bg-emerald-100 text-emerald-800' : 'bg-rose-50 text-rose-700' %>">Gửi mail: <%= mailOk ? 'đã cấu hình' : 'chưa cấu hình (MUSE_MAIL_PASS)' %></span>
      <span class="badge bg-slate-100 text-slate-800">Thiết bị nhận thông báo: <span id="pushCount"><%= pushCount %></span></span>
    </div>
    <% if (maLienKet) { %>
      <div class="mt-4 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">
        <strong>Liên kết Telegram (làm 1 lần):</strong> mở Telegram, nhắn cho bot <strong>@DinhthiAi_bot</strong> đúng dòng này:
        <div class="mt-1 font-mono text-base font-bold select-all">/lienket <%= maLienKet %></div>
      </div>
    <% } %>
    <% if (vapidPublic) { %>
      <button id="btnPush" type="button" class="btn-primary mt-4">🔔 Bật thông báo trên thiết bị này (iPhone: thêm web vào Màn hình chính trước)</button>
      <span id="pushMsg" class="ml-3 text-sm text-muted"></span>
    <% } else { %>
      <p class="mt-3 text-sm text-rose-700">Chưa có khoá VAPID trên máy chủ nên chưa bật được thông báo đẩy của web (Telegram vẫn báo bình thường).</p>
    <% } %>
  </div>

  <div class="card p-6">
    <h2 class="font-semibold text-ink mb-1">🏷️ Mã ưu đãi (giá thỏa thuận)</h2>
    <p class="text-sm text-muted mb-4">
      Thỏa thuận giá với khách xong thì gửi <strong>1 mã</strong> (hoặc <strong>link riêng</strong>). Khách đăng ký trên web như thường, nhập mã vào ô "Mã ưu đãi":
      giá đơn, QR chuyển khoản, tin Telegram và mail đều theo giá của mã. Key vẫn <%= han %>. Mã sai hoặc hết lượt thì khách bị báo lỗi, không tự mua giá niêm yết.
      Mã không hiện công khai trên trang.
    </p>
    <div class="overflow-x-auto mb-5">
      <table class="w-full text-sm">
        <thead class="bg-slate-50 text-left text-muted">
          <tr><th class="p-2">Mã</th><th class="p-2">Giá</th><th class="p-2">Lượt dùng</th><th class="p-2">Trạng thái</th><th class="p-2">Link riêng (gửi khách)</th><th class="p-2">Thao tác</th></tr>
        </thead>
        <tbody>
          <% if (!maList.length) { %><tr><td class="p-3 text-muted" colspan="6">Chưa có mã nào.</td></tr><% } %>
          <% maList.forEach(function (c) { const het = c.toiDa > 0 && c.dung.length >= c.toiDa; %>
            <tr class="border-t align-top">
              <td class="p-2 font-mono font-bold select-all"><%= c.ma %><% if (c.ghiChu) { %><div class="font-sans font-normal text-xs text-muted"><%= c.ghiChu %></div><% } %></td>
              <td class="p-2 whitespace-nowrap font-semibold"><%= vnd(c.gia) %></td>
              <td class="p-2 whitespace-nowrap"><%= c.dung.length %> / <%= c.toiDa > 0 ? c.toiDa : '∞' %></td>
              <td class="p-2 whitespace-nowrap">
                <% if (c.khoa) { %><span class="badge bg-rose-50 text-rose-700">Đã khoá</span>
                <% } else if (het) { %><span class="badge bg-slate-100 text-slate-800">Hết lượt</span>
                <% } else { %><span class="badge bg-emerald-100 text-emerald-800">Đang dùng được</span><% } %>
              </td>
              <td class="p-2 text-xs break-all select-all"><%= siteUrl %>/dang-ky-tool-muse?ma=<%= c.ma %>#dk-form</td>
              <td class="p-2 whitespace-nowrap">
                <form action="/admin/dang-ky-muse/ma/<%= encodeURIComponent(c.ma) %>/khoa" method="POST" class="inline"><input type="hidden" name="khoa" value="<%= c.khoa ? '0' : '1' %>"><button class="text-xs underline" type="submit"><%= c.khoa ? 'Mở lại' : 'Khoá' %></button></form>
                ·
                <form action="/admin/dang-ky-muse/ma/<%= encodeURIComponent(c.ma) %>/xoa" method="POST" class="inline" onsubmit="return confirm('Xoá mã <%= c.ma %>? Các đơn đã dùng mã vẫn giữ nguyên giá.');"><button class="text-xs text-rose-700 underline" type="submit">Xoá</button></form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <form action="/admin/dang-ky-muse/ma/tao" method="POST" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:12px;align-items:end">
      <div><label class="label" for="mgia">Giá (đ) *</label><input class="input" id="mgia" name="gia" inputmode="numeric" placeholder="799000" required /></div>
      <div><label class="label" for="mtoida">Số lượt tối đa</label><input class="input" id="mtoida" name="toiDa" inputmode="numeric" placeholder="10 (0 = không giới hạn)" /></div>
      <div><label class="label" for="mma">Mã (bỏ trống = tự sinh)</label><input class="input" id="mma" name="ma" maxlength="40" placeholder="tự sinh, khó đoán" /></div>
      <div><label class="label" for="mghichu">Ghi chú</label><input class="input" id="mghichu" name="ghiChu" maxlength="120" placeholder="VD: khách Page" /></div>
      <div><button class="btn-primary w-full" type="submit">➕ Tạo mã</button></div>
    </form>
  </div>

  <div class="card p-0 overflow-x-auto">
    <table class="w-full text-sm">
      <thead class="bg-slate-50 text-left text-muted">
        <tr><th class="p-3">Thời gian</th><th class="p-3">Khách</th><th class="p-3">Claude / Muse</th><th class="p-3">Mã CK</th><th class="p-3">Trạng thái</th><th class="p-3">Thao tác</th></tr>
      </thead>
      <tbody>
        <% if (!regs.length) { %><tr><td class="p-4 text-muted" colspan="6">Chưa có ai đăng ký.</td></tr><% } %>
        <% regs.forEach(function (r) { %>
          <tr class="border-t align-top">
            <td class="p-3 whitespace-nowrap"><%= fmt(r.createdAt) %></td>
            <td class="p-3">
              <div class="font-semibold"><%= r.name %></div>
              <div><a class="underline" href="tel:<%= r.phone %>"><%= r.phone %></a> · <a class="underline" href="https://zalo.me/<%= r.phone %>" target="_blank" rel="noopener">Zalo</a></div>
              <div class="break-all"><%= r.email %></div>
              <% if (r.note) { %><div class="text-muted mt-1">“<%= r.note %>”</div><% } %>
            </td>
            <td class="p-3"><%= r.hasClaude || '-' %><br><%= r.hasMuse || '-' %></td>
            <td class="p-3 font-mono"><%= r.code %><br><span class="text-muted"><%= vnd(r.amount) %></span><% if (maTheoDon[r.code]) { %><br><span class="badge bg-amber-100 text-amber-800">Mã ưu đãi: <%= maTheoDon[r.code] %></span><% } %></td>
            <td class="p-3">
              <% if (r.status === 'da-thanh-toan') { %>
                <span class="badge bg-emerald-100 text-emerald-800">Đã nhận tiền</span>
                <div class="font-mono text-xs break-all mt-1"><%= r.licenseKey %></div>
                <% if (hanKey[r.licenseKey]) { const con = Math.ceil((hanKey[r.licenseKey] - Date.now()) / 86400000); %>
                  <div class="text-xs mt-1 <%= con <= 3 ? 'text-rose-700 font-semibold' : 'text-muted' %>">Hạn: <%= new Date(hanKey[r.licenseKey]).toLocaleDateString('vi-VN') %> (<%= con > 0 ? 'còn ' + con + ' ngày' : 'ĐÃ HẾT HẠN' %>)</div>
                <% } %>
                <div class="text-xs mt-1 <%= r.emailSentAt ? 'text-emerald-800' : 'text-rose-700' %>">
                  <%= r.emailSentAt ? 'Đã gửi mail ' + fmt(r.emailSentAt) : 'Chưa gửi được mail: ' + (r.emailError || '') %>
                </div>
              <% } else { %>
                <span class="badge bg-amber-100 text-amber-800">Chờ chuyển khoản</span>
              <% } %>
            </td>
            <td class="p-3">
              <form action="/admin/dang-ky-muse/<%= r.id %>/delete" method="POST" class="mb-2" onsubmit="return confirm('Xoá đăng ký này (và thu hồi key nếu đã cấp)?');"><button class="text-xs text-rose-700 underline" type="submit">🗑 Xoá</button></form>
              <% if (r.status !== 'da-thanh-toan') { %>
                <form action="/admin/dang-ky-muse/<%= r.id %>/paid" method="POST" onsubmit="return confirm('Xác nhận ĐÃ NHẬN TIỀN của <%= r.name.replace(/'/g, '') %>? Hệ thống sẽ cấp key và gửi mail ngay.');">
                  <button class="btn-primary" type="submit">✅ Đã nhận tiền – gửi key</button>
                </form>
              <% } else { %>
                <form action="/admin/dang-ky-muse/<%= r.id %>/extend" method="POST" class="mb-2" onsubmit="return confirm('Gia hạn thêm 365 ngày (1 năm) cho khách này? (chỉ bấm khi đã nhận <%= vnd(gia) %>)');"><button class="btn-primary" type="submit">🔁 Gia hạn +365 ngày (<%= vnd(gia) %>)</button></form>
                <% if (new Date(r.createdAt) < mocDoiGia) { %>
                  <form action="/admin/dang-ky-muse/<%= r.id %>/extend" method="POST" class="mb-2" onsubmit="return confirm('Đơn CŨ gói tháng: gia hạn thêm 30 ngày? (chỉ bấm khi đã nhận <%= vnd(giaCu) %>)');"><input type="hidden" name="goi" value="thang"><button class="btn-secondary" type="submit">+30 ngày (gói tháng cũ, <%= vnd(giaCu) %>)</button></form>
                <% } %>
                <form action="/admin/dang-ky-muse/<%= r.id %>/resend" method="POST"><button class="btn-secondary" type="submit">✉️ Gửi lại mail</button></form>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<% if (vapidPublic) { %>
<script>
(function () {
  var btn = document.getElementById('btnPush'), msg = document.getElementById('pushMsg');
  function b64(s) { var p = '='.repeat((4 - s.length % 4) % 4), r = atob((s + p).replace(/-/g, '+').replace(/_/g, '/')), o = new Uint8Array(r.length); for (var i = 0; i < r.length; i++) o[i] = r.charCodeAt(i); return o; }
  btn.addEventListener('click', async function () {
    try {
      if (!('serviceWorker' in navigator) || !('PushManager' in window)) { msg.textContent = 'Thiết bị/trình duyệt này chưa hỗ trợ. Trên iPhone: bấm Chia sẻ → Thêm vào Màn hình chính, rồi mở từ biểu tượng đó.'; return; }
      var perm = await Notification.requestPermission();
      if (perm !== 'granted') { msg.textContent = 'Bạn chưa cho phép thông báo.'; return; }
      var reg = await navigator.serviceWorker.register('/admin/dang-ky-muse/sw.js', { scope: '/admin/dang-ky-muse/' });
      await navigator.serviceWorker.ready;
      var sub = await reg.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: b64('<%= vapidPublic %>') });
      var j = sub.toJSON();
      var r = await fetch('/admin/dang-ky-muse/push-subscribe', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ endpoint: j.endpoint, keys: j.keys }) });
      msg.textContent = r.ok ? 'Đã bật thông báo cho thiết bị này.' : 'Lưu không được, thử lại.';
    } catch (e) { msg.textContent = 'Lỗi: ' + e.message; }
  });
})();
</script>
<% } %>
