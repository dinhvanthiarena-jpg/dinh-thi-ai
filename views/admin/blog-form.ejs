<% const isEdit = post && post._id; %>
<form action="<%= isEdit ? '/admin/blog/' + post._id : '/admin/blog' %>" method="POST" enctype="multipart/form-data" class="space-y-5 max-w-3xl">
  <div class="card p-6 space-y-5">
    <div>
      <label class="label">Tiêu đề *</label>
      <input class="input" type="text" name="title" value="<%= post.title || '' %>" required />
    </div>

    <div>
      <label class="label">Mô tả ngắn</label>
      <input class="input" type="text" name="excerpt" value="<%= post.excerpt || '' %>" />
    </div>

    <div>
      <label class="label">Chuyên mục</label>
      <select class="input" name="category">
        <% categories.forEach(function(c) { %>
          <option value="<%= c.slug %>" <%= (post.category || 'ai-cong-nghe') === c.slug ? 'selected' : '' %>><%= c.emoji %> <%= c.label %></option>
        <% }); %>
      </select>
    </div>

    <div>
      <label class="label">Nội dung *</label>
      <textarea class="input" name="content" rows="10" required><%= post.content || '' %></textarea>
    </div>

    <div>
      <label class="label">Ảnh bìa</label>
      <% if (post.coverImageUrl) { %>
        <img src="<%= post.coverImageUrl %>" class="w-40 h-24 object-cover rounded-lg mb-2" alt="" />
      <% } %>
      <input type="file" name="cover" accept=".jpg,.jpeg,.png,.webp" class="text-sm" data-compress />
    </div>

    <div>
      <label class="label">Tags (cách nhau bởi dấu phẩy)</label>
      <input class="input" type="text" name="tags" value="<%= (post.tags || []).join(', ') %>" />
    </div>

    <div>
      <label class="label">Ảnh chụp bình luận (hiện trong bài viết, làm bằng chứng phản hồi thật)</label>
      <% if ((post.commentImages || []).length) { %>
        <div class="grid grid-cols-4 gap-3 mb-3">
          <% post.commentImages.forEach(function(url) { %>
            <div class="text-center">
              <img src="<%= url %>" class="w-full h-24 object-cover rounded-lg mb-1" alt="" />
              <label class="flex items-center justify-center gap-1 text-xs text-red-600">
                <input type="checkbox" name="removeCommentImages" value="<%= url %>" />
                Xoá ảnh này
              </label>
            </div>
          <% }); %>
        </div>
      <% } %>
      <label class="label text-xs text-muted">Thêm ảnh mới (chọn được nhiều ảnh cùng lúc)</label>
      <input type="file" name="commentImages" accept=".jpg,.jpeg,.png,.webp" multiple class="text-sm" />
    </div>

    <label class="flex items-center gap-2 text-sm text-ink">
      <input type="checkbox" name="isPublished" <%= post.isPublished !== false ? 'checked' : '' %> />
      Xuất bản
    </label>
  </div>

  <button type="submit" class="btn-primary"><%= isEdit ? 'Cập nhật bài viết' : 'Đăng bài viết' %></button>
</form>

<script src="/js/image-compress.js"></script>
