<div class="space-y-4">
  <% conversations.forEach(function(c) { %>
    <a
      href="/admin/chats/<%= c.channel %>/<%= encodeURIComponent(c.sessionId) %>"
      class="card p-5 flex justify-between items-start gap-4 hover:border-primary-300 transition-colors <%= c.handedOff ? 'border-l-4 border-l-amber-500' : '' %>"
    >
      <div class="min-w-0">
        <div class="flex items-center gap-2">
          <span class="text-xs font-semibold px-2 py-0.5 rounded-full <%= c.channel === 'messenger' ? 'bg-[#E7F3FF] text-[#0084FF]' : 'bg-primary-100 text-primary-700' %>">
            <%= c.channel === 'messenger' ? 'Messenger' : 'Web' %>
          </span>
          <% if (c.handedOff) { %>
            <span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-amber-100 text-amber-700">Cần thầy trả lời</span>
          <% } %>
          <% if (c.channel === 'messenger') { %>
            <a
              href="https://www.facebook.com/messages/t/<%= c.sessionId %>"
              target="_blank"
              rel="noopener noreferrer"
              onclick="event.stopPropagation()"
              class="font-semibold text-[#0084FF] hover:underline truncate"
            ><%= c.customerName || 'Khách vãng lai' %></a>
          <% } else { %>
            <p class="font-semibold text-ink truncate"><%= c.customerName || 'Khách vãng lai' %></p>
          <% } %>
        </div>
        <p class="text-sm text-muted mt-1 truncate max-w-xl"><%= c.lastMessage %></p>
      </div>
      <div class="text-right flex-shrink-0">
        <p class="text-xs text-muted"><%= new Date(c.lastAt).toLocaleString('vi-VN') %></p>
        <p class="text-xs text-muted mt-0.5"><%= c.count %> tin nhắn</p>
      </div>
    </a>
  <% }); %>
  <% if (!conversations.length) { %>
    <div class="card p-10 text-center text-muted">Chưa có hội thoại chat AI nào.</div>
  <% } %>
</div>
