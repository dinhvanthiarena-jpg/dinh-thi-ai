<li>
  <a href="/admin/aff/thanh-vien/<%= node.id %>" class="aff-node <%= node.cap > 3 ? 'aff-node-muted' : '' %>">
    <span class="block font-semibold text-ink text-sm truncate"><%= node.name %></span>
    <span class="block text-[11px] text-muted font-mono"><%= node.refCode %></span>
    <span class="block text-[10px] text-muted mt-0.5">Cấp <%= node.cap %></span>
  </a>
  <% if (node.children && node.children.length) { %>
    <ul>
      <% node.children.forEach(function (con) { %>
        <%- include('aff-tree-node', { node: con }) %>
      <% }); %>
    </ul>
  <% } %>
</li>
