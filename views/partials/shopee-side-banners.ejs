<%
  const sidePicks = typeof shopeePicks !== 'undefined' && shopeePicks.length ? shopeePicks : [];
  const leftPicks = sidePicks.slice(0, 3);
  const rightPicks = sidePicks.slice(3, 6);
  function sideBannerUrl(p) {
    return '/go/shopee?url=' + encodeURIComponent(p.url) + '&name=' + encodeURIComponent(p.name);
  }
  function renderSideRail(id, side, picks) {
%>
<% if (picks.length) { %>
<div id="<%= id %>" class="hidden 2xl:block fixed <%= side === 'left' ? 'left-3' : 'right-3' %> top-1/2 -translate-y-1/2 z-30 w-[132px]">
  <div class="relative rounded-2xl bg-white shadow-lg border border-orange-100 overflow-hidden">
    <button type="button" onclick="document.getElementById('<%= id %>').style.display='none'" aria-label="Đóng" class="absolute top-1 right-1 z-10 h-5 w-5 rounded-full bg-black/40 text-white text-xs leading-5 text-center hover:bg-black/60">&times;</button>
    <div class="bg-orange-500 text-white text-[11px] font-bold text-center py-1.5">Ưu đãi Shopee</div>
    <div class="divide-y divide-orange-50">
      <% picks.forEach(function(p) { %>
        <a href="<%= sideBannerUrl(p) %>" class="flex gap-1.5 p-1.5 hover:bg-orange-50 transition-colors" referrerpolicy="no-referrer">
          <img src="<%= p.image %>" alt="<%= p.name %>" referrerpolicy="no-referrer" class="h-11 w-11 flex-shrink-0 rounded-lg object-cover" loading="lazy" />
          <div class="min-w-0">
            <p class="text-[10px] text-ink leading-tight line-clamp-2"><%= p.name %></p>
            <p class="text-[10.5px] font-bold text-orange-600 mt-0.5"><%= p.price %></p>
          </div>
        </a>
      <% }); %>
    </div>
    <a href="/uu-dai" class="block text-center text-[11px] font-semibold text-white bg-orange-500 py-1.5 hover:bg-orange-600">Xem tất cả</a>
  </div>
</div>
<% } %>
<%
  }
  renderSideRail('shopee-side-left', 'left', leftPicks);
  renderSideRail('shopee-side-right', 'right', rightPicks);
%>
