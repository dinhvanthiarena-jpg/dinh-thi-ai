<header class="sticky top-0 z-40 bg-white/90 backdrop-blur border-b border-primary-100">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between">
      <a href="/" class="flex items-center gap-2 group">
        <img src="/images/logo.jpg" alt="Vietpro" class="h-9 w-9 rounded-xl object-cover" />
        <span class="text-lg font-bold text-ink group-hover:text-primary-700 transition-colors">Vietpro</span>
      </a>

      <nav class="hidden md:flex items-center gap-0.5 lg:gap-1">
        <a href="/courses" class="px-2 py-1.5 rounded-lg text-xs lg:text-sm font-medium whitespace-nowrap <%= currentPath && currentPath.startsWith('/courses') ? 'text-primary-700 bg-primary-50' : 'text-ink hover:text-primary-700 hover:bg-primary-50' %>">Khóa học</a>
        <a href="/blog" class="px-2 py-1.5 rounded-lg text-xs lg:text-sm font-medium whitespace-nowrap <%= currentPath && currentPath.startsWith('/blog') ? 'text-primary-700 bg-primary-50' : 'text-ink hover:text-primary-700 hover:bg-primary-50' %>">Kiến thức &amp; Tin tức</a>
        <a href="/kho-tai-nguyen" class="px-2 py-1.5 rounded-lg text-xs lg:text-sm font-medium whitespace-nowrap <%= currentPath && currentPath.startsWith('/kho-tai-nguyen') ? 'text-primary-700 bg-primary-50' : 'text-ink hover:text-primary-700 hover:bg-primary-50' %>">Tool &amp; Game</a>
        <a href="/shop/" class="px-2 py-1.5 rounded-lg text-xs lg:text-sm font-medium whitespace-nowrap <%= currentPath && currentPath.startsWith('/shop') ? 'text-primary-700 bg-primary-50' : 'text-ink hover:text-primary-700 hover:bg-primary-50' %>">Shop</a>
        <a href="/uu-dai" class="px-2 py-1.5 rounded-lg text-xs lg:text-sm font-medium whitespace-nowrap <%= currentPath === '/uu-dai' ? 'text-primary-700 bg-primary-50' : 'text-ink hover:text-primary-700 hover:bg-primary-50' %>">Ưu đãi</a>
        <a href="/kiem-tien-affiliate" class="relative flex items-center gap-1 px-2 py-1.5 rounded-lg text-xs lg:text-sm font-semibold whitespace-nowrap <%= currentPath === '/kiem-tien-affiliate' ? 'text-orange-700 bg-orange-50' : 'text-orange-600 hover:text-orange-700 hover:bg-orange-50' %>">
          Kiếm Tiền Affiliate
          <span class="relative flex h-1.5 w-1.5 lg:h-2 lg:w-2">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-orange-400 opacity-75"></span>
            <span class="relative inline-flex h-1.5 w-1.5 lg:h-2 lg:w-2 rounded-full bg-orange-500"></span>
          </span>
        </a>
        <a href="/dang-ky-hoc-mien-phi" class="relative flex items-center gap-1 px-2 py-1.5 rounded-lg text-xs lg:text-sm font-semibold whitespace-nowrap <%= currentPath === '/dang-ky-hoc-mien-phi' ? 'text-white bg-primary-700' : 'text-white bg-primary-600 hover:bg-primary-700' %>">
          🎓 Đăng ký học miễn phí
        </a>

        <div class="relative group">
          <button type="button" class="flex items-center gap-1 px-2 py-1.5 rounded-lg text-xs lg:text-sm font-medium text-ink hover:text-primary-700 hover:bg-primary-50">
            Thêm
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
          </button>
          <div class="invisible opacity-0 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100 transition-opacity absolute right-0 top-full pt-1 w-44">
            <div class="rounded-xl border border-primary-100 bg-white shadow-lg py-1">
              <a href="/gioi-thieu" class="block px-4 py-2 text-sm text-ink hover:bg-primary-50 hover:text-primary-700">Giới thiệu</a>
              <a href="/hoat-dong" class="block px-4 py-2 text-sm <%= currentPath === '/hoat-dong' ? 'text-primary-700 bg-primary-50' : 'text-ink hover:bg-primary-50 hover:text-primary-700' %>">Hoạt động</a>
              <a href="/lien-he" class="block px-4 py-2 text-sm text-ink hover:bg-primary-50 hover:text-primary-700">Liên hệ</a>
            </div>
          </div>
        </div>
      </nav>

      <div class="hidden md:flex items-center gap-1.5 lg:gap-2 text-xs lg:text-sm [&_a]:px-2.5 [&_a]:py-1.5 [&_button]:px-2.5 [&_button]:py-1.5 [&_a]:whitespace-nowrap">
        <% if (typeof currentUser !== 'undefined' && currentUser) { %>
          <% if (currentUser.role === 'admin') { %>
            <a href="/admin" class="btn-ghost">Quản trị</a>
          <% } %>
          <a href="/dashboard" class="btn-ghost">Khu vực học tập</a>
          <form action="/auth/logout" method="POST">
            <button type="submit" class="btn-outline">Đăng xuất</button>
          </form>
        <% } else { %>
          <a href="/auth/login" class="btn-ghost">Đăng nhập</a>
          <a href="/auth/register" class="btn-primary">Đăng ký miễn phí</a>
        <% } %>
      </div>

      <button id="mobile-menu-btn" type="button" class="md:hidden inline-flex items-center justify-center rounded-lg p-2 text-ink hover:bg-primary-50 cursor-pointer" aria-label="Mở menu" aria-expanded="false" aria-controls="mobile-menu">
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden md:hidden border-t border-primary-100 bg-white">
    <div class="space-y-1 px-4 py-3">
      <a href="/courses" class="block px-3 py-2 rounded-lg text-sm font-medium text-ink hover:bg-primary-50">Khóa học</a>
      <a href="/blog" class="block px-3 py-2 rounded-lg text-sm font-medium text-ink hover:bg-primary-50">Kiến thức &amp; Tin tức</a>
      <a href="/kho-tai-nguyen" class="block px-3 py-2 rounded-lg text-sm font-medium text-ink hover:bg-primary-50">Tool &amp; Game</a>
      <a href="/shop/" class="block px-3 py-2 rounded-lg text-sm font-medium text-ink hover:bg-primary-50">Shop</a>
      <a href="/uu-dai" class="block px-3 py-2 rounded-lg text-sm font-medium text-ink hover:bg-primary-50">Ưu đãi</a>
      <a href="/kiem-tien-affiliate" class="flex items-center gap-1.5 px-3 py-2 rounded-lg text-sm font-semibold text-orange-600 hover:bg-orange-50">
        Kiếm Tiền Affiliate
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-orange-400 opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-orange-500"></span>
        </span>
      </a>
      <a href="/dang-ky-hoc-mien-phi" class="block px-3 py-2 rounded-lg text-sm font-semibold text-orange-600 hover:bg-orange-50">🎓 Đăng ký học miễn phí</a>
      <a href="/gioi-thieu" class="block px-3 py-2 rounded-lg text-sm font-medium text-ink hover:bg-primary-50">Giới thiệu</a>
      <a href="/hoat-dong" class="block px-3 py-2 rounded-lg text-sm font-medium text-ink hover:bg-primary-50">Hoạt động</a>
      <a href="/lien-he" class="block px-3 py-2 rounded-lg text-sm font-medium text-ink hover:bg-primary-50">Liên hệ</a>
      <div class="pt-2 border-t border-primary-100 mt-2 flex flex-col gap-2">
        <% if (typeof currentUser !== 'undefined' && currentUser) { %>
          <% if (currentUser.role === 'admin') { %>
            <a href="/admin" class="btn-ghost w-full">Quản trị</a>
          <% } %>
          <a href="/dashboard" class="btn-ghost w-full">Khu vực học tập</a>
          <form action="/auth/logout" method="POST">
            <button type="submit" class="btn-outline w-full">Đăng xuất</button>
          </form>
        <% } else { %>
          <a href="/auth/login" class="btn-ghost w-full">Đăng nhập</a>
          <a href="/auth/register" class="btn-primary w-full">Đăng ký miễn phí</a>
        <% } %>
      </div>
    </div>
  </div>
</header>
