<section class="bg-gradient-to-br from-primary-50 to-white border-b border-primary-100">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-ink">
      <%= activeCategory ? activeCategory.emoji + ' ' + activeCategory.label : 'Tin tức tổng hợp' %>
    </h1>
    <p class="mt-2 text-muted">
      <%= activeCategory ? 'Bài viết chuyên mục ' + activeCategory.label : 'Cập nhật kiến thức AI, tin hot, xu hướng và nhiều chủ đề khác' %>
    </p>
  </div>
</section>

<section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12">
  <% if (posts.length) { %>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <% posts.forEach(function(post) { %>
        <% const postCat = categories.find(function(c) { return c.slug === post.category; }); %>
        <a href="/blog/<%= post.slug %>" class="card overflow-hidden group flex flex-col">
          <div class="aspect-video bg-primary-50 overflow-hidden relative">
            <img src="<%= post.coverImageUrl %>" alt="<%= post.title %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" onerror="this.onerror=null;this.src='/images/blog/cat-<%= post.category %>.svg'" />
            <% if (postCat) { %>
              <span class="absolute top-2 left-2 px-2 py-1 rounded-full text-[10px] font-bold uppercase tracking-wide bg-white/90 text-ink shadow"><%= postCat.emoji %> <%= postCat.label %></span>
            <% } %>
          </div>
          <div class="p-5 flex flex-col flex-1">
            <h3 class="font-semibold text-ink line-clamp-2 group-hover:text-primary-700"><%= post.title %></h3>
            <p class="text-sm text-muted mt-2 line-clamp-3 flex-1"><%= post.excerpt %></p>
            <p class="text-xs text-muted mt-4"><%= new Date(post.publishedAt).toLocaleDateString('vi-VN') %></p>
          </div>
        </a>
      <% }); %>
    </div>

    <% if (totalPages > 1) { %>
      <div class="flex justify-center gap-2 mt-10">
        <% for (let p = 1; p <= totalPages; p++) { %>
          <a href="/blog?page=<%= p %><%= activeCategory ? '&category=' + activeCategory.slug : '' %>" class="px-4 py-2 rounded-lg text-sm font-medium <%= p === page ? 'bg-primary-600 text-white' : 'bg-white border border-primary-200 text-ink hover:bg-primary-50' %>"><%= p %></a>
        <% } %>
      </div>
    <% } %>
  <% } else { %>
    <div class="card p-12 text-center text-muted">Chưa có bài viết nào.</div>
  <% } %>

  <%- include('../partials/shopee-picks') %>
</section>
