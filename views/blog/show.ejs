<article class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-16">
  <span class="badge bg-primary-100 text-primary-700 mb-4"><%= new Date(post.publishedAt).toLocaleDateString('vi-VN') %></span>
  <h1 id="postTitle" class="text-3xl sm:text-4xl font-extrabold text-ink leading-tight"><%= post.title %></h1>
  <p class="mt-4 text-sm text-muted">Tác giả: <%= post.author ? post.author.name : 'Đinh Thi Ai' %> &middot; <%= post.viewCount %> lượt xem</p>

  <div id="ttsControls" class="mt-4 flex items-center gap-2">
    <button type="button" id="ttsPlayBtn" onclick="toggleTTS()" class="inline-flex items-center gap-2 rounded-full border border-primary-200 bg-primary-50 text-primary-700 px-4 py-2 text-sm font-semibold hover:bg-primary-100 transition-colors">
      <svg id="ttsIconPlay" class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20"><path d="M8 5.14v9.72a1 1 0 0 0 1.5.86l7.5-4.86a1 1 0 0 0 0-1.72l-7.5-4.86A1 1 0 0 0 8 5.14Z"/></svg>
      <svg id="ttsIconPause" class="h-4 w-4 hidden" fill="currentColor" viewBox="0 0 20 20"><path d="M6 4h3v12H6V4Zm5 0h3v12h-3V4Z"/></svg>
      <span id="ttsLabel">Nghe bài viết</span>
    </button>
    <button type="button" id="ttsStopBtn" onclick="stopTTS()" class="hidden inline-flex items-center justify-center rounded-full border border-primary-200 text-primary-500 hover:bg-primary-50 h-9 w-9" aria-label="Dừng đọc">
      <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20"><rect x="5" y="5" width="10" height="10" rx="1.5"/></svg>
    </button>
  </div>

  <img src="<%= post.coverImageUrl %>" alt="<%= post.title %>" class="w-full rounded-2xl mt-8 aspect-video object-cover" onerror="this.onerror=null;this.src='/images/blog/cat-<%= post.category %>' + ['','-b','-c'][Math.floor(Math.random()*3)] + '.svg'" />

  <div id="postContent" class="prose prose-slate max-w-none mt-8 text-ink leading-relaxed">
    <%- post.content %>
  </div>

  <% if (post.tags && post.tags.length) { %>
    <div class="flex flex-wrap gap-2 mt-8">
      <% post.tags.forEach(function(tag) { %>
        <span class="badge bg-primary-50 text-primary-700">#<%= tag %></span>
      <% }); %>
    </div>
  <% } %>

  <div class="mt-10 rounded-2xl bg-gradient-to-r from-primary-600 to-accent-600 p-6 sm:p-8 text-white flex flex-col sm:flex-row items-center gap-6 justify-between">
    <div>
      <p class="text-xs font-bold uppercase tracking-wide text-white/80">Miễn phí</p>
      <h3 class="text-xl sm:text-2xl font-bold mt-1">Tải app &amp; game do Vietpro xây dựng</h3>
      <p class="mt-2 text-white/90 max-w-xl">Kho công cụ, ứng dụng và game thực chiến — tải về dùng ngay, miễn phí 100%.</p>
    </div>
    <a
      href="/kho-tai-nguyen"
      class="shrink-0 inline-flex items-center gap-2 rounded-xl bg-white text-primary-700 font-bold px-6 py-3.5 shadow-lg hover:shadow-xl hover:scale-[1.03] transition-all duration-200"
    >
      <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path d="M10 12.5a1 1 0 0 1-.7-.29l-4-4a1 1 0 1 1 1.4-1.42L9 9.09V2a1 1 0 1 1 2 0v7.09l2.3-2.3a1 1 0 1 1 1.4 1.42l-4 4a1 1 0 0 1-.7.29Z"/><path d="M4 13a1 1 0 0 1 1 1v2h10v-2a1 1 0 1 1 2 0v3a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-3a1 1 0 0 1 1-1Z"/></svg>
      Xem Tool &amp; Game
    </a>
  </div>

  <% if (post.commentImages && post.commentImages.length) { %>
    <div class="mt-10">
      <h3 class="text-lg font-bold text-ink mb-4">Phản hồi thực tế từ học viên</h3>
      <div class="grid sm:grid-cols-2 gap-4">
        <% post.commentImages.forEach(function(url) { %>
          <img src="<%= url %>" alt="Ảnh chụp bình luận học viên" class="w-full rounded-xl border border-primary-100" loading="lazy" />
        <% }); %>
      </div>
    </div>
  <% } %>

  <div class="mt-10">
    <h3 class="text-lg font-bold text-ink mb-4">Bình luận</h3>
    <div class="fb-comments" data-href="<%= appUrl %>/blog/<%= post.slug %>" data-width="100%" data-numposts="10" data-order-by="social"></div>
  </div>

  <%- include('../partials/shopee-picks') %>
</article>

<script>
(function () {
  var synth = window.speechSynthesis;
  var controls = document.getElementById('ttsControls');
  if (!synth) {
    if (controls) controls.style.display = 'none';
    return;
  }

  var playBtn = document.getElementById('ttsPlayBtn');
  var stopBtn = document.getElementById('ttsStopBtn');
  var iconPlay = document.getElementById('ttsIconPlay');
  var iconPause = document.getElementById('ttsIconPause');
  var label = document.getElementById('ttsLabel');

  var queue = [];
  var queueIndex = 0;
  var isPaused = false;
  var keepAliveTimer = null;

  function pickVoice() {
    var voices = synth.getVoices();
    return voices.find(function (v) { return v.lang === 'vi-VN'; })
      || voices.find(function (v) { return v.lang && v.lang.indexOf('vi') === 0; })
      || null;
  }

  // Cắt bài viết thành từng câu — utterance quá dài dễ dính lỗi Chrome tự
  // ngắt giọng đọc giữa chừng khi tab không ở foreground.
  function buildQueue() {
    var titleEl = document.getElementById('postTitle');
    var contentEl = document.getElementById('postContent');
    var text = (titleEl ? titleEl.innerText + '. ' : '') + (contentEl ? contentEl.innerText : '');
    text = text.replace(/\s+/g, ' ').trim();
    return text.match(/[^.!?…]+[.!?…]*/g) || [text];
  }

  function setState(state) {
    if (state === 'playing') {
      iconPlay.classList.add('hidden');
      iconPause.classList.remove('hidden');
      label.textContent = 'Tạm dừng';
      stopBtn.classList.remove('hidden');
    } else if (state === 'paused') {
      iconPlay.classList.remove('hidden');
      iconPause.classList.add('hidden');
      label.textContent = 'Tiếp tục nghe';
      stopBtn.classList.remove('hidden');
    } else {
      iconPlay.classList.remove('hidden');
      iconPause.classList.add('hidden');
      label.textContent = 'Nghe bài viết';
      stopBtn.classList.add('hidden');
      clearInterval(keepAliveTimer);
    }
  }

  function speakNext() {
    if (queueIndex >= queue.length) {
      setState('idle');
      return;
    }
    var utter = new SpeechSynthesisUtterance(queue[queueIndex]);
    utter.lang = 'vi-VN';
    var voice = pickVoice();
    if (voice) utter.voice = voice;
    utter.onend = function () {
      queueIndex += 1;
      speakNext();
    };
    utter.onerror = function () { setState('idle'); };
    synth.speak(utter);
  }

  window.toggleTTS = function () {
    if (synth.speaking && !isPaused) {
      synth.pause();
      isPaused = true;
      setState('paused');
      return;
    }
    if (isPaused) {
      synth.resume();
      isPaused = false;
      setState('playing');
      return;
    }
    queue = buildQueue();
    queueIndex = 0;
    synth.cancel();
    speakNext();
    isPaused = false;
    setState('playing');

    // Chrome tự ngắt speechSynthesis nếu không có tác động gì sau ~15s —
    // "đánh thức" định kỳ để bài đọc không bị treo giữa chừng.
    clearInterval(keepAliveTimer);
    keepAliveTimer = setInterval(function () {
      if (synth.speaking && !synth.paused) {
        synth.pause();
        synth.resume();
      }
    }, 10000);
  };

  window.stopTTS = function () {
    synth.cancel();
    isPaused = false;
    setState('idle');
  };

  window.addEventListener('beforeunload', function () {
    synth.cancel();
  });
})();
</script>

<% if (relatedPosts.length) { %>
<section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pb-16">
  <h2 class="text-xl font-bold text-ink mb-6">Bài viết liên quan</h2>
  <div class="grid sm:grid-cols-3 gap-6">
    <% relatedPosts.forEach(function(p) { %>
      <a href="/blog/<%= p.slug %>" class="card overflow-hidden group">
        <div class="aspect-video bg-primary-50 overflow-hidden">
          <img src="<%= p.coverImageUrl %>" alt="<%= p.title %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
        </div>
        <div class="p-4">
          <h3 class="font-semibold text-sm text-ink line-clamp-2 group-hover:text-primary-700"><%= p.title %></h3>
        </div>
      </a>
    <% }); %>
  </div>
</section>
<% } %>
