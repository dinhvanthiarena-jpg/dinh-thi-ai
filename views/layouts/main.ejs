<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title + ' | ' + appName : appName %></title>
  <% const metaDesc = typeof description !== 'undefined' && description ? description : 'Đinh Thi Ai - Nền tảng đào tạo AI, đào tạo ứng dụng AI cho người đi làm, từ chuyên gia thực chiến.'; %>
  <% const rawImage = typeof ogImage !== 'undefined' && ogImage ? ogImage : '/images/og-cover.png'; %>
  <% const metaImage = /^https?:\/\//.test(rawImage) ? rawImage : `${appUrl}${rawImage}`; %>
  <% const pageUrl = typeof canonicalUrl !== 'undefined' ? canonicalUrl : ''; %>
  <meta name="description" content="<%= metaDesc %>" />
  <% if (pageUrl) { %><link rel="canonical" href="<%= pageUrl %>" /><% } %>

  <meta property="og:site_name" content="Đinh Thi Ai" />
  <meta property="og:type" content="<%= typeof ogType !== 'undefined' ? ogType : 'website' %>" />
  <meta property="og:title" content="<%= typeof title !== 'undefined' ? title : appName %>" />
  <meta property="og:description" content="<%= metaDesc %>" />
  <meta property="og:image" content="<%= metaImage %>" />
  <% if (pageUrl) { %><meta property="og:url" content="<%= pageUrl %>" /><% } %>
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="<%= typeof title !== 'undefined' ? title : appName %>" />
  <meta name="twitter:description" content="<%= metaDesc %>" />
  <meta name="twitter:image" content="<%= metaImage %>" />

  <link rel="icon" href="/images/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
  <link rel="stylesheet" href="/css/output.css" />

  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4780520729439921"
     crossorigin="anonymous"></script>

  <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM-readable site summary" />

  <script type="application/ld+json">
  <%- JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebSite",
        "@id": `${appUrl}/#website`,
        "url": appUrl,
        "name": "Đinh Thi Ai",
        "description": "Nền tảng đào tạo AI, đào tạo ứng dụng AI cho người đi làm và doanh nghiệp tại Việt Nam.",
        "inLanguage": "vi-VN",
        "publisher": { "@id": `${appUrl}/#organization` },
        "potentialAction": {
          "@type": "SearchAction",
          "target": { "@type": "EntryPoint", "urlTemplate": `${appUrl}/courses?q={search_term_string}` },
          "query-input": "required name=search_term_string"
        }
      },
      {
        "@type": "EducationalOrganization",
        "@id": `${appUrl}/#organization`,
        "name": "Đinh Thi Ai",
        "url": appUrl,
        "logo": `${appUrl}/images/favicon.svg`,
        "description": "Nền tảng đào tạo AI, đào tạo ứng dụng AI cho người đi làm và doanh nghiệp tại Việt Nam.",
        "founder": { "@id": `${appUrl}/#person-dinhthiai` },
        "areaServed": { "@type": "Country", "name": "Việt Nam" },
        "audience": [
          { "@type": "Audience", "audienceType": "Người đi làm" },
          { "@type": "Audience", "audienceType": "Doanh nghiệp" },
          { "@type": "Audience", "audienceType": "Giảng viên" },
          { "@type": "Audience", "audienceType": "Giáo viên" },
          { "@type": "Audience", "audienceType": "Công chức" },
          { "@type": "Audience", "audienceType": "Lãnh đạo" }
        ],
        "sameAs": ["https://www.facebook.com/dinhthi.daotao", "https://www.youtube.com/@dinhvanthi"],
        "contactPoint": {
          "@type": "ContactPoint",
          "telephone": "+84-977-317-988",
          "email": "dinhvanthi.arena@gmail.com",
          "contactType": "customer service",
          "areaServed": "VN",
          "availableLanguage": ["Vietnamese"]
        }
      },
      {
        "@type": "Person",
        "@id": `${appUrl}/#person-dinhthiai`,
        "name": "Đinh Thi Ai",
        "url": `${appUrl}/gioi-thieu`,
        "jobTitle": "Chuyên gia đào tạo AI và đào tạo ứng dụng AI",
        "description": "Đinh Thi Ai là chuyên gia đào tạo AI và đào tạo ứng dụng AI tại Việt Nam, đã đào tạo hơn 5.000 học viên với hơn 30 khóa học về Prompt Engineering, Generative AI và triển khai AI cho doanh nghiệp.",
        "worksFor": { "@id": `${appUrl}/#organization` },
        "knowsAbout": ["Đào tạo AI", "Đào tạo ứng dụng AI", "Đào tạo AI cho doanh nghiệp", "Đào tạo AI cho giảng viên", "Đào tạo AI cho giáo viên", "Đào tạo AI cho công chức", "Đào tạo AI cho lãnh đạo", "Đào tạo chuyển đổi số bằng AI", "Tư vấn triển khai AI", "Đào tạo kỹ năng ứng dụng AI", "Khóa học AI thực chiến", "Trí tuệ nhân tạo", "Prompt Engineering", "Generative AI", "AI cho doanh nghiệp", "Tự động hóa công việc bằng AI"],
        "sameAs": ["https://www.facebook.com/dinhthi.daotao", "https://www.youtube.com/@dinhvanthi"]
      }
    ]
  }) %>
  </script>
  <% if (typeof structuredData !== 'undefined' && structuredData) { %>
  <script type="application/ld+json"><%- JSON.stringify(structuredData) %></script>
  <% } %>
</head>
<body class="min-h-screen flex flex-col">
  <%- include('../partials/header') %>

  <main class="flex-1">
    <%- include('../partials/flash') %>
    <%- body %>
  </main>

  <%- include('../partials/footer') %>
  <%- include('../partials/floating-contact') %>
  <%- include('../partials/shopee-floating') %>
  <%- include('../partials/chatbot-widget') %>

  <script src="/js/main.js" defer></script>
  <script src="/js/chatbot.js" defer></script>
  <%- include('../partials/facebook-chat') %>
</body>
</html>
