<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> | Quản trị Đinh Thi Ai</title>
  <link rel="icon" href="/images/favicon.svg" type="image/svg+xml" />
  <link rel="stylesheet" href="/css/output.css" />
</head>
<body class="min-h-screen bg-surface">
  <div class="flex min-h-screen">
    <aside class="hidden lg:flex w-64 flex-col bg-ink text-white flex-shrink-0">
      <div class="h-16 flex items-center gap-2 px-6 border-b border-white/10">
        <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-gradient-to-br from-primary-500 to-accent-500 text-white font-bold text-sm">AI</span>
        <span class="font-bold">Đinh Thi Ai</span>
      </div>
      <nav class="flex-1 px-3 py-6 space-y-1 text-sm">
        <a href="/admin" class="flex items-center gap-3 px-3 py-2.5 rounded-lg <%= currentPath === '/admin' ? 'bg-white/10 text-white' : 'text-indigo-200 hover:bg-white/5' %>">Tổng quan</a>
        <a href="/admin/analytics" class="flex items-center gap-3 px-3 py-2.5 rounded-lg <%= currentPath && currentPath.startsWith('/admin/analytics') ? 'bg-white/10 text-white' : 'text-indigo-200 hover:bg-white/5' %>">Thống kê</a>
        <a href="/admin/courses" class="flex items-center gap-3 px-3 py-2.5 rounded-lg <%= currentPath && currentPath.startsWith('/admin/courses') ? 'bg-white/10 text-white' : 'text-indigo-200 hover:bg-white/5' %>">Khóa học</a>
        <a href="/admin/blog" class="flex items-center gap-3 px-3 py-2.5 rounded-lg <%= currentPath && currentPath.startsWith('/admin/blog') ? 'bg-white/10 text-white' : 'text-indigo-200 hover:bg-white/5' %>">Bài viết</a>
        <a href="/admin/gallery" class="flex items-center gap-3 px-3 py-2.5 rounded-lg <%= currentPath && currentPath.startsWith('/admin/gallery') ? 'bg-white/10 text-white' : 'text-indigo-200 hover:bg-white/5' %>">Ảnh hoạt động</a>
        <a href="/admin/tools" class="flex items-center gap-3 px-3 py-2.5 rounded-lg <%= currentPath && currentPath.startsWith('/admin/tools') ? 'bg-white/10 text-white' : 'text-indigo-200 hover:bg-white/5' %>">Tool & Game</a>
        <a href="/admin/game-installs" class="flex items-center gap-3 px-3 py-2.5 rounded-lg <%= currentPath && currentPath.startsWith('/admin/game-installs') ? 'bg-white/10 text-white' : 'text-indigo-200 hover:bg-white/5' %>">Cài đặt Toán Vui</a>
        <a href="/admin/push-broadcast" class="flex items-center gap-3 px-3 py-2.5 rounded-lg <%= currentPath && currentPath.startsWith('/admin/push-broadcast') ? 'bg-white/10 text-white' : 'text-indigo-200 hover:bg-white/5' %>">Thông báo cập nhật</a>
        <a href="/admin/orders" class="flex items-center gap-3 px-3 py-2.5 rounded-lg <%= currentPath === '/admin/orders' ? 'bg-white/10 text-white' : 'text-indigo-200 hover:bg-white/5' %>">Đơn hàng</a>
        <a href="/admin/pro-orders" class="flex items-center gap-3 px-3 py-2.5 rounded-lg <%= currentPath === '/admin/pro-orders' ? 'bg-white/10 text-white' : 'text-indigo-200 hover:bg-white/5' %>">Gói Pro</a>
        <a href="/admin/students" class="flex items-center gap-3 px-3 py-2.5 rounded-lg <%= currentPath === '/admin/students' ? 'bg-white/10 text-white' : 'text-indigo-200 hover:bg-white/5' %>">Học viên</a>
        <a href="/admin/messages" class="flex items-center gap-3 px-3 py-2.5 rounded-lg <%= currentPath === '/admin/messages' ? 'bg-white/10 text-white' : 'text-indigo-200 hover:bg-white/5' %>">Tin nhắn</a>
        <a href="/admin/chats" class="flex items-center gap-3 px-3 py-2.5 rounded-lg <%= currentPath && currentPath.startsWith('/admin/chats') ? 'bg-white/10 text-white' : 'text-indigo-200 hover:bg-white/5' %>">Chat AI</a>
      </nav>
      <div class="p-4 border-t border-white/10 space-y-2">
        <a href="/" class="block text-sm text-indigo-200 hover:text-white">&larr; Về trang chủ</a>
        <form action="/auth/logout" method="POST">
          <button type="submit" class="text-sm text-indigo-200 hover:text-white cursor-pointer">Đăng xuất</button>
        </form>
      </div>
    </aside>

    <div class="flex-1 min-w-0">
      <header class="h-16 bg-white border-b border-primary-100 flex items-center justify-between px-4 sm:px-8">
        <h1 class="font-semibold text-ink"><%= title %></h1>
        <span class="text-sm text-muted"><%= currentUser ? currentUser.name : '' %></span>
      </header>
      <main class="p-4 sm:p-8">
        <%- include('../partials/flash') %>
        <%- body %>
      </main>
    </div>
  </div>
  <script src="/js/main.js" defer></script>
</body>
</html>
