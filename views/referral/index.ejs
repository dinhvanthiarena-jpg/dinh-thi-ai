<section class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-14">
  <a href="/dashboard" class="inline-flex items-center gap-1 text-sm text-muted hover:text-ink mb-3">&larr; Quay lại</a>
  <h1 class="text-2xl sm:text-3xl font-extrabold text-ink">Giới thiệu bạn bè</h1>
  <p class="text-sm text-muted mt-1">Chia sẻ link của bạn — bạn bè mua tool, đóng học phí hay mua gói Pro, bạn đều nhận hoa hồng vào ví.</p>

  <% if (agentStatus === 'none' || agentStatus === 'rejected') { %>
    <div class="card p-6 mt-6">
      <% if (agentStatus === 'rejected') { %>
        <p class="text-sm text-red-600 font-semibold mb-2">Đăng ký trước đó đã bị từ chối.</p>
      <% } %>
      <p class="font-semibold text-ink mb-1">Đăng ký làm đại lý</p>
      <p class="text-sm text-muted mb-4">Trở thành đại lý để nhận link giới thiệu riêng, theo dõi mạng lưới và nhận hoa hồng khi bạn bè mua hàng qua link của bạn. Admin sẽ duyệt đăng ký trước khi link hoạt động.</p>
      <form action="/gioi-thieu-ban-be/dang-ky" method="POST">
        <button class="btn-primary" type="submit">Gửi đăng ký làm đại lý</button>
      </form>
    </div>
  <% } else if (agentStatus === 'pending') { %>
    <div class="card p-6 mt-6">
      <p class="font-semibold text-ink mb-1">Đăng ký của bạn đang chờ duyệt</p>
      <p class="text-sm text-muted">Admin sẽ xem xét và duyệt sớm. Sau khi được duyệt, link giới thiệu và toàn bộ dashboard đại lý (ví, mạng lưới, hoa hồng) sẽ hiện ra ở đây.</p>
    </div>
  <% } else { %>

  <div class="grid sm:grid-cols-2 gap-4 mt-6">
    <div class="card p-6 bg-gradient-to-br from-primary-600 to-primary-700 text-white">
      <p class="text-sm text-white/80">Số dư ví hiện có</p>
      <p class="text-3xl font-extrabold mt-1"><%= soDu.toLocaleString('vi-VN') %>đ</p>
      <a href="/vi" class="text-xs text-white/80 hover:text-white underline mt-2 inline-block">Xem chi tiết ví &rarr;</a>
    </div>
    <div class="card p-6">
      <p class="text-sm text-muted">Tổng hoa hồng</p>
      <p class="text-3xl font-extrabold text-ink mt-1"><%= totalCommission.toLocaleString('vi-VN') %>đ</p>
      <% if (hoaHongChoDuyet > 0) { %>
        <p class="text-xs text-amber-600 mt-2">Trong đó <%= hoaHongChoDuyet.toLocaleString('vi-VN') %>đ đang chờ duyệt (7 ngày kể từ lúc phát sinh)</p>
      <% } %>
      <p class="text-xs text-muted mt-1"><%= f1.length %> cấp 1, <%= f2.length %> cấp 2, <%= f3.length %> cấp 3</p>
    </div>
  </div>

  <div class="card p-6 mt-6">
    <p class="label">Link giới thiệu của bạn</p>
    <div class="flex gap-2 mt-1">
      <input class="input flex-1" type="text" readonly value="<%= appUrl %>/auth/register?ref=<%= refCode %>" onclick="this.select()" />
      <button type="button" class="btn-outline shrink-0" onclick="navigator.clipboard.writeText(this.previousElementSibling.value); this.textContent='Đã chép!'">Chép link</button>
    </div>
    <div class="flex items-center gap-2 mt-3">
      <p class="text-xs text-muted">Mã giới thiệu của bạn:</p>
      <code class="text-sm font-bold text-ink bg-primary-50 rounded px-2 py-0.5"><%= refCode %></code>
      <button type="button" class="text-xs text-primary-700 font-semibold hover:underline" data-code="<%= refCode %>" onclick="navigator.clipboard.writeText(this.dataset.code); this.textContent='Đã chép!'">Chép mã</button>
    </div>
    <p class="text-xs text-muted mt-2">Gửi riêng mã này cho ai đó cũng được — họ chỉ cần gõ vào ô "Mã giới thiệu" lúc đăng ký tài khoản là tính hoa hồng cho bạn.</p>
  </div>

  <div class="card p-6 mt-6">
    <p class="font-semibold text-ink mb-1">Tạo link tracking riêng cho 1 trang cụ thể</p>
    <p class="text-xs text-muted mb-3">Ví dụ: link riêng cho 1 khóa học, dán vào bài đăng Facebook — đo được đúng bài nào ra đơn.</p>
    <form action="/gioi-thieu-ban-be/links" method="POST" class="grid sm:grid-cols-3 gap-2">
      <input class="input sm:col-span-3" type="text" name="originalUrl" placeholder="Dán nguyên link trang (VD: <%= appUrl %>/courses/ten-khoa-hoc)" required />
      <input class="input" type="text" name="utmSource" placeholder="Nguồn (vd: facebook)" />
      <input class="input sm:col-span-2" type="text" name="utmCampaign" placeholder="Chiến dịch (vd: bai-dang-thang-9)" />
      <button class="btn-outline sm:col-span-3" type="submit">Tạo link</button>
    </form>

    <% if (affiliateLinks.length) { %>
      <p class="font-semibold text-ink mt-6 mb-1">Link đã tạo — sao chép và gửi cho mạng lưới bên dưới bạn</p>
      <p class="text-xs text-muted mb-3">Ai bấm vào link này rồi tạo tài khoản/mua hàng, bạn đều nhận hoa hồng.</p>
      <div class="space-y-3">
        <% affiliateLinks.forEach(function(l) { %>
          <div class="rounded-xl border-2 border-primary-100 bg-primary-50/60 p-4">
            <div class="flex items-center justify-between gap-2 mb-2">
              <p class="text-xs text-muted"><%= l.utmSource || '—' %> <%= l.utmCampaign ? '· ' + l.utmCampaign : '' %></p>
              <span class="text-xs font-semibold text-primary-700 shrink-0"><%= l.clicksCount %> click</span>
            </div>
            <div class="flex gap-2">
              <input class="input flex-1 font-mono text-sm bg-white" type="text" readonly value="<%= appUrl %><%= l.originalUrl %>?ref=<%= l.affiliateCode %>" onclick="this.select()" />
              <button type="button" class="btn-primary shrink-0" data-link="<%= appUrl %><%= l.originalUrl %>?ref=<%= l.affiliateCode %>" onclick="navigator.clipboard.writeText(this.dataset.link); this.textContent='Đã chép!'">Chép link</button>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>

  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 mt-6">
    <div class="card overflow-hidden">
      <div class="px-5 py-4 border-b border-primary-100 font-semibold text-ink">Cấp 1 — trực tiếp (<%= f1.length %>)</div>
      <div class="divide-y divide-primary-50 max-h-72 overflow-y-auto">
        <% if (!f1.length) { %><p class="px-5 py-6 text-sm text-muted">Chưa có ai đăng ký qua link của bạn.</p><% } %>
        <% f1.forEach(function(u) { %>
          <div class="px-5 py-3 flex justify-between text-sm">
            <span class="text-ink"><%= u.name %></span>
            <span class="text-muted text-xs"><%= new Date(u.createdAt).toLocaleDateString('vi-VN') %></span>
          </div>
        <% }); %>
      </div>
    </div>
    <div class="card overflow-hidden">
      <div class="px-5 py-4 border-b border-primary-100 font-semibold text-ink">Cấp 2 (<%= f2.length %>)</div>
      <div class="divide-y divide-primary-50 max-h-72 overflow-y-auto">
        <% if (!f2.length) { %><p class="px-5 py-6 text-sm text-muted">Chưa có dữ liệu.</p><% } %>
        <% f2.forEach(function(u) { %>
          <div class="px-5 py-3 flex justify-between text-sm">
            <span class="text-ink"><%= u.name %></span>
            <span class="text-muted text-xs"><%= new Date(u.createdAt).toLocaleDateString('vi-VN') %></span>
          </div>
        <% }); %>
      </div>
    </div>
    <div class="card overflow-hidden">
      <div class="px-5 py-4 border-b border-primary-100 font-semibold text-ink">Cấp 3 (<%= f3.length %>)</div>
      <div class="divide-y divide-primary-50 max-h-72 overflow-y-auto">
        <% if (!f3.length) { %><p class="px-5 py-6 text-sm text-muted">Chưa có dữ liệu.</p><% } %>
        <% f3.forEach(function(u) { %>
          <div class="px-5 py-3 flex justify-between text-sm">
            <span class="text-ink"><%= u.name %></span>
            <span class="text-muted text-xs"><%= new Date(u.createdAt).toLocaleDateString('vi-VN') %></span>
          </div>
        <% }); %>
      </div>
    </div>
  </div>

  <div class="card p-6 mt-6">
    <p class="font-semibold text-ink mb-3">Doanh thu & hoa hồng mạng lưới của bạn</p>
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-sm">
      <div>
        <p class="text-muted text-xs">Doanh thu cấp 1</p>
        <p class="font-bold text-ink tabular-nums"><%= chiTiet.doanhThuTrucTiep.toLocaleString('vi-VN') %>đ</p>
        <p class="text-primary-700 text-xs font-semibold tabular-nums">Hoa hồng: <%= chiTiet.hoaHongTrucTiep.toLocaleString('vi-VN') %>đ</p>
      </div>
      <div>
        <p class="text-muted text-xs">Doanh thu cấp 2</p>
        <p class="font-bold text-ink tabular-nums"><%= chiTiet.doanhThuCapB.toLocaleString('vi-VN') %>đ</p>
        <p class="text-primary-700 text-xs font-semibold tabular-nums">Hoa hồng: <%= chiTiet.hoaHongCapB.toLocaleString('vi-VN') %>đ</p>
      </div>
      <div>
        <p class="text-muted text-xs">Doanh thu cấp 3</p>
        <p class="font-bold text-ink tabular-nums"><%= chiTiet.doanhThuCapC.toLocaleString('vi-VN') %>đ</p>
        <p class="text-primary-700 text-xs font-semibold tabular-nums">Hoa hồng: <%= chiTiet.hoaHongCapC.toLocaleString('vi-VN') %>đ</p>
      </div>
      <div>
        <p class="text-muted text-xs">Tổng doanh thu mạng lưới</p>
        <p class="font-bold text-primary-700 tabular-nums"><%= chiTiet.tongDoanhThuMang.toLocaleString('vi-VN') %>đ</p>
      </div>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 text-sm mt-4 pt-4 border-t border-primary-50">
      <div>
        <p class="text-muted text-xs">Hoa hồng chờ duyệt</p>
        <p class="font-bold text-amber-600 tabular-nums"><%= chiTiet.hoaHongChoDuyet.toLocaleString('vi-VN') %>đ</p>
      </div>
      <div>
        <p class="text-muted text-xs">Hoa hồng đã duyệt</p>
        <p class="font-bold text-emerald-600 tabular-nums"><%= chiTiet.hoaHongDaDuyet.toLocaleString('vi-VN') %>đ</p>
      </div>
      <div>
        <p class="text-muted text-xs">Đã rút</p>
        <p class="font-bold text-ink tabular-nums"><%= chiTiet.hoaHongDaChiTra.toLocaleString('vi-VN') %>đ</p>
      </div>
    </div>
    <p class="text-xs text-muted mt-4"><%= chiTiet.tongKhachHangTrucTiep %> khách trực tiếp · <%= chiTiet.tongDonHang %> đơn hàng trong mạng lưới</p>
  </div>

  <div class="card overflow-hidden mt-6">
    <div class="px-5 py-4 border-b border-primary-100 font-semibold text-ink">Đơn hàng của mạng lưới cấp dưới</div>
    <table class="w-full text-sm">
      <thead>
        <tr class="text-left text-muted border-b border-primary-100">
          <th class="py-2 px-5">Thời gian</th>
          <th class="py-2 px-5">Người mua</th>
          <th class="py-2 px-5">Cấp</th>
          <th class="py-2 px-5">Sản phẩm</th>
          <th class="py-2 px-5 text-right">Giá trị</th>
        </tr>
      </thead>
      <tbody>
        <% if (!donHangMang.length) { %>
          <tr><td colspan="5" class="py-8 text-center text-muted">Chưa có đơn hàng nào trong mạng lưới của bạn.</td></tr>
        <% } %>
        <% donHangMang.forEach(function(d) { %>
          <tr class="border-b border-primary-50 last:border-0">
            <td class="py-2 px-5 text-muted whitespace-nowrap"><%= new Date(d.ngay).toLocaleString('vi-VN') %></td>
            <td class="py-2 px-5 text-ink"><%= d.nguoiMua %></td>
            <td class="py-2 px-5 text-muted">Cấp <%= d.capDo %></td>
            <td class="py-2 px-5 text-ink"><%= d.sanPham %></td>
            <td class="py-2 px-5 text-right font-semibold tabular-nums"><%= d.soTien.toLocaleString('vi-VN') %>đ</td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>

  <div class="card p-6 mt-6">
    <div class="flex items-center justify-between mb-3">
      <p class="font-semibold text-ink">Rút hoa hồng về ngân hàng</p>
      <a href="/tai-khoan/thanh-toan" class="text-xs text-primary-700 hover:underline">Thiết lập thông tin nhận tiền mặc định</a>
    </div>
    <form action="/gioi-thieu-ban-be/rut-tien" method="POST" class="space-y-3">
      <div>
        <label class="label">Số tiền muốn rút (tối thiểu 50.000đ)</label>
        <input class="input" type="number" name="amount" min="50000" step="1000" required />
      </div>
      <div>
        <label class="label">Ngân hàng</label>
        <input class="input" type="text" name="bankName" value="<%= currentUser.bankName || '' %>" placeholder="VD: Vietcombank" required />
      </div>
      <div class="grid grid-cols-2 gap-2">
        <input class="input" type="text" name="bankAccount" value="<%= currentUser.bankAccount || '' %>" placeholder="Số tài khoản" required />
        <input class="input" type="text" name="bankAccountName" value="<%= currentUser.bankAccountName || '' %>" placeholder="Tên chủ tài khoản" required />
      </div>
      <button class="btn-primary w-full" type="submit">Gửi yêu cầu rút tiền</button>
    </form>

    <% if (withdrawRequests.length) { %>
      <p class="text-xs uppercase tracking-wide text-muted font-semibold mt-5 mb-2">Yêu cầu gần đây</p>
      <div class="space-y-1.5">
        <% withdrawRequests.forEach(function(w) { %>
          <div class="flex justify-between text-sm border-b border-primary-50 py-1.5">
            <span class="tabular-nums"><%= w.amount.toLocaleString('vi-VN') %>đ</span>
            <span class="badge <%= w.status === 'approved' ? 'bg-emerald-100 text-emerald-700' : w.status === 'rejected' ? 'bg-red-100 text-red-700' : 'bg-amber-100 text-amber-700' %>">
              <%= w.status === 'approved' ? 'Đã duyệt' : w.status === 'rejected' ? 'Từ chối' : 'Chờ duyệt' %>
            </span>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>

  <div class="card overflow-hidden mt-6">
    <div class="px-5 py-4 border-b border-primary-100 font-semibold text-ink">Lịch sử hoa hồng</div>
    <table class="w-full text-sm">
      <thead>
        <tr class="text-left text-muted border-b border-primary-100">
          <th class="py-2 px-5">Thời gian</th>
          <th class="py-2 px-5">Nội dung</th>
          <th class="py-2 px-5 text-right">Số tiền</th>
          <th class="py-2 px-5 text-right">Trạng thái</th>
        </tr>
      </thead>
      <tbody>
        <% if (!commissionHistory.length) { %>
          <tr><td colspan="4" class="py-8 text-center text-muted">Chưa có hoa hồng nào.</td></tr>
        <% } %>
        <% commissionHistory.forEach(function(tx) { %>
          <tr class="border-b border-primary-50 last:border-0">
            <td class="py-2 px-5 text-muted whitespace-nowrap"><%= new Date(tx.createdAt).toLocaleString('vi-VN') %></td>
            <td class="py-2 px-5 text-ink"><%= tx.description %></td>
            <td class="py-2 px-5 text-right font-semibold tabular-nums text-emerald-600">+<%= tx.amount.toLocaleString('vi-VN') %>đ</td>
            <td class="py-2 px-5 text-right">
              <span class="badge <%= tx.status === 'paid' ? 'bg-emerald-100 text-emerald-700' : 'bg-amber-100 text-amber-700' %>">
                <%= tx.status === 'paid' ? 'Khả dụng' : 'Chờ duyệt' %>
              </span>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>

  <% } %>
</section>
