<section class="bg-gradient-to-br from-primary-50 to-white border-b border-primary-100">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-14">
    <a href="/kho-tai-nguyen" class="text-sm text-primary-600 hover:underline">&larr; Tất cả tool &amp; game</a>

    <div class="mt-6 flex flex-col sm:flex-row items-start sm:items-center gap-6">
      <img src="<%= tool.coverImageUrl %>" alt="<%= tool.title %>" class="w-28 h-28 sm:w-32 sm:h-32 rounded-3xl object-cover shadow-card flex-shrink-0" />
      <div class="min-w-0">
        <span class="badge <%= tool.category === 'Game' ? 'bg-accent-500 text-white' : tool.category === 'Công cụ' ? 'bg-amber-500 text-white' : 'bg-primary-600 text-white' %>"><%= tool.category %></span>
        <h1 class="mt-3 text-2xl sm:text-4xl font-extrabold text-ink leading-tight"><%= tool.title %></h1>
        <p class="mt-2 text-muted"><%= tool.shortDescription %></p>
        <p class="mt-1 text-xs text-muted"><%= tool.downloadCount %> lượt tải</p>
      </div>
    </div>

    <% if (tool.webAppUrl && !tool.driveFileId) { %>
      <!-- Web-only tool: no desktop installer exists, so show a single wide
           "open in browser" card instead of the download + phone pair. -->
      <div class="mt-10 rounded-3xl border-2 border-accent-200 bg-white p-6 sm:p-8 shadow-card">
        <div class="flex flex-col sm:flex-row items-center gap-8">
          <div class="w-[120px] flex-shrink-0">
            <div class="rounded-2xl border-4 border-slate-800 bg-slate-800 overflow-hidden aspect-[9/16] shadow-lg relative">
              <img src="<%= tool.coverImageUrl %>" alt="<%= tool.title %> trên điện thoại" class="w-full h-full object-cover" />
              <div class="absolute top-1.5 left-1/2 -translate-x-1/2 h-1 w-8 rounded-full bg-slate-900/60"></div>
            </div>
          </div>
          <div class="min-w-0 text-center sm:text-left">
            <span class="badge bg-accent-100 text-accent-700">Điện thoại · Máy tính bảng · Máy tính</span>
            <h3 class="text-lg font-bold text-ink mt-2">Mở là dùng được ngay</h3>
            <ol class="mt-3 text-sm text-muted text-left space-y-1.5 list-decimal list-inside">
              <li>Bấm nút bên dưới, trang mở thẳng bằng trình duyệt</li>
              <li>Dùng ngay, không cần tải hay cài đặt gì</li>
              <li>Muốn dùng như app thật: mở bằng Safari (iPhone/iPad) hoặc Chrome (Android) rồi chọn "Thêm vào màn hình chính"</li>
            </ol>
            <a
              href="<%= tool.webAppUrl %>"
              target="_blank"
              rel="noopener"
              class="mt-5 inline-flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-accent-600 to-accent-700 text-white font-bold px-8 py-3.5 shadow-lg hover:shadow-xl hover:scale-[1.02] transition-all duration-200"
            >
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5M14.25 3h6.75v6.75M20.25 3.75 11.25 12.75" /></svg>
              Mở <%= tool.title %>
            </a>
          </div>
        </div>
      </div>
    <% } else if (tool.webAppUrl) { %>
      <div class="mt-10 grid sm:grid-cols-2 gap-6">
        <!-- Desktop download -->
        <div class="rounded-3xl border-2 border-primary-200 bg-white p-6 flex flex-col items-center text-center shadow-card">
          <div class="w-full max-w-[220px]">
            <div class="rounded-lg border-4 border-slate-800 bg-slate-800 overflow-hidden aspect-video shadow-lg">
              <img src="<%= tool.coverImageUrl %>" alt="<%= tool.title %> trên máy tính" class="w-full h-full object-cover" />
            </div>
            <div class="mx-auto h-2.5 w-2/3 rounded-b-xl bg-slate-700"></div>
            <div class="mx-auto h-1 w-1/3 rounded-b-lg bg-slate-600"></div>
          </div>
          <span class="badge bg-primary-100 text-primary-700 mt-5">Máy tính (Windows)</span>
          <h3 class="text-lg font-bold text-ink mt-2">Cài đặt lên máy tính</h3>
          <ol class="mt-3 text-sm text-muted text-left space-y-1.5 list-decimal list-inside">
            <li>Bấm nút tải bên dưới để tải file cài đặt (.exe)</li>
            <li>Mở file vừa tải và làm theo hướng dẫn cài đặt</li>
            <li>Mở ứng dụng từ màn hình Desktop, dùng ngay</li>
          </ol>
          <a
            href="/kho-tai-nguyen/<%= tool.slug %>/download"
            class="mt-5 w-full inline-flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-primary-600 to-primary-700 text-white font-bold px-6 py-3.5 shadow-lg hover:shadow-xl hover:scale-[1.02] transition-all duration-200"
          >
            <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path d="M10 12.5a1 1 0 0 1-.7-.29l-4-4a1 1 0 1 1 1.4-1.42L9 9.09V2a1 1 0 1 1 2 0v7.09l2.3-2.3a1 1 0 1 1 1.4 1.42l-4 4a1 1 0 0 1-.7.29Z"/><path d="M4 13a1 1 0 0 1 1 1v2h10v-2a1 1 0 1 1 2 0v3a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-3a1 1 0 0 1 1-1Z"/></svg>
            Tải cho máy tính
          </a>
        </div>

        <!-- Phone / web version -->
        <div class="rounded-3xl border-2 border-accent-200 bg-white p-6 flex flex-col items-center text-center shadow-card">
          <div class="w-[110px]">
            <div class="rounded-2xl border-4 border-slate-800 bg-slate-800 overflow-hidden aspect-[9/16] shadow-lg relative">
              <img src="<%= tool.coverImageUrl %>" alt="<%= tool.title %> trên điện thoại" class="w-full h-full object-cover" />
              <div class="absolute top-1.5 left-1/2 -translate-x-1/2 h-1 w-8 rounded-full bg-slate-900/60"></div>
            </div>
          </div>
          <span class="badge bg-accent-100 text-accent-700 mt-5">Điện thoại (iPhone / Android)</span>
          <h3 class="text-lg font-bold text-ink mt-2">Chơi ngay trên điện thoại</h3>
          <ol class="mt-3 text-sm text-muted text-left space-y-1.5 list-decimal list-inside">
            <li>Bấm nút bên dưới, trang sẽ mở bằng Safari/Chrome</li>
            <li>Chơi ngay trực tiếp trên trình duyệt, không cần cài gì thêm</li>
            <li>Muốn dùng như app thật: bấm "Cài đặt ngay vào điện thoại" trong trang</li>
          </ol>
          <a
            href="<%= tool.webAppUrl %>"
            target="_blank"
            rel="noopener"
            class="mt-5 w-full inline-flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-accent-600 to-accent-700 text-white font-bold px-6 py-3.5 shadow-lg hover:shadow-xl hover:scale-[1.02] transition-all duration-200"
          >
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 10.5V6.75a4.5 4.5 0 119 0v3.75M3.75 21.75h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H3.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" /></svg>
            Chơi trên điện thoại
          </a>
        </div>
      </div>
    <% } else { %>
      <a
        href="/kho-tai-nguyen/<%= tool.slug %>/download"
        class="mt-8 inline-flex items-center gap-3 rounded-2xl bg-gradient-to-r from-primary-600 to-accent-600 text-white text-lg sm:text-xl font-bold px-8 py-4 shadow-lg hover:shadow-xl hover:scale-[1.02] transition-all duration-200"
      >
        <svg class="h-7 w-7" viewBox="0 0 20 20" fill="currentColor"><path d="M10 12.5a1 1 0 0 1-.7-.29l-4-4a1 1 0 1 1 1.4-1.42L9 9.09V2a1 1 0 1 1 2 0v7.09l2.3-2.3a1 1 0 1 1 1.4 1.42l-4 4a1 1 0 0 1-.7.29Z"/><path d="M4 13a1 1 0 0 1 1 1v2h10v-2a1 1 0 1 1 2 0v3a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-3a1 1 0 0 1 1-1Z"/></svg>
        Tải <%= tool.title %> miễn phí
      </a>
    <% } %>
  </div>
</section>

<% if (tool.description) { %>
  <section class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-12">
    <h2 class="text-xl font-bold text-ink mb-4">Giới thiệu</h2>
    <div class="prose prose-slate max-w-none text-ink leading-relaxed whitespace-pre-line"><%= tool.description %></div>
  </section>
<% } %>

<% if (tool.galleryImages && tool.galleryImages.length) { %>
  <section class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 pb-12">
    <h2 class="text-xl font-bold text-ink mb-4">Hình ảnh</h2>
    <div class="grid sm:grid-cols-2 gap-4">
      <% tool.galleryImages.forEach(function(img) { %>
        <div class="aspect-video rounded-2xl overflow-hidden bg-primary-50 shadow-card">
          <img src="<%= img %>" alt="<%= tool.title %>" class="w-full h-full object-cover" loading="lazy" />
        </div>
      <% }); %>
    </div>
  </section>
<% } %>

<% if (relatedTools.length) { %>
  <section class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 pb-16">
    <h2 class="text-xl font-bold text-ink mb-6">Tool &amp; game khác</h2>
    <div class="grid sm:grid-cols-3 gap-6">
      <% relatedTools.forEach(function(t) { %>
        <a href="/kho-tai-nguyen/<%= t.slug %>" class="card overflow-hidden group">
          <div class="aspect-square bg-primary-50 overflow-hidden">
            <img src="<%= t.coverImageUrl %>" alt="<%= t.title %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" />
          </div>
          <div class="p-4">
            <h3 class="font-semibold text-sm text-ink line-clamp-1 group-hover:text-primary-700"><%= t.title %></h3>
          </div>
        </a>
      <% }); %>
    </div>
  </section>
<% } %>
