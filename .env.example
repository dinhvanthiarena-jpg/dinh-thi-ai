# Server
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
APP_NAME="Dinh Thi Ai"

# Database (MySQL - most cPanel shared hosting includes this for free)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cpaneluser_dinhthiai
DB_USER=cpaneluser_dtauser
DB_PASSWORD=change_this_password

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
SESSION_SECRET=change_this_to_another_long_random_string

# Admin seed account (used by scripts/seed.js)
ADMIN_EMAIL=admin@dinhthiai.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME="Dinh Thi Ai"

# Payment provider (mock by default; swap to real keys when ready)
PAYMENT_PROVIDER=mock
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/checkout/vnpay-return

# Email (for contact form notifications / future use)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_TO_EMAIL=contact@dinhthiai.com

# AI Chatbot (web widget + Facebook Messenger)
# Anthropic API key, from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Optional: override the Claude model used by the chatbot
# Default is Haiku 4.5 — cheapest Claude model, well suited to a customer-service bot
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Facebook Messenger webhook (Meta for Developers > your App > Messenger > Settings)
# Page Access Token generated for the connected Facebook Page
FB_PAGE_ACCESS_TOKEN=
# Any string you choose yourself; enter the same value in the Meta webhook setup form
FB_VERIFY_TOKEN=
# App Secret from the Meta App's Settings > Basic (used to verify webhook signatures)
FB_APP_SECRET=
